msgstr "Benutzerpasswort über die Befehlszeile mit UDM ändern"

#: ../../iam/password-management/policies.rst:125
msgid ""
"$ export USER_DN=\"<the obtained user DN>\"\n"
"$ udm users/user modify \\\n"
"  --dn \"$USER_DN\" \\\n"
"  --set password=\"$(cat password.txt)\""
msgstr ""
"$ export USER_DN=\"<the obtained user DN>\"\n"
"$ udm users/user modify \\\n"
"  --dn \"$USER_DN\" \\\n"
"  --set password=\"$(cat password.txt)\""

