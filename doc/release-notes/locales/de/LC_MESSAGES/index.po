msgstr "Firefox ab Version 128"

#: ../../index.rst:200
msgid "Safari and Safari Mobile as of version 18"
msgstr "Safari und Safari Mobile ab Version 18"

#: ../../index.rst:202
msgid "Microsoft Edge as of version 128"
msgstr "Microsoft Edge ab Version 128"

#: ../../index.rst:204
msgid "Users running older browsers may experience display or performance issues."
msgstr ""
"Mit älteren Browsern können Darstellungs- oder Performanceprobleme "
"auftreten."

