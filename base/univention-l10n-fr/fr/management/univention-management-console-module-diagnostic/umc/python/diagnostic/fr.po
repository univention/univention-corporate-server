msgid ""
"\"univention-check-join-status\" returned a problem with the domain join."
msgstr ""
"« univention-check-join-status » a renvoyé un problème avec la jonction au "
"domaine."

#, python-format
msgid "%d objects should be \"%s\""
msgstr "%d objets devraient être « %s »"

#, python-format
msgid "%d of the configured nameservers are not responding to DNS queries."
msgstr "%d des serveurs de noms configurés ne répondent pas aux requêtes DNS."

#, python-format
msgid "- Disk for mountpoint %(mp)s is %(pc)s%% full."
msgstr "- Le disque pour le point de montage %(mp)s est à %(pc)s%% plein."

msgid "A timeout occurred while reaching the nameserver (is it online?)."
msgstr "Délai dépassé lors de l'accès au serveur de noms (est-il connecté ?)."

msgid "ACL right for group {id!r} is {udm!r} in UDM, but {imap!r} in IMAP."
msgstr ""
"Le droit ACL pour le groupe {id!r} est {udm!r} dans UDM, mais {imap!r} dans "
"IMAP."

msgid "ACL right for user {id!r} is {udm!r} in UDM, but {imap!r} in IMAP."
msgstr ""
"Le droit ACL pour le compte {id!r} est {udm!r} dans UDM, mais {imap!r} dans "
"IMAP."

msgid "Activate the memberOf LDAP overlay"
msgstr "Activer l’overlay memberOf de LDAP"

msgid "Add lo to samba/interfaces"
msgstr "Ajouter lo à samba/interfaces"

msgid "Adjust to suggested limits"
msgstr "Ajuster aux limites suggérées"

msgid "All SIDs exist and names are consistent."
msgstr "Tous les SID existent et les noms sont cohérents."

msgid "All SSL certificates valid."
msgstr "Tous les certificats SSL sont valides."

msgid "All files ok."
msgstr "Tous les fichiers sont corrects."

msgid "All shared folder ACLs are in sync with UDM."
msgstr ""
"Toutes les listes de contrôle d’accès (ACL) de dossiers partagés sont "
"synchronisées avec UDM."

msgid ""
"Authentication against the Primary LDAP failed with the machine password."
msgstr ""
"L’authentification sur le serveur LDAP principal avec le mot de passe de la "
"machine a échoué."

msgid "Authentication against the local LDAP failed with the machine password."
msgstr ""
"L’authentification sur le serveur LDAP local avec le mot de passe de la "
"machine a échoué."

msgid "Authentication with machine password against LDAP successful."
msgstr ""
"L’authentification sur le serveur LDAP avec le mot de passe de la machine a "
"réussi."

msgid "Calling /usr/lib/univention-server/server_password_change failed."
msgstr "L’appel de /usr/lib/univention-server/server_password_change a échoué."

msgid "Certificate {path!r} will expire in {days} days."
msgstr "Le certificat {path!r} expirera dans {days} jours."

msgid "Check Heimdal KDC on Samba 4 DC"
msgstr "Vérification de Heimdal KDC sur Samba 4 DC"

msgid "Check IMAP shared folder ACLs"
msgstr ""
"Vérification des listes de contrôle d’accès (ACL) des dossiers partagés IMAP"

msgid "Check LDAP attribute memberOf"
msgstr "Vérification de l’attribut LDAP memberOf"

msgid "Check Samba replication status for errors"
msgstr "Recherche d’erreurs dans l’état de réplication Samba"

msgid "Check errors in sources.list files"
msgstr "Recherche d’erreurs dans les fichiers sources.list"

msgid "Check file permissions"
msgstr "Vérification des permissions de fichiers"

msgid "Check for modified UCR templates"
msgstr "Recherche de modèles UCR modifiés"

msgid "Check for problems with UDN replication"
msgstr "Recherche de problèmes dans la réplication UDN"

msgid "Check free disk space"
msgstr "Vérification de l’espace disque disponible"

msgid "Check hostname RFC compliance"
msgstr "Vérification de la conformité RFC du nom d’hôte"

msgid "Check join status"
msgstr "Vérification de l’état de jonction"

msgid "Check kerberos authenticated DNS updates"
msgstr "Vérification des mises à jour DNS authentifiées kerberos"

msgid "Check local AD database for errors"
msgstr "Recherche d’erreurs dans la base de données AD locale"

msgid "Check machine password"
msgstr "Vérification du mot de passe de la machine"

msgid "Check nameserver entries on DNS zones"
msgstr "Vérification des entrées du serveur de noms dans les zones DNS"

msgid "Check primary LDAP server"
msgstr "Vérification du serveur LDAP principal"

msgid "Check resolving repository servers"
msgstr "Vérification de la résolution des serveurs de dépôts"

msgid "Check validity of SSL certificates"
msgstr "Vérification de la validité des certificats SSL"

msgid "Check well known SIDs"
msgstr "Vérification des SID connus"

msgid "Check whether the LDAP overlay memberOf is locally activated."
msgstr "Vérification de l’activation locale de l’overlay memberOf de LDAP."

msgid "Deactivate test"
msgstr "Désactiver le test"

msgid "Enough free disk space available."
msgstr "Suffisamment d’espace disque disponible."

msgid "Error retrieving notifier ID from the UDN."
msgstr ""
"Erreur lors de la récupération de l’ID de notificateur à partir de l’UDN."

msgid "Errors found by `univention-check-templates`."
msgstr "Erreurs détectées par `univention-check-templates`."

msgid "Errors occurred while running `kinit` or `nsupdate`."
msgstr ""
"Des erreurs se sont produites lors de l’exécution de `kinit` ou `nsupdate`."

msgid "File {path!r} does not exist."
msgstr "Le fichier {path!r} n’existe pas."

msgid "File {path!r} has mode {actual:o}, {expected:o} was expected."
msgstr "Le fichier {path!r} a le mode {actual:o}, {expected:o} était attendu."

msgid "File {path!r} has owner {actual!r} while {expected!r} was expected."
msgstr ""
"Le fichier {path!r} a pour propriétaire {actual:o} alors que {expected:o} "
"était attendu."

msgid "Fix machine password"
msgstr "Corriger le mot de passe de la machine"

msgid ""
"Found differences in the ACLs for IMAP shared folders between UDM and IMAP."
msgstr ""
"Différences trouvées dans les ACL pour les dossiers partagés IMAP entre UDM "
"et IMAP."

msgid "Found errors in the nameserver entries of the following zones."
msgstr ""
"Erreurs détectées dans les entrées du serveur de noms pour les zones "
"suivantes."

msgid "Found exception in {path!r}: {exception}"
msgstr "Exception trouvée dans {path!r} : {exception}"

msgid "Found expired certificate {path!r}."
msgstr "Certificat {path!r} expiré."

#, python-brace-format
msgid "Found illegal alias record (CNAME record) for nameserver {ns}."
msgstr "Enregistrement d’alias (CNAME) illicite pour le serveur de noms {ns}."

msgid "Found invalid certificate {path!r}."
msgstr "Certificat {path!r} non valide."

msgid ""
"Found invalid certificate {path!r}:\n"
"{message}"
msgstr ""
"Certificat {path!r} non valide :\n"
"{message}"

msgid "Found malformed certificate {path!r}."
msgstr "Certificat {path!r} malformé."

#, python-brace-format
msgid "Found no host record (A/AAAA record) for nameserver {ns}."
msgstr ""
"Aucun enregistrement d’hôte (A/AAAA) n’a été trouvé pour le serveur de noms "
"{ns}."

msgid "Found not yet valid certificate {path!r}."
msgstr "Certificat {path!r} pas encore valide."

#, python-brace-format
msgid ""
"Found {ucs} UCS rejects and {s4} S4 rejects. See {{sdb}} for more information."
msgstr ""
"Détection de {ucs} rejets d’UCS et {s4} rejets de S4. Voir {{sdb}} pour plus "
"d’informations."

msgid "Gateway is not reachable"
msgstr "La passerelle n'est pas accessible"

msgid "Host key for server does not match"
msgstr "La clé d'hôte pour ce serveur ne correspond pas"

msgid ""
"If the problem persists make sure the nameserver is connected to the network "
"and the forwarders are able to reach the internet (www.univention.de)."
msgstr ""
"Si le problème persiste, veuillez vous assurer que le serveur de noms est "
"connecté au réseau et que les transmetteurs (forwarders) peuvent accéder à "
"Internet (www.univention.de)."

msgid "If these settings are correct the problem relies in the gateway itself:"
msgstr ""
"Si ces réglages sont corrects, le problème provient de la passerelle elle-"
"même :"

#, python-brace-format
msgid "In forward zone {name} (see {{{link}}}):"
msgstr "Dans la zone DNS directe {name} (voir {{{link}}}) :"

#, python-brace-format
msgid "In mail folder {name} (see {{udm:mail/mail}}):"
msgstr "Dans le dossier de courrier {name} (voir {{udm:mail/mail}}) :"

#, python-brace-format
msgid "In reverse zone {name} (see {{{link}}}):"
msgstr "Dans la zone DNS inverse {name} (voir {{{link}}}) :"

msgid "Inbound {nc!r}: error during DRS replication from {source} ({estring})"
msgstr ""
"{nc!r} entrant : erreur lors de la réplication DRS depuis {source} ({estring})"

#, python-brace-format
msgid ""
"It is suggested to increase the security limits either manually by using "
"{ucr} or to automatically adjust them to the suggested limits:"
msgstr ""
"Il est conseillé d'augmenter les limites de sécurité manuellement en "
"utilisant {ucr} ou de les ajuster automatiquement aux limites proposées :"

msgid "KDC service check"
msgstr "Vérification du service KDC"

msgid "LDAP objects"
msgstr "Objets LDAP"

msgid "LDAP schema files are not properly registered"
msgstr "Les fichiers de schéma LDAP ne sont pas correctement enregistrés"

#, python-format
msgid ""
"Login to the remote server with the uid %(uid)s and the password from /etc/"
"machine.secret failed. "
msgstr ""
"Échec de la connexion au serveur distant avec l'UID %(uid)s et le mot de "
"passe issu de « /etc/machine.secret ». "

msgid "Machine authentication failed"
msgstr "Échec de l'authentification à la machine"

msgid "Mail folder {folder!r} does not exist in IMAP."
msgstr "Le dossier de messagerie {folder!r} n’existe pas dans IMAP."

msgid "Make sure the hardware of the gateway device is working properly."
msgstr ""
"Veuillez vous assurer que l'équipement de passerelle fonctionne "
"convenablement."

msgid "Manual: Analysis of listener/notifier problems"
msgstr "Manuel : Analyse des problèmes d’écouteurs/notificateurs"

#, python-format
msgid "Migrate %d LDAP objects"
msgstr "Migrer %d objets LDAP"

msgid "Migrate LDAP objects"
msgstr "Migrer les objets LDAP"

msgid "Migrate user objects"
msgstr "Migrer les objets utilisatrices ou utilisateurs"

msgid ""
"More information about the cause can be gained by executing \"dpkg --audit\"."
msgstr ""
"Des informations complémentaires sur l'origine du problème peuvent être "
"obtenues en exécutant « dpkg --audit »."

msgid "Multiple ACL entries for {id!r} in UDM."
msgstr "Plusieurs entrées d’ACL pour {id!r} dans UDM."

msgid "Nameserver(s) are not responsive"
msgstr "Le ou les serveurs de noms ne sont pas réactifs"

msgid "No S4 Connector rejects were found."
msgstr "Aucun rejet de connecteur S4 n’a été trouvé."

msgid "No errors found."
msgstr "Aucune erreur détectée."

msgid "No errors occurred."
msgstr "Aucune erreur ne s’est produite."

msgid "No non-compliant hostnames found."
msgstr "Aucun nom d’hôte non conforme n’a été trouvé."

msgid "No problems found with UDN replication."
msgstr "Aucun problème détecté dans la réplication UDN."

msgid "No problems found with modified UCR templates"
msgstr "Aucun problème détecté dans les modèles UCR modifiés"

msgid "No problems were found while resolving update repositories."
msgstr ""
"Aucun problème n’a été détecté lors de la résolution des dépôts de mise à "
"jour."

msgid "No reachable KDCs were found."
msgstr "Aucun KDC accessible n’a été trouvé."

msgid "No user or group with SID {sid} found, expected {expected!r}."
msgstr ""
"Aucun compte ou groupe avec le SID {sid} n’a été trouvé, {expected!r} attendu."

msgid ""
"Note that password rotation is disabled via the UCR variable server/password/"
"change."
msgstr ""
"Notez que la rotation du mot de passe est désactivée via la variable UCR "
"server/password/change."

msgid "Note that server/password/interval is set to {}."
msgstr "Notez que server/password/interval est réglé sur {}."

#, python-format
msgid "Number of objects that should be marked as \"%s\": %d"
msgstr "Nombre d’objets qui devraient être marqués comme « %s » : %d"

#, python-format
msgid ""
"Number of unspecific Windows computer objects with inconsistent "
"univentionObjectType: %d (Can't fix this automatically)"
msgstr ""
"Nombre d’objets ordinateurs Windows non spécifiques ayant une valeur "
"univentionObjectType incohérente : %d (ceci ne peut être corrigé "
"automatiquement)"

msgid ""
"Objects that implicitly satisfy the criteria of a Univention Object but lack "
"this attribute should be migrated."
msgstr ""
"Les objets qui répondent implicitement aux critères d’un Objet Univention "
"mais qui ne disposent pas de cet attribut doivent être migrés."

msgid ""
"Objects that implicitly satisfy the standards of a Univention Object but lack "
"this attribute should be migrated."
msgstr ""
"Les objets qui satisfont implicitement aux normes d’un Objet Univention mais "
"qui ne disposent pas de cet attribut doivent être migrés."

msgid ""
"Old packages and Apps registered schema files by copying the files locally "
"into a certain directory."
msgstr ""
"Les Apps et paquetages anciens enregistraient des fichiers de schéma en "
"copiant les fichiers localement dans un répertoire particulier."

msgid "Outbound {nc!r}: error during DRS replication to {source} ({estring})"
msgstr ""
"{nc!r} sortant : erreur lors de la réplication DRS vers {source} ({estring})"

#, python-brace-format
msgid "Output of `{cmd}`:"
msgstr "Résultat de `{cmd}` :"

msgid "Package status corrupt"
msgstr "Corruption de l'état du paquetage"

msgid ""
"Please check /var/log/auth.log on the remote server for further information."
msgstr ""
"Veuillez vérifier « /var/log/auth.log » sur le serveur distant pour plus "
"d'informations."

msgid "Please check the files for more details."
msgstr "Veuillez consulter les fichiers pour plus de détails."

msgid ""
"Please make sure the DNS settings in the {setup:network} are correctly set up."
msgstr ""
"Veuillez vous assurer que les réglages DNS dans {setup:network} sont "
"correctement définis."

#, python-brace-format
msgid "Please refer to {rfc1123} for the syntax of host names."
msgstr "Veuillez vous référer à {rfc1123} pour la syntaxe des noms d’hôte."

#, python-brace-format
msgid "Please refer to {sdb} for further information."
msgstr "Veuillez vous référer à {sdb} pour plus d’informations."

#, python-format
msgid ""
"Please repair the host key of the remote server in /root/.ssh/known_hosts on "
"%(fqdn)s."
msgstr ""
"Veuillez réparer la clé d'hôte du serveur distant dans « /root/.ssh/"
"known_hosts » pour %(fqdn)s."

#, python-brace-format
msgid "Please see {sdb} for more information."
msgstr "Veuillez consulter {sdb} pour plus d’informations."

#, python-brace-format
msgid "Please see {sdb} for troubleshooting DNS problems."
msgstr "Veuillez consulter {sdb} pour résoudre les problèmes de DNS."

#, python-brace-format
msgid "Please see {sdb} on how to renew certificates."
msgstr "Veuillez consulter {sdb} sur la façon de renouveler les certificats."

msgid "Proxy server failure"
msgstr "Échec du serveur mandataire"

msgid "RFC 1123 - 2.1 Host Names and Numbers"
msgstr "RFC 1123 - 2.1 Noms et numéros d’hôte"

msgid "Regenerate sources.list"
msgstr "Régénérer sources.list"

msgid "Register Schema files"
msgstr "Enregistrer les fichiers de schéma"

msgid "Reset kerberos/kdc to 127.0.0.1"
msgstr "Réinitialiser kerberos/kdc à 127.0.0.1"

msgid "Run `samba-tool dbcheck --fix --cross-ncs --yes`"
msgstr "Exécuter `samba-tool dbcheck --fix --cross-ncs --yes`"

msgid "S4 Connector rejects"
msgstr "Rejets  de connecteur S4"

#, python-brace-format
msgid "S4 DN: {s4}, UCS DN: {ucs}"
msgstr "S4 DN : {s4}, UCS DN : {ucs}"

msgid "S4 rejected:"
msgstr "S4 rejeté :"

msgid "SAML certificate verification failed!"
msgstr "La vérification du certificat SAML a échoué !"

msgid "SSH connection to UCS server failed!"
msgstr "Échec de la connexion SSH au serveur UCS !"

msgid "Samba 4 KDC running."
msgstr "KDC de Samba 4 en cours d’exécution."

msgid "Samba4 max open files - Univention Help"
msgstr "Nombre maximal de fichiers ouverts dans Samba 4 – Aide Univention"

msgid "Security limits exceeded"
msgstr "Limites de sécurité atteintes"

#, python-brace-format
msgid "See {erroranalysis} or run the join-scripts via {join}."
msgstr ""
"Consultez {erroranalysis} ou exécutez les scripts de jonction via {join}."

#, python-brace-format
msgid "See {sdb} for information on manual server password change."
msgstr ""
"Voir {sdb} pour plus d’informations sur la modification manuelle du mot de "
"passe du serveur."

msgid "Server Role Windows"
msgstr "Rôle serveur Windows"

msgid "Set server/password/change=True"
msgstr "Définir server/password/change=True"

msgid "Set server/password/interval=21"
msgstr "Définir server/password/interval=21"

msgid ""
"Several services rely on the attribute \"univentionObjectType\" to search and "
"identify objects in LDAP."
msgstr ""
"Plusieurs services s’appuient sur l’attribut « univentionObjectType » pour "
"chercher et identifier des objets dans LDAP."

msgid ""
"Several services rely on the attribute \"univentionServerRole\" to search and "
"identify objects in OpenLDAP."
msgstr ""
"Plusieurs services s’appuient sur l’attribut « univentionServerRole » pour "
"chercher et identifier des objets dans OpenLDAP."

msgid "Some disks are nearly full:"
msgstr "Certains disques sont presque pleins :"

msgid "Test again"
msgstr "Tester à nouveau"

msgid ""
"The \"memberOf\" group membership attribute is not available in the LDAP "
"server on this host. This feature is activated by default in new "
"installations since UCS version 4.3-0, and serveral services depend on it. "
"This feature will be a prerequisite in future UCS releases. You may want to "
"consider activating the memberOf feature for the LDAP server according to:"
msgstr ""
"L’attribut d’appartenance au groupe « memberOf » n’est pas disponible sur le "
"serveur LDAP sur cet hôte. Cette fonctionnalité est activée par défaut dans "
"les nouvelles installations depuis la version UCS 4.3-0, et plusieurs "
"services en dépendent. Cette fonctionnalité sera une condition prérequise "
"dans les futures versions d’UCS. Si vous envisagez d’activer la "
"fonctionnalité memberOf pour le serveur LDAP, vous pouvez consulter le lien :"

msgid ""
"The UCR variable {variable!r} is unset, but necessary for the S4 Connector."
msgstr ""
"La variable UCR {variable!r} n’est pas définie, mais nécessaire pour le "
"connecteur S4."

msgid "The certificate of the SAML identity provider does not match."
msgstr "Le certificat du fournisseur d’identité SAML ne correspond pas."

msgid "The certificate of the SAML service provider does not match."
msgstr "Le certificat du fournisseur de service SAML ne correspond pas."

msgid "The check for the join status was succsesful."
msgstr "La vérification de l’état de jonction a réussi."

msgid "The error might be fixable by regenerating the sources.list."
msgstr ""
"L’erreur peut éventuellement être corrigée en régénérant le fichier "
"sources.list."

msgid "The files should be checked for differences."
msgstr "Les fichiers devraient être comparés."

msgid "The following FQDNs were not resolvable:"
msgstr ""
"Les noms de domaine complets (FQDN) suivants n’ont pas pu être résolus :"

msgid "The following KDCs were unreachable: {}"
msgstr "Les KDC suivants sont inaccessibles : {}"

msgid "The following UCR files are modified locally."
msgstr "Les fichiers UCR suivants sont modifiés localement."

msgid "The following files seem to be registered in the old way:"
msgstr "Les fichiers suivants semblent être enregistrés à l’ancienne :"

msgid ""
"The following list shows the affected remote servers and the reason for the "
"failed ssh connection:"
msgstr ""
"La liste suivante affiche les serveurs distants affectés et la raison de "
"l'échec de la connexion SSH :"

#, python-brace-format
msgid "The following non-compliant hostnames have been found: {hostnames}."
msgstr "Les noms d’hôte non conformes suivants ont été trouvés : {hostnames}."

#, python-format
msgid ""
"The gateway %r could not be reached. Please make sure the gateway and related "
"network settings are correctly configured by using the {setup:network}."
msgstr ""
"Impossible d'atteindre la passerelle %r. Veuillez vous assurer que la "
"passerelle et les réglages réseaux associés soient configurés correctement en "
"utilisant {setup:network}."

msgid ""
"The hostname of the proxy could not be resolved. May check your DNS "
"configuration."
msgstr ""
"Impossible de résoudre le nom d'hôte du serveur mandataire. Veuillez vérifier "
"votre configuration DNS."

msgid "The limits have been adjusted to the suggested value."
msgstr "Les limites ont été adaptées à la valeur suggérée."

#, python-format
msgid "The migration failed: %s"
msgstr "Échec de la migration : %s"

#, python-format
msgid "The nameserver %(nameserver)s (UCR variable %(var)r) is not responsive:"
msgstr ""
"Le serveur de noms %(nameserver)s (variable UCR %(var)r) n'est pas réactif :"

#, python-format
msgid "The package status of %s packages is corrupt."
msgstr "Les états des paquetages %s sont corrompus."

msgid ""
"The preferred way now is to register them in LDAP; this is less error prone "
"in situations like backup2master."
msgstr ""
"Le moyen privilégié consiste désormais à les enregistrer dans LDAP ; ceci est "
"moins sujet aux erreurs dans des situations telles que backup2master."

#, python-format, python-brace-format
msgid ""
"The primary LDAP Server of this System (UCR ldap/server/name) is set to the "
"Primary Directory Node of this UCS domain (%s).\n"
"Since this environment provides further LDAP Servers, we recommend a "
"different configuration to reduce the load on the Primary Directory Node.\n"
"Please see {sdb} for further information."
msgstr ""
"Le serveur LDAP principal de ce système (UCR ldap/server/name) est défini "
"comme Primary Directory Node de ce domaine UCS (%s).\n"
"Étant donné que cet environnement fournit d’autres serveurs LDAP, nous "
"recommandons une configuration différente pour réduire la charge sur le "
"Primary Directory Node.\n"
"Veuillez consulter {sdb} pour plus d’informations."

#, python-format
msgid ""
"The proxy host could not be reached. Make sure that hostname (%(hostname)r) "
"and port (%(port)r) are correctly set up."
msgstr ""
"Impossible d'atteindre le serveur mandataire. Veuillez vous assurer que le "
"nom d'hôte (%(hostname)r) et le port (%(port)r) sont correctement définis."

#, python-format
msgid ""
"The proxy server is reachable but the HTTP response status code (%d) does not "
"indicate success."
msgstr ""
"Le serveur mandataire est accessible, mais le code d'état de la réponse HTTP "
"(%d) n'indique pas une réussite."

#, python-format
msgid "The registration failed: %s"
msgstr "Échec de l’enregistrement : %s"

msgid ""
"The security limits (e.g. for max_open_files) are currently not configured "
"properly."
msgstr ""
"Les limites de sécurité (par ex. pour « max_open_files ») ne sont pas pas "
"configurées correctement."

#, python-format
msgid ""
"The server did not respond within %d seconds. Please check your network "
"configuration."
msgstr ""
"Le serveur n'a pas répondu dans les %d secondes. Veuillez vérifier votre "
"configuration réseau."

msgid "The ssh connection to at least one other UCS server failed. "
msgstr "Échec de la connexion SSH à au moins un autre serveur UCS. "

msgid ""
"The ssh host key of the remote server has changed (maybe the host was "
"reinstalled). "
msgstr ""
"La clé d'hôte SSH du serveur distant a été modifiée (l'hôte a peut-être été "
"réinstallé). "

msgid "There is no gateway configured."
msgstr "Aucune passerelle n’est configurée."

msgid ""
"There was an error using the proxy server. The {setup:network} can be used to "
"change the proxy configuration.\n"
msgstr ""
"Erreur lors de l'utilisation du serveur mandataire. {setup:network} peut être "
"utilisé pour modifier la configuration du serveur mandataire.\n"

msgid "These objects were found:"
msgstr "Ces objets ont été trouvés :"

msgid ""
"This can cause several different serious problems (e.g. the login at samba "
"servers may be impossible, file operations (copy, move) on shares can fail, "
"etc.)"
msgstr ""
"Cela peut causer un certain nombre de problèmes importants (ex. : la "
"connexion aux serveurs Samba peut être impossible, les opérations sur les "
"fichiers (copie, déplacement) sur les partages peuvent échouer, etc.)"

msgid ""
"This is a Samba 4 DC, but `samba-tool processes` reports no `kdc_server`."
msgstr ""
"Il s’agit d’un DC Samba 4, mais `samba-tool processes` ne signale aucun "
"`kdc_server`."

msgid "This is not necessarily a problem, if the the ACL got changed via IMAP."
msgstr ""
"Ce n’est pas nécessairement un problème, si la liste de contrôle d’accès "
"(ACL) a été modifiée via IMAP."

msgid "This may be, because Heimdal KDC seems to be running."
msgstr "C’est peut-être dû au fait que Heimdal KDC semble fonctionner."

msgid "This may be, because `kerberos/autostart` is not disabled."
msgstr ""
"C’est peut-être dû au fait que `kerberos/autostart` n’est pas désactivé."

msgid "This may lead to DNS problems."
msgstr "Ceci peut entraîner des problèmes de DNS."

msgid "This might indicate an error or still processing transactions."
msgstr ""
"Ceci peut indiquer une erreur ou l’existence de transactions encore en cours "
"de traitement."

#, python-format
msgid ""
"This warning might be harmless. Nevertheless make sure the authentication "
"credentials (if any) are correct and the proxy server ACLs do not forbid "
"requests to %s."
msgstr ""
"Cet avertissement est peut-être sans danger. Veuillez cependant vous assurer "
"que les preuves d'identité (s'il y en a) sont correctes et que les ACL du "
"serveur mandataire n'interdisent pas les requêtes vers %s."

#, python-brace-format
msgid "UCS DN: {ucs}, S4 DN: {s4}, Filename: {fn}"
msgstr "UCS DN : {ucs}, S4 DN : {s4}, Nom de fichier : {fn}"

msgid "UCS rejected:"
msgstr "Objets UCS non synchronisés :"

msgid "Unable to fix machine password on {}"
msgstr "Impossible de corriger le mot de passe de la machine sur {}"

msgid "Univention Directory Notifier ID and the locally stored version differ."
msgstr ""
"L’ID du Univention Directory Notifier et la version stockée localement "
"diffèrent."

msgid "Univention S4 Connector is not installed."
msgstr "Le Connecteur S4 d’Univention n’est pas installé."

msgid "Univention Support Database - Bind: zone transfer failed"
msgstr ""
"Base de données d’assistance d’Univention – Bind : échec du transfert de zone"

msgid ""
"Univention Support Database - Change the primary LDAP Server to redistribute "
"the server load"
msgstr ""
"Base de données d’assistance d’Univention – Modifiez le serveur LDAP "
"principal pour redistribuer la charge du serveur"

msgid ""
"Univention Support Database - DNS Server on Directory Node does not resolve "
"external names"
msgstr ""
"Base de données d’assistance d’Univention – Le serveur DNS sur le Directory "
"Node ne résout pas les noms externes"

msgid "Univention Support Database - How to deal with s4-connector rejects"
msgstr ""
"Base de données d’assistance d’Univention – Comment gérer les rejets de "
"connecteur S4"

msgid "Univention Support Database - Manually trigger server password change"
msgstr ""
"Base de données d’assistance d’Univention – Lancer manuellement la "
"modification du mot de passe du serveur"

msgid "Univention Support Database - Renewing the TLS/SSL certificates"
msgstr ""
"Base de données d’assistance d’Univention – Renouveler les certificats TLS/SSL"

msgid "Univention Support Database - Troubleshooting: Listener-/Notifier"
msgstr ""
"Base de données d’assistance d’Univention – Dépannage : écouteur/notificateur"

msgid "Updated versions will be named FILENAME.dpkg-*."
msgstr "Les versions mises à jour seront nommées NOMDEFICHIER.dpkg-*."

msgid "User objects which are not migrated"
msgstr "Objets utilisateurs qui ne sont pas migrés"

msgid ""
"User or group with SID {sid} has name {actual!r}, but should be {expected!r}."
msgstr ""
"L’utilisateur, l’utilisatrice ou le groupe avec le SID {sid} a pour nom "
"{actual!r} alors que celui-ci devrait être {expected!r}."

msgid ""
"User or group with name {name!r} has sid {actual_sid}, but should be {sid}."
msgstr ""
"L’utilisateur, l’utilisatrice ou le groupe avec le nom {actual!r} a pour SID "
"{sid} alors que celui-ci devrait être {expected!r}."

msgid ""
"When a user object is created by a system which is not yet on UCS 4.3 it will "
"have the old format. These user objects need to migrated again."
msgstr ""
"Lorsqu’un objet utilisateur est créé par un système qui n’est pas encore sur "
"UCS 4.3, il a l’ancien format. Ces objets utilisateur doivent être migrés à "
"nouveau."

msgid ""
"With UCS 4.3 the LDAP format of user objects changed. After upgrading the "
"Primary Directory Node all user objects are migrated into the new format."
msgstr ""
"Avec UCS 4.3, le format LDAP des objets utilisateur a changé. Après la mise à "
"niveau du Primary Directory Node, tous les objets utilisateur sont migrés "
"dans le nouveau format."

msgid "You can run `samba-tool dbcheck --fix` to fix the issue."
msgstr ""
"Vous pouvez exécuter `samba-tool dbcheck --fix` pour résoudre le problème."

msgid "You have configured some high log levels."
msgstr "Vous avez configuré des niveaux de journaux élevés."

msgid ""
"You may log in to the system as root via ssh and run the command \"dpkg --"
"configure -a\" as an attempt to correct the packages status."
msgstr ""
"Connectez-vous au système via SSH en tant que root et exécutez la commande "
"« dpkg --configure -a » pour tenter de corriger l’état des paquetages."

msgid "You may want to move /var/log to another disk or storage."
msgstr ""
"Vous souhaiterez peut-être déplacer /var/log vers un autre disque ou lieu de "
"stockage."

msgid "You may want to move the local repository to another server."
msgstr ""
"Vous souhaiterez peut-être déplacer le dépôt local vers un autre serveur."

#, python-brace-format
msgid "You may want to reset them via {ucr}."
msgstr "Vous voudrez peut-être les réinitialiser via {ucr}."

#, python-brace-format
msgid "You may want to stop Heimdal KDC and restart Samba via {services}"
msgstr "Vous pouvez arrêter Heimdal KDC et redémarrer Samba via {services}"

msgid "You may want to uninstall software via {appcenter:appcenter}."
msgstr "Vous pouvez désinstaller des logiciels via {appcenter:appcenter}."

#, python-brace-format
msgid "`kinit` for principal {princ} with keytab {tab} failed."
msgstr ""
"La commande `kinit` pour le principal {princ} avec la table de mots de passe "
"{tab} a échoué."

#, python-brace-format
msgid "`kinit` for principal {princ} with password file {file} failed."
msgstr ""
"La commande `kinit` pour le principal {princ} avec le fichier de mot de passe "
"{file} a échoué."

#, python-brace-format
msgid "`nsupdate` check for domain {domain} failed ({details})."
msgstr ""
"La vérification `nsupdate` pour le domaine {domain} a échoué ({details})."

msgid "`samba-tool dbcheck` found an error in the local AD database."
msgstr ""
"La commande `samba-tool dbcheck` a trouvé une erreur dans la base de données "
"AD locale."

msgid "`samba-tool dbcheck` found no errors in the local AD database."
msgstr ""
"La commande `samba-tool dbcheck` n’a trouvé aucune erreur dans la base de "
"données AD locale."

msgid "`samba-tool drs showrepl` returned a problem with the replication."
msgstr ""
"La commande `samba-tool drs showrepl` a renvoyé un problème avec la "
"réplication."

