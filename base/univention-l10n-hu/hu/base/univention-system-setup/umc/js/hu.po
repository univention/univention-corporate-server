#: umc/js/setup/InterfaceWizard.js:71 umc/js/setup/InterfaceWizard.js:369
msgid ""
"<i>Bond</i> interfaces allows two or more physical network interfaces to be "
"coupled."
msgstr ""
"A <i>Bond</i> interfészek lehetővé teszik két vagy több fizikai hálózati "
"interfész összekapcsolását."

#: umc/js/setup/InterfaceWizard.js:70 umc/js/setup/InterfaceWizard.js:334
msgid ""
"<i>Bridge</i> interfaces allows a physical network interface to be shared "
"to connect one or more network segments."
msgstr ""
"A <i>Bridge</i> interfészek lehetővé teszik egy fizikai hálózati interfész "
"megosztását egy vagy több hálózati szegmens összekapcsolása érdekében."

#: umc/js/setup/InterfaceWizard.js:68
msgid "<i>Ethernet</i> is a standard physical interface."
msgstr "<i>Az Ethernet</i> egy szabványos fizikai interfész."

#: umc/js/setup/InterfaceWizard.js:69
msgid ""
"<i>VLAN</i> interfaces can be used to separate network traffic logically "
"while using only one or more physical network interfaces."
msgstr ""
"A <i>VLAN</i> interfészek segítségével logikailag el lehet különíteni a "
"hálózati forgalmat, miközben csak egy vagy több fizikai hálózati interfészt "
"használunk."

