#: usr/share/univention-system-setup-boot/www/main.js:26
msgid ""
"Before starting the setup wizard, an initial password for the <i>root</i> "
"user must be set."
msgstr ""
"A telepítő varázsló elindítása előtt létre kell hozni a <i>root</i> "
"felhasználó jelszavát."

#: usr/share/univention-system-setup-boot/www/main.js:28
msgid ""
"Connect to this server instance as <i>root</i> via ssh and your selected "
"private ssh key. "
msgstr ""
"Csatlakozz ehhez a szerverhez <i>root felhasználóval</i> ssh-n keresztül "
"a kiválasztott privát ssh kulccsal. "

#: usr/share/univention-system-setup-boot/www/main.js:35
msgid ""
"If a password for <i>root</i> has been set, <a href='/univention/setup/?"
"username=root'>start the setup wizard</a>."
msgstr ""
"Ha a <i>root</i> jelszó beállítva, <a href='/univention/setup/?"
"username=root'>indítsa el a telepítő varázslót</a>."

#: usr/share/univention-system-setup-boot/www/main.js:29
msgid ""
"Set a password with <i>passwd</i>, e.g., by issuing the following command:"
msgstr ""
"Állíts be jelszót a <i>passwd</i> paranccsal, például a következő parancs "
"kiadásával:"

#: usr/share/univention-system-setup-boot/www/main.js:20
msgid "Welcome to UCS initial configuration"
msgstr "Üdvözöljük az UCS első beállításaiban"

#: usr/share/univention-system-setup-boot/www/main.js:31
msgid "ssh -ti &lt;path/to/privatekey&gt; root@%(serveraddress)s passwd"
msgstr "ssh -ti &lt;path/to/privatekey&gt; root@%(szerver címe)s passwd"
