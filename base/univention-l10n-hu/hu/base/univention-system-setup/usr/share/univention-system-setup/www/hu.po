#: usr/share/univention-system-setup/www/ApplianceWizard.js:1930
#: usr/share/univention-system-setup/www/ApplianceWizard.js:1938
msgid ""
"Alternatively, you may click on the button <i>Finish</i> to exit the wizard "
"and resolve the described problems via Univention Management Console."
msgstr ""
"Alternatív megoldásként kattints a <i>Befejezés</i> gombra a varázsló "
"bezárásához, és oldd meg a leírt problémákat az Univention Management "
"Console segítségével."

#: usr/share/univention-system-setup/www/ApplianceWizard.js:2314
msgid "At least one network device needs to be properly configured."
msgstr "Legalább egy hálózati eszköznek megfelelően konfigurálva kell lennie."

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1145
msgid ""
"At least {memory_min} RAM is required for the installation of "
"{product_name}."
msgstr ""
"A8z) {product_name} telepítéséhez legalább {memory_min} RAM szükséges."

#: usr/share/univention-system-setup/www/ApplianceWizard.js:607
#: usr/share/univention-system-setup/www/ApplianceWizard.js:1757
msgid "Backup Directory Node"
msgstr "Biztonsági mentési könyvtár csomópont"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:2653
#: usr/share/univention-system-setup/www/ApplianceWizard.js:2821
#: usr/share/univention-system-setup/www/ApplianceWizard.js:2991
msgid "Cancel"
msgstr "Mégsem"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:821
msgid "Central server"
msgstr "Központi szerver"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:800
msgid ""
"Choose which role this server is supposed to take in your UCS@school domain."
msgstr ""
"Válaszd ki, hogy ez a szerver milyen szerepet tölt be az UCS@school domain-"
"ben."

#: usr/share/univention-system-setup/www/ApplianceWizard.js:345
msgid "Choose your language"
msgstr "Válaszd ki a nyelvet"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:373
msgid "Choose your system's localization settings."
msgstr "Válaszd ki a rendszer lokalizációs beállításait."

#: usr/share/univention-system-setup/www/main.js:193
msgid "Close"
msgstr "Bezár"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1316
msgid "Configure system"
msgstr "Rendszer beállítása"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:297
msgid ""
"Configure this system as first system for the new domain. Additional "
"systems can join the domain later."
msgstr ""
"Konfiguráld ezt a rendszert az új tartomány első rendszerének. További "
"rendszerek később csatlakozhatnak a tartományhoz."

#: usr/share/univention-system-setup/www/ApplianceWizard.js:839
msgid "Confirm configuration settings"
msgstr "A konfigurációs beállítások megerősítése"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1934
msgid ""
"Connect to Univention Management Console on this system either as user "
"<b>Administrator</b> or as user <b>root</b> in case the system has not yet "
"created a new UCS domain:"
msgstr ""
"Csatlakozz az Univention Management Console-hoz ezen a rendszeren vagy "
"<b>administrator</b>, vagy <b>root</b> felhasználóként, ha a rendszer még "
"nem hozott létre új UCS domain-t:"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1942
msgid ""
"Connect to Univention Management Console on this system either as user "
"<b>Administrator</b> or as user <b>root</b> in case the system has not yet "
"joined the domain:"
msgstr ""
"Csatlakozz az Univention Management Console-hoz ezen a rendszeren vagy "
"<b>administrator</b>, vagy <b>root</b> felhasználóként, ha a rendszer még "
"nem csatlakozott a tartományhoz:"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:2970
#: usr/share/univention-system-setup/www/ApplianceWizard.js:2994
msgid "Continue"
msgstr "Folytatás"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:2644
msgid "Continue with 169.254.*.* addresse(s)"
msgstr "Folytassa a 169.254.*.* címmel/címekkel"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1669
msgid "Continue with duplicate hostname"
msgstr "Folytasd a duplikált gazdagépnévvel"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:2810
msgid "Continue with incomplete settings"
msgstr "Folytasd a befejezetlen beállításokkal"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:2699
msgid "Continue without access to the repository servers"
msgstr "Folytasd a tárolószerverekhez való hozzáférés nélkül"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:2650
#: usr/share/univention-system-setup/www/ApplianceWizard.js:2672
msgid "Continue without internet access"
msgstr "Folytatás internet-hozzáférés nélkül"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1146
msgid "Continuing the installation might lead to a non-functional system."
msgstr "A telepítés folytatása a rendszer működésképtelenségéhez vezethet."

#: usr/share/univention-system-setup/www/ApplianceWizard.js:296
msgid "Create a new UCS domain"
msgstr "Új UCS-tartomány létrehozása"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1079
msgid "DHCP query failed."
msgstr "A DHCP-lekérdezés sikertelen volt."

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1836
msgid "DNS server"
msgstr "DNS-kiszolgáló"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:377
msgid "Default system locale"
msgstr "Alapértelmezett nyelvi beállítások"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1794
msgid "Domain and host configuration"
msgstr "Domain és host beállítás"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:424
msgid "Domain and network configuration"
msgstr "Domain és hálózati beállítás"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:684
msgid "Domain join information"
msgstr "Domain csatlakozási információk"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:747
msgid "Domain name"
msgstr "Domainnév"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:563
msgid "Domain setup"
msgstr "Domain beállítás"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:308
#, javascript-format
msgid "E-mail address to activate %s Appliance"
msgstr "E-mail cím a(z) %s Készülék aktiváláshoz"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:298
#: usr/share/univention-system-setup/www/ApplianceWizard.js:1690
#: usr/share/univention-system-setup/www/ApplianceWizard.js:1789
msgid "E-mail address to activate UCS"
msgstr "E-mail cím az UCS aktiváláshoz"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:358
msgid ""
"Enter a city nearby to preconfigure settings such as timezone, system "
"language, keyboard layout."
msgstr ""
"Adj meg egy közeli várost, hogy előre beállítsa az időzónát, a rendszer "
"nyelvét, a billentyűzetkiosztást és egyéb beállításokat."

#: usr/share/univention-system-setup/www/ApplianceWizard.js:664
#: usr/share/univention-system-setup/www/ApplianceWizard.js:685
msgid ""
"Enter name and password of a user account which is authorised to join a "
"system into this domain."
msgstr ""
"Írd be annak a felhasználói fióknak a nevét és jelszavát, amely jogosult "
"csatlakozni a rendszerhez ebben a tartományban."

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1931
msgid ""
