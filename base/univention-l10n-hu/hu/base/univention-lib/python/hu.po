#: python/package_manager.py:1007
msgid "Autoremove failed"
msgstr "Automatikus eltávolítás sikertelen"

#: python/package_manager.py:920
msgid "Could not initialize package manager."
msgstr "A csomagkezelő nem érhető el."

#: python/package_manager.py:1001
#, python-format
msgid "Deleting unneeded %s"
msgstr "Szükségtelen törlése %s"

#: python/package_manager.py:965
msgid "Error: "
msgstr "Hiba: "

#: python/package_manager.py:872
msgid "Failed to install"
msgstr "Sikertlen telepítés"

#: python/package_manager.py:434 python/package_manager.py:625
msgid "Failed to lock"
msgstr "Sikertelen zárolás"

#: python/package_manager.py:877
msgid "Failed to uninstall"
msgstr "Sikertlen eltávolítás"

#: python/package_manager.py:620 python/package_manager.py:858
msgid "Fetching failed"
msgstr "Lekérés sikertelen"

#: python/package_manager.py:989
msgid "Further information regarding this error:"
msgstr "További információ erről a hibáról:"

#: python/package_manager.py:659
msgid "No such package"
msgstr "Nincs ilyen csomag"

#. i18n: "using it" refers to the "package manager"
#: python/package_manager.py:979
msgid ""
"Probably another process is currently using it or the package sources are corrupt. Please try again "
"later."
msgstr "Valószínűleg egy másik folyamat már használja vagy sérült a csomag forrása. Próbáld meg később."

#: python/package_manager.py:976
msgid ""
"Some package conflicts could not be resolved. This was probably caused by packages with \"hold\" "
"state."
msgstr "Néhány csomagütközés nem oldható fel. Valószínűleg a csomag \"zárolt\" állapota miatt."

#: python/package_manager.py:982
msgid "The package sources are probably corrupt."
msgstr "Valószínűleg a csomagforrások sérültek."

#: python/package_manager.py:985
msgid ""
"The sources.list entries could be repaired by executing the following commands as root on this server:"
msgstr ""
"A bejegyzések a sources.list fájlban javíthatók a következőparanccsal rendszergazda módban a "
"szerveren:"

#: python/package_manager.py:974
msgid "There is no free hard disk space left on the device."
msgstr "Nem maradt szabad hely a háttértárolón."

#: python/package_manager.py:779
msgid "Untrusted origin"
msgstr "Nem megbízható forrás"

#: python/package_manager.py:964
msgid "Warning: "
msgstr "Figyelmeztetés "
