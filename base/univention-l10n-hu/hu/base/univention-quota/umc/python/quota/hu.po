#: umc/python/quota/tools.py:49
#, python-format
msgid "%s Days"
msgstr "%s nap"

#: umc/python/quota/tools.py:101 umc/python/quota/tools.py:136
#: umc/python/quota/user.py:116 umc/python/quota/partition.py:30
#: umc/python/quota/partition.py:55
#, python-format
msgid "Could not open %s"
msgstr "Nem lehet megnyitni %s"

#: umc/python/quota/user.py:108
#, python-format
msgid "Could not remove the following user: %s"
msgstr "A következő felhasználó nem távolítható el: %s"

#: umc/python/quota/tools.py:142
#, python-format
msgid "Device %r could not be found"
msgstr "A %r eszköz nem található."

#: umc/python/quota/tools.py:105
msgid "Device is not mounted"
msgstr "Az eszköz nincs csatlakoztatva"

#: umc/python/quota/tools.py:47
msgid "Expired"
msgstr "Lejárt"

#: umc/python/quota/tools.py:160
msgid "Failed to activate quota support: "
msgstr "Nem sikerült aktiválni a kvótatámogatást: "

#: umc/python/quota/tools.py:160
msgid "Failed to deactivate quota support: "
msgstr "Nem sikerült kikapcsolni a kvótatámogatást: "

#: umc/python/quota/user.py:85
#, python-format
msgid ""
"Failed to modify quota settings for user %(user)s on partition "
"%(partition)s."
msgstr ""
"Nem sikerült módosítani a felhasználói %(user)s kvótabeállításait a "
"%(partition)s. partíción."

#: umc/python/quota/tools.py:256
msgid "Generating the quota information file failed"
msgstr "A kvótainformációs fájl létrehozása sikertelen volt"

#: umc/python/quota/tools.py:200
msgid "Mounting the partition has failed"
msgstr "A partíció csatlakoztatása sikertelen volt"

#: umc/python/quota/partition.py:59
msgid "No partition found"
msgstr "Nem talált partíciót"

#: umc/python/quota/user.py:127
#, python-format
msgid "No partition found (%s)"
msgstr "Nem talált partíciót (%s)"

#: umc/python/quota/tools.py:191
msgid "Operation was successful"
msgstr "A művelet sikeres volt"

#: umc/python/quota/tools.py:171
msgid "Quota already en/disabled"
msgstr "A kvóta már en/letiltva"

#: umc/python/quota/tools.py:164
msgid "Quota support successfully activated"
msgstr "A kvótatámogatás sikeresen aktiválódott"

#: umc/python/quota/tools.py:164
msgid "Quota support successfully deactivated"
msgstr "A kvótatámogatás sikeresen deaktiválódott"

#: umc/python/quota/tools.py:243
msgid "Remounting the partition has failed"
msgstr "A partíció újracsatlakoztatása sikertelen volt"

#: umc/python/quota/tools.py:203 umc/python/quota/tools.py:247
#: umc/python/quota/tools.py:260 umc/python/quota/tools.py:264
msgid "Restarting the quota services has failed"
msgstr "A kvótaszolgáltatások újraindítása sikertelen volt"

#: umc/python/quota/user.py:125
#, python-format
msgid "The following partition is currently not mounted: %s"
msgstr "A következő partíció jelenleg nincs csatlakoztatva: %s"

#: umc/python/quota/user.py:123
#, python-format
msgid "The following partition is mounted without quota support: %s"
msgstr "A következő partíció kvóta támogatás nélkül van csatlakoztatva: %s"

#: umc/python/quota/partition.py:62
msgid "This partition is currently not mounted"
msgstr "Ez a partíció jelenleg nincs csatlakoztatva"

#: umc/python/quota/tools.py:234
#, python-format
msgid ""
"To %s quota support for the root filesystem the system has to be rebooted."
msgstr ""
"A gyökérfájlrendszer %s kvóta támogatásához a rendszert újra kell "
"indítani."

#: umc/python/quota/tools.py:187
msgid "Unknown filesystem"
msgstr "Ismeretlen fájlrendszer"

#: umc/python/quota/tools.py:197
msgid "Unmounting the partition has failed"
msgstr "A partíció leválasztása sikertelen volt"

#: umc/python/quota/tools.py:233
msgid "disable"
msgstr "letiltás"

#: umc/python/quota/tools.py:233
msgid "enable"
msgstr "engedélyez"
