#: umc/js/lib/server.js:81 umc/js/lib/server.js:139
msgid ""
"<b>Note:</b> After the restart you will be redirected to the login page."
msgstr ""
"<b>Megjegyzés:</b> Az újraindítás után a bejelentkezési oldalra fog "
"átirányítani."

#: umc/js/lib/server.js:84 umc/js/lib/server.js:142 umc/js/lib/server.js:205
msgid "Cancel"
msgstr "Mégsem"

#: umc/js/lib/server.js:138
msgid "Please confirm to reboot this server. This may take a few minutes."
msgstr ""
"Kérjük, erősítsd meg a szerver újraindítását. Ez eltarthat néhány percig."

#: umc/js/lib/server.js:80
msgid ""
"Please confirm to restart the UMC server and the HTTP web server. This will "
"take approximately 10 seconds."
msgstr ""
"Kérjük, erősítsd meg az UMC-kiszolgáló és a HTTP-webkiszolgáló "
"újraindítását. Ez körülbelül 10 másodpercet vesz igénybe."

#: umc/js/lib/server.js:202
msgid "Please confirm to shutdown this server. This may take a few minutes."
msgstr ""
"Kérjük, erősítsd meg a szerver leállítását. Ez eltarthat néhány percig."

#: umc/js/lib/server.js:113
msgid ""
"Please wait while UMC server components and HTTP web server are being "
"restarted."
msgstr ""
"Kérjük, várj, amíg az UMC szerver összetevői és a HTTP webszerver "
"újraindulnak."

#: umc/js/lib/server.js:146
msgid "Reboot"
msgstr "Újraindítás"

#: umc/js/lib/server.js:163
msgid "Rebooting server"
msgstr "Szerver újraindítása"

#: umc/js/lib/server.js:88
msgid "Restart"
msgstr "Újraindítás"

#: umc/js/lib/server.js:110
msgid "Restarting server"
msgstr "Szerver újraindítása"

#: umc/js/lib/server.js:209
msgid "Shutdown"
msgstr "Leállítás"

#: umc/js/lib/server.js:228
msgid "Shutting down server"
msgstr "Szerver leállítása"

#: umc/js/lib/server.js:166
msgid "The server is being rebooted."
msgstr "A szerver újraindítása folyamatban van."

#: umc/js/lib/server.js:231
msgid "The server is shutting down."
msgstr "A szerver leáll."
