msgstr "A gazdagép neve a domainhez viszonyítva."

#: modules/univention/admin/handlers/dns/ns_record.py:38
msgid "The name of the subzone relative to the parent."
msgstr "Az alzóna neve a szülőhöz képest."

#: modules/univention/admin/handlers/dns/alias.py:58
msgid "The name this alias points to. A FQDN must end with a dot."
msgstr "Az álnév által jelzett név. Az FQDN-nek ponttal kell végződnie."

#: modules/univention/admin/handlers/dns/reverse_zone.py:45
msgid "The networks address in forward notation."
msgstr "A hálózatok címei előre jelzéssel vannak ellátva."

