#: modules/univention/admin/handlers/dhcp/pool.py:28
msgid "A pool of dynamic addresses assignable to hosts."
msgstr "Dinamikus címek készlete, amely hozzárendelhető a gazdagépekhez."

#: modules/univention/admin/handlers/dhcp/shared.py:24
msgid "A shared physical network, where multiple IP address ranges are used."
msgstr "Megosztott fizikai hálózat, ahol több IP-címtartományt használnak."

#: modules/univention/admin/handlers/dhcp/host.py:37
msgid ""
"A unique name for this DHCP host entry. Using the hostname is recommended."
msgstr ""
"Egyedi név ehhez a DHCP-gazdagépbejegyzéshez. A gazdagépnév használata "
"ajánlott."

#: modules/univention/admin/handlers/dhcp/pool.py:40
msgid "A unique name for this DHCP pool object."
msgstr "Egy egyedi név ehhez a DHCP-készlet objektumhoz."

#: modules/univention/admin/handlers/dhcp/service.py:38
msgid "A unique name for this DHCP service."
msgstr "Egy egyedi név ehhez a DHCP szolgáltatáshoz."

#: modules/univention/admin/handlers/dhcp/shared.py:36
msgid "A unique name for this shared network."
msgstr "Egy egyedi név ehhez a megosztott hálózathoz."

#: modules/univention/admin/handlers/dhcp/__common.py:31
msgid "Additional options for DHCP"
msgstr "További DHCP opciók"

#: modules/univention/admin/handlers/dhcp/__common.py:38
msgid "Additional statements for DHCP"
msgstr "További utasítások a DHCP-hez"

#: modules/univention/admin/handlers/dhcp/sharedsubnet.py:44
#: modules/univention/admin/handlers/dhcp/subnet.py:47
msgid "Address prefix length (or Netmask)"
msgstr "Cím előtag hossza (vagy hálózati maszk)"

#: modules/univention/admin/handlers/dhcp/pool.py:71
msgid ""
"Addresses from this pool are given to clients using the old BOOTP protocol, "
"which has no mechanism to free addresses again."
msgstr ""
"Az ebből a készletből származó címeket a régi BOOTP protokoll használatával "
"adják át a klienseknek, amelynek nincs mechanizmusa a címek újbóli "
"felszabadítására."

#: modules/univention/admin/handlers/dhcp/pool.py:61
msgid ""
"Addresses from this pool are given to clients which have a DHCP host entry "
"matching their MAC address, but with no IP address assigned."
msgstr ""
"Az ebből a készletből származó címeket azoknak az ügyfeleknek adják, "
"amelyeknek MAC-címükkel megegyező DHCP gazdagépbejegyzésük van, de nincs "
"hozzárendelt IP-címük."

#: modules/univention/admin/handlers/dhcp/pool.py:66
msgid ""
"Addresses from this pool are given to clients, which do not have a DHCP "
"host entry matching their MAC address."
msgstr ""
"Az ebből a készletből származó címeket azoknak az ügyfeleknek adják, "
"amelyeknek nincs a MAC-címükhöz illő DHCP gazdagépbejegyzésük."

#: modules/univention/admin/handlers/dhcp/pool.py:88
msgid "Advanced"
msgstr "Haladó"

#: modules/univention/admin/handlers/dhcp/pool.py:88
msgid "Advanced DHCP pool options"
msgstr "Speciális DHCP készletbeállítások"

#: modules/univention/admin/handlers/dhcp/dhcp.py:23
msgid "All DHCP services"
msgstr "Minden DHCP szolgáltatás"

#: modules/univention/admin/handlers/dhcp/pool.py:75
msgid "All clients"
msgstr "Minden ügyfél"

#: modules/univention/admin/handlers/dhcp/__common.py:47
msgid "Allow adding custom DHCP options. Experts only!"
msgstr ""
"Egyéni DHCP beállítások hozzáadásának engedélyezése. Csak szakértőknek!"

#: modules/univention/admin/handlers/dhcp/__common.py:46
msgid "Allow custom DHCP options"
msgstr "Egyéni DHCP beállítások engedélyezése"

#: modules/univention/admin/handlers/dhcp/pool.py:70
msgid "Allow dynamic BOOTP clients"
msgstr "Dinamikus BOOTP kliensek engedélyezése"

#: modules/univention/admin/handlers/dhcp/pool.py:60
msgid "Allow known clients"
msgstr "Ismert ügyfelek engedélyezése"

#: modules/univention/admin/handlers/dhcp/pool.py:65
msgid "Allow unknown clients"
msgstr "Ismeretlen ügyfelek engedélyezése"

#: modules/univention/admin/handlers/dhcp/sharedsubnet.py:24
msgid "An IP address range used in a shared network."
msgstr "Megosztott hálózatban használt IP címtartomány."

#: modules/univention/admin/handlers/dhcp/host.py:52
msgid ""
"Assign one or more fixed IP addresses. Each address should be either an IP "
"address or a domain name that resolves to one or more IP addresses."
msgstr ""
"Egy vagy több fix IP-cím hozzárendelése. Minden címnek IP-címnek, vagy egy "
"olyan domainnévnek kell lennie, amely egy vagy több IP-címre van feloldva."

#: modules/univention/admin/handlers/dhcp/server.py:30
msgid "Associate a service with a server."
msgstr "Társítson egy szolgáltatást egy szerverhez."

