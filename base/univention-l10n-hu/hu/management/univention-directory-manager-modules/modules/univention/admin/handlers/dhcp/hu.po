#: modules/univention/admin/handlers/dhcp/subnet.py:27
msgid ""
"The IP address range used in a dedicated (non-shared) physical network."
msgstr ""
"A dedikált (nem megosztott) fizikai hálózatban használt IP címtartomány."

#: modules/univention/admin/handlers/dhcp/sharedsubnet.py:51
#: modules/univention/admin/handlers/dhcp/subnet.py:54
msgid "The IP addresses used to send data to all hosts inside the network."
msgstr ""
"Azok az IP-címek, amelyekre az adatokat a hálózaton belüli összes "
"gazdagépnek küldik."

#: modules/univention/admin/handlers/dhcp/pool.py:56
msgid "The name of the \"failover peer\" configuration to use."
msgstr "A használni kívánt „feladatátvételi partner” konfiguráció neve."

#: modules/univention/admin/handlers/dhcp/server.py:44
msgid "The name of the server, which should handle this DHCP service."
msgstr "A szerver neve, amelynek ezt a DHCP szolgáltatást kell kezelnie."

#: modules/univention/admin/handlers/dhcp/sharedsubnet.py:36
#: modules/univention/admin/handlers/dhcp/subnet.py:39
msgid "The network address."
msgstr "A hálózati cím."

#: modules/univention/admin/handlers/dhcp/sharedsubnet.py:45
#: modules/univention/admin/handlers/dhcp/subnet.py:48
msgid ""
"The number of leading bits of the IP address used to identify the network."
msgstr ""
"Az IP-cím kezdő bitjeinek száma, amelyek a hálózat azonosítására szolgálnak."

#: modules/univention/admin/handlers/dhcp/__common.py:178
