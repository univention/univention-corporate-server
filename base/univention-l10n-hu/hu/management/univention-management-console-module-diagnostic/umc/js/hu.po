#: umc/js/diagnostic.js:100
msgid "\"%(module)s - %(flavor)s\" Module (as Administrator)"
msgstr "„%(module)s - %(flavor)s” modul (rendszergazdaként)"

#: umc/js/diagnostic.js:201
msgid "Analyzing for problems..."
msgstr "Elemzés (problémakeresés)..."

#: umc/js/diagnostic.js:38
msgid "Conflict: "
msgstr "Konfliktus: "

#: umc/js/diagnostic.js:37
msgid "Critical: "
msgstr "Kritikus: "

#: umc/js/diagnostic.js:275
#, javascript-format
msgid "Diagnosis of \"%s\" was successful"
msgstr "A(z) „%s” diagnózisa sikeres volt"

#: umc/js/diagnostic.js:178
msgid ""
"If the system is able to automatically repair found problems it offers the "
"function as additional buttons. "
msgstr ""
"Ha a rendszer képes automatikusan kijavítani a talált problémákat, akkor "
"további gombokként kínálja fel a funkciót. "

#: umc/js/diagnostic.js:200 umc/js/diagnostic.js:310
msgid "No problems could be detected."
msgstr "Nem volt észlelhető probléma."

#: umc/js/diagnostic.js:179
msgid ""
"Otherwise the problems can be solved manually with help of the displayed "
"links to articles by using the linked UMC modules. "
msgstr ""
"Egyébként a problémák manuálisan is megoldhatók a megjelenített "
"cikkhivatkozások segítségével a kapcsolódó UMC modulok használatával. "

#: umc/js/diagnostic.js:40
msgid "Problem repaired: "
msgstr "Probléma kijavítva: "

#: umc/js/diagnostic.js:42
msgid "Problem: "
msgstr "Probléma: "

#: umc/js/diagnostic.js:182
msgid "Run system diagnosis"
msgstr "Rendszerdiagnózis futtatása"

#: umc/js/diagnostic.js:262
msgid "Running full diagnosis..."
msgstr "Teljes körű diagnosztika futtatása..."

#: umc/js/diagnostic.js:41
msgid "Success: "
msgstr "Siker: "

#: umc/js/diagnostic.js:39
msgid "Warning: "
msgstr "Figyelmeztetés: "

#: umc/js/diagnostic.js:177
msgid ""
"Within this module the system can be analyzed for various known problems. "
msgstr ""
"Ebben a modulban a rendszer különböző ismert problémák szempontjából "
"elemezhető. "
