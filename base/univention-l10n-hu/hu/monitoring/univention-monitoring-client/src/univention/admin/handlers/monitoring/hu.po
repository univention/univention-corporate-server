#: src/univention/admin/handlers/monitoring/alert.py:21
#: src/univention/admin/handlers/monitoring/alert.py:22
msgid "Alert"
msgstr "Figyelmeztetés"

#: src/univention/admin/handlers/monitoring/alert.py:49
msgid ""
"Alert description, shown in alert dashboard and alert e-mail notifications."
msgstr ""
"Riasztás leírása, amely a riasztási irányítópulton és a riasztási e-mail "
"értesítésekben jelenik meg."

#: src/univention/admin/handlers/monitoring/alert.py:76
msgid "Alert group"
msgstr "Riasztási csoport"

#: src/univention/admin/handlers/monitoring/alert.py:40
msgid "Alert name"
msgstr "Riasztás neve"

#: src/univention/admin/handlers/monitoring/alert.py:56
msgid ""
"Alert summary, shown in alert dashboard and alert e-mail notifications."
msgstr ""
"Riasztási összefoglaló, amely a riasztási irányítópulton és a riasztási e-"
"mail értesítésekben látható."

#: src/univention/admin/handlers/monitoring/alert.py:23
msgid "Alerts"
msgstr "Figyelmeztetések"

#: src/univention/admin/handlers/monitoring/alert.py:88
#: src/univention/admin/handlers/monitoring/alert.py:113
#: src/univention/admin/handlers/monitoring/alert.py:114
msgid "Assigned hosts"
msgstr "Hozzárendelt gazdagépek"

#: src/univention/admin/handlers/monitoring/alert.py:103
msgid "Basic settings"
msgstr "Alapbeállítások"

#: src/univention/admin/handlers/monitoring/alert.py:48
msgid "Description template"
msgstr "Leírás sablon"

#: src/univention/admin/handlers/monitoring/alert.py:69
msgid "For clause"
msgstr "For cikus"

#: src/univention/admin/handlers/monitoring/alert.py:103
msgid "General"
msgstr "Általános"

#: src/univention/admin/handlers/monitoring/alert.py:104
msgid "General monitoring settings"
msgstr "Általános monitorozási beállítások"

#: src/univention/admin/handlers/monitoring/alert.py:113
msgid "Hosts"
msgstr "Gazdagépek"

#: src/univention/admin/handlers/monitoring/alert.py:89
msgid "Hosts where this alert is activated for."
msgstr "Azok a gazdagépek, amelyeknél ez a riasztás aktiválva van."

#: src/univention/admin/handlers/monitoring/alert.py:82
msgid "Labels"
msgstr "Címkék"

#: src/univention/admin/handlers/monitoring/alert.py:83
msgid ""
"Labels will be attached to alerts. They can be used for querying alerts."
msgstr ""
"A címkék a riasztásokhoz lesznek csatolva. Ezek felhasználhatók a "
"riasztások lekérdezésére."

#: src/univention/admin/handlers/monitoring/alert.py:39
msgid "Name"
msgstr "Név"

#: src/univention/admin/handlers/monitoring/alert.py:63
msgid ""
"Prometheus query expression, which causes the alert to fire. Alert fires "
"when the given query returns a non-empty vector."
msgstr ""
"Prometheus lekérdezési kifejezés, amely a riasztást kiváltja. A riasztás "
"akkor aktiválódik, amikor a megadott lekérdezés nem üres vektort ad vissza."

#: src/univention/admin/handlers/monitoring/alert.py:62
msgid "Query expression"
msgstr "Lekérdezési kifejezés"

#: src/univention/admin/handlers/monitoring/alert.py:55
msgid "Summary template"
msgstr "Összefoglaló sablon"

#: src/univention/admin/handlers/monitoring/alert.py:94
msgid "Template Values"
msgstr "Sablon értékek"

#: src/univention/admin/handlers/monitoring/alert.py:70
msgid ""
"The amount of time the result of the query expression must be non-empty "
"until the alert fires."
msgstr ""
"Az az időtartam, ameddig a lekérdezési kifejezés eredményének nem üresnek "
"kell lennie, mielőtt a riasztás aktiválódik."

#: src/univention/admin/handlers/monitoring/alert.py:77
msgid ""
"The group into which an alarm is inserted. Multiple alarms can belong to "
"the same group."
msgstr ""
"A csoport, amelybe egy riasztás be van illesztve. Több riasztás is "
"tartozhat ugyanahhoz a csoporthoz."

#: src/univention/admin/handlers/monitoring/alert.py:95
msgid ""
"Values inserted into the query expression, description and summary. "
"References can be done like %name%."
msgstr ""
"Az értékek beillesztése a lekérdezési kifejezésbe, a leírásba és az "
"összefoglalásba. A hivatkozások a következőképpen történhetnek: %name%."
