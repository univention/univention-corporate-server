#: umc/python/admindiary/__init__.py:75
#, python-format
msgid ""
"Check the password in /etc/admin-diary.secret. Is it the same on %s and on "
"%s?"
msgstr ""
"Jelszó ellenőrzés a /etc/admin-diary.secret fájlban. Ugyanaz a %s és a %s "
"szerveren?"

#: umc/python/admindiary/__init__.py:71
msgid "Error connecting to the Admin Diary Backend."
msgstr "Hiba történt az Admin Diary háttérrendszerhez való csatlakozáskor."

#: umc/python/admindiary/__init__.py:76
#, python-format
msgid "Is %s allowed to connect to the database service on %s?"
msgstr ""
"A(z) %s jogosult csatlakozni az adatbázis-szolgáltatáshoz a(z) %s szerveren?"

#: umc/python/admindiary/__init__.py:74
#, python-format
msgid "Make sure your firewall allows connections to %s."
msgstr ""
"Győződj meg arról, hogy a tűzfal engedélyezi a(z) %s-hoz való csatlakozást."

#: umc/python/admindiary/__init__.py:72
#, python-format
msgid ""
"The database management system is \"%s\". Is the service running and does "
"it respond to TCP/IP connections?"
msgstr ""
"Az adatbázis-kezelő rendszer a következő: „%s”. Fut a szolgáltatás, és "
"válaszol a TCP/IP kapcsolatokra?"
