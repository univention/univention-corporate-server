msgid "Demo help"
msgstr "Demó súgó"

#: usr/share/univention-web/js/umc/hooks/univention_demo.js:193
msgid "Dummy entries to apps that could be installed on UCS"
msgstr "Az UCS-re telepíthető alkalmazásokhoz tartozó álbejegyzések"

#: usr/share/univention-web/js/umc/hooks/univention_demo.js:188
msgid "The UCS web interface for administrating users, computers, etc."
msgstr ""
"Az UCS webes felülete felhasználók, számítógépek stb. adminisztrálásához."

#: usr/share/univention-web/js/umc/hooks/univention_demo.js:198
