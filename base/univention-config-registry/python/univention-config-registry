import os
import sys

from univention.config_registry import StrictModeException
from univention.config_registry.frontend import main


if __name__ == '__main__' and not os.path.exists('/etc/univention/disable_config_registry'):
    try:
        sys.exit(main(sys.argv[1:]))
    except StrictModeException as e:
        print('Error: UCR is running in strict mode and thus cannot accept the given input:')
        print(e)
        sys.exit(1)
