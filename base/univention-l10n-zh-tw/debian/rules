%:
	dh $@

# The UCS dojo frontend i18n loader (umc/i18n.js) resolves the locale to its
# PRIMARY language subtag only (regex ^([a-z]{2,3})(_([a-z]{2,3}))? -> m[1]),
# i.e. it requests /i18n/zh/<module>.json for a zh_TW user (just like /i18n/de/
# for de_DE). The build emits client JSON under zh_TW/, so we additionally
# publish a primary-subtag "zh" copy of every client i18n JSON. Server-side .mo
# files keep the full zh_TW locale and are untouched (no "i18n" in their path).
override_dh_auto_install:
	dh_auto_install
	set -e; cd debian/univention-l10n-zh-tw; \
	for f in $$(find . -path '*i18n*' -name '*.json' | grep -E '/zh_TW/|/zh_TW\.json$$'); do \
		n=$$(printf '%s' "$$f" | sed -e 's#/zh_TW/#/zh/#' -e 's#/zh_TW\.json$$#/zh.json#'); \
		mkdir -p "$$(dirname "$$n")"; cp -a "$$f" "$$n"; \
	done
