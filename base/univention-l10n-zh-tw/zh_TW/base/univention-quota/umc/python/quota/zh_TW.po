#, python-format
msgid "%s Days"
msgstr "%s 天"

#: umc/python/quota/tools.py:101 umc/python/quota/tools.py:136 umc/python/quota/partition.py:30 umc/python/quota/partition.py:55 umc/python/quota/user.py:116
#, python-format
msgid "Could not open %s"
msgstr "無法開啟 %s"

