msgstr "DHCP 查詢失敗。"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1836
msgid "DNS server"
msgstr "DNS 伺服器"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:377
msgid "Default system locale"
msgstr "預設系統地區設定"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1794
msgid "Domain and host configuration"
msgstr "網域與主機設定"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:424
msgid "Domain and network configuration"
msgstr "網域與網路設定"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:684
msgid "Domain join information"
msgstr "網域加入資訊"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:747
msgid "Domain name"
msgstr "網域名稱"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:563
msgid "Domain setup"
msgstr "網域設定"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:308
#, javascript-format
msgid "E-mail address to activate %s Appliance"
msgstr "用於啟用 %s Appliance 的電子郵件位址"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:298 usr/share/univention-system-setup/www/ApplianceWizard.js:1690 usr/share/univention-system-setup/www/ApplianceWizard.js:1789
msgid "E-mail address to activate UCS"
msgstr "用於啟用 UCS 的電子郵件位址"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:358
msgid "Enter a city nearby to preconfigure settings such as timezone, system language, keyboard layout."
msgstr "輸入鄰近的城市以預先設定時區、系統語言、鍵盤配置等設定。"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:664 usr/share/univention-system-setup/www/ApplianceWizard.js:685
msgid "Enter name and password of a user account which is authorised to join a system into this domain."
msgstr "輸入有權將系統加入此網域的使用者帳號名稱與密碼。"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1931
msgid "Failed join scripts can be executed via the UMC module <i>Domain join</i>."
msgstr "失敗的加入指令碼可透過 UMC 模組 <i>網域加入</i> 執行。"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1939
msgid "Failed join scripts or a new join of the system can be executed via the UMC module <i>Domain join</i>."
msgstr "失敗的加入指令碼或系統的重新加入可透過 UMC 模組 <i>網域加入</i> 執行。"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:570
msgid "Fast demo configuration"
msgstr "快速示範設定"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:654
msgid "Fill in the password for the system administrator user <b>root</b> and the domain administrative user account <b>Administrator</b>."
msgstr "為系統管理員使用者 <b>root</b> 與網域管理使用者帳號 <b>Administrator</b> 填入密碼。"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1319 usr/share/univention-system-setup/www/ApplianceWizard.js:1322
msgid "Finish"
msgstr "完成"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1113
msgid "For a specified host name, the domain name is automatically derived from the domain name server. A fully qualified domain may be necessary for mail server setups with differing domains.<br/>Note that the domain name <b>cannot</b> be changed after the UCS setup wizard has been completed."
msgstr "對於指定的主機名稱，網域名稱會自動由網域名稱伺服器推導取得。對於採用不同網域的郵件伺服器設定，可能需要完整網域。<br/>請注意，網域名稱在 UCS 設定精靈完成後即 <b>無法</b> 變更。"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:1147
msgid "For further information please look at https://help.univention.com/t/13595."
msgstr "如需進一步資訊，請參閱 https://help.univention.com/t/13595。"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:2258
msgid "For this system, a computer object already exists in the LDAP directory that has been configured for the role &quot;<i>school server in the administration network</i>&quot; and thus contradicts your selection. Please check and correct this before proceeding."
