msgid "Backup Directory Node"
msgstr "備份目錄節點"

#: usr/share/univention-system-setup/www/ApplianceWizard.js:2653 usr/share/univention-system-setup/www/ApplianceWizard.js:2821 usr/share/univention-system-setup/www/ApplianceWizard.js:2991
