#: usr/share/univention-system-setup-boot/www/main.js:26
msgid "Before starting the setup wizard, an initial password for the <i>root</i> user must be set."
msgstr "在啟動設定引導之前，必須為 <i>root</i> 使用者設定初始密碼。"

#: usr/share/univention-system-setup-boot/www/main.js:28
msgid "Connect to this server instance as <i>root</i> via ssh and your selected private ssh key. "
msgstr "透過 ssh 與您所選的 ssh 私密金鑰，以 <i>root</i> 身分連線至此伺服器執行個體。 "

#: usr/share/univention-system-setup-boot/www/main.js:35
msgid "If a password for <i>root</i> has been set, <a href='/univention/setup/?username=root'>start the setup wizard</a>."
msgstr "如果已為 <i>root</i> 設定密碼，請<a href='/univention/setup/?username=root'>啟動設定引導</a>。"

#: usr/share/univention-system-setup-boot/www/main.js:29
msgid "Set a password with <i>passwd</i>, e.g., by issuing the following command:"
msgstr "請使用 <i>passwd</i> 設定密碼，例如執行以下命令："

#: usr/share/univention-system-setup-boot/www/main.js:20
msgid "Welcome to UCS initial configuration"
msgstr "歡迎使用 UCS 初始設定"

#: usr/share/univention-system-setup-boot/www/main.js:31
msgid "ssh -ti &lt;path/to/privatekey&gt; root@%(serveraddress)s passwd"
msgstr ""
