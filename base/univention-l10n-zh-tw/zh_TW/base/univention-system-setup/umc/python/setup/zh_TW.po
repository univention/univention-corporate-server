#: umc/python/setup/__init__.py:465
msgid "A domain name server needs to be specified."
msgstr "需要指定網域名稱伺服器。"

#: umc/python/setup/__init__.py:387
msgid "A valid NetBIOS name can not be longer than 15 characters. If Samba is installed, the hostname should be shortened."
msgstr "有效的 NetBIOS 名稱不能超過 15 個字元。如果已安裝 Samba，則應縮短主機名稱。"

#: umc/python/setup/__init__.py:488
msgid "Active Directory"
msgstr "Active Directory"

#: umc/python/setup/network.py:676
msgid "Bond-primary must exist in bond-slaves"
msgstr "bond-primary 必須存在於 bond-slaves 中"

#: umc/python/setup/__init__.py:423
msgid "Business unit"
msgstr "業務單位"

#: umc/python/setup/__init__.py:501 umc/python/setup/util.py:173
msgid "Cannot automatically determine the domain. Please specify the server's fully qualified domain name."
msgstr "無法自動判斷網域。請指定伺服器的完整網域名稱。"

#: umc/python/setup/network.py:769
#, python-format
msgid "Cannot use bridge %r as bridge-port"
msgstr "無法將 bridge %r 用作 bridge-port"

#: umc/python/setup/network.py:672
#, python-format
msgid "Cannot use device %s: Device must be unconfigured"
msgstr "無法使用裝置 %s: 裝置必須是未設定的狀態"

#: umc/python/setup/__init__.py:426
msgid "Common name for the root SSL certificate"
msgstr "根 SSL 憑證的一般名稱"

#: umc/python/setup/__init__.py:418
msgid "Country"
msgstr "國家/地區"

#: umc/python/setup/__init__.py:436
msgid "Country must be a country code consisting of 2 characters."
msgstr "國家/地區必須是由 2 個字元組成的國家/地區代碼。"

#: umc/python/setup/network.py:365
#, python-format
msgid "Device %(device)r is already in use by %(name)r"
msgstr "裝置 %(device)r 已被 %(name)r 使用"

#: umc/python/setup/network.py:667
#, python-format
msgid "Devices used in a bonding must be physical: %s is not"
msgstr "用於 bonding 的裝置必須是實體裝置: %s 不是"

#: umc/python/setup/__init__.py:452
msgid "Domain name server"
msgstr "網域名稱伺服器"

#: umc/python/setup/network.py:135 umc/python/setup/network.py:145
#, python-format
msgid "Duplicated IP address: %r"
msgstr "IP 位址重複: %r"

#: umc/python/setup/checks/univention_join.py:95
#, python-brace-format
msgid ""
"During the check of the license status the following error occurred:\n"
"{error}"
msgstr ""
"在檢查授權狀態時發生下列錯誤:\n"
"{error}"

#: umc/python/setup/__init__.py:424 umc/python/setup/__init__.py:425
msgid "Email address"
msgstr "電子郵件地址"

#: umc/python/setup/__init__.py:224 umc/python/setup/__init__.py:289
#, python-format
msgid "Encountered unexpected error during setup process: %s"
msgstr "在設定程序中發生未預期的錯誤: %s"

#: umc/python/setup/__init__.py:452
msgid "External name server"
msgstr "外部名稱伺服器"

#: umc/python/setup/setup_script.py:438
#, python-format
msgid "Failed to get package for Role %s"
msgstr "無法取得角色 %s 的套件"

#: umc/python/setup/__init__.py:397
msgid "Hostname is equal to domain name."
msgstr "主機名稱與網域名稱相同。"

#: umc/python/setup/network.py:322
#, python-format
msgid "Invalid IPv4 address: %r"
msgstr "無效的 IPv4 位址: %r"

#: umc/python/setup/network.py:328
#, python-format
msgid "Invalid IPv4 netmask: %r"
msgstr "無效的 IPv4 網路遮罩: %r"

#: umc/python/setup/network.py:338
#, python-format
msgid "Invalid IPv6 address: %r"
msgstr "無效的 IPv6 位址: %r"

#: umc/python/setup/network.py:348
#, python-format
msgid "Invalid IPv6 identifier: %r"
msgstr "無效的 IPv6 識別碼: %r"

#: umc/python/setup/network.py:344
#, python-format
msgid "Invalid IPv6 netmask: %r"
msgstr "無效的 IPv6 網路遮罩: %r"

#: umc/python/setup/network.py:583
msgid "Invalid VLAN ID. Must be between 1 and 4095."
msgstr "無效的 VLAN ID。必須介於 1 與 4095 之間。"

#: umc/python/setup/network.py:686
#, python-format
msgid "Invalid bond-mode: %r"
msgstr "無效的 bond-mode: %r"

#: umc/python/setup/network.py:312 umc/python/setup/network.py:581
#, python-format
msgid "Invalid device name: %r"
msgstr "無效的裝置名稱: %r"

#: umc/python/setup/__init__.py:517
msgid "It is not possible to install Samba 3 and Samba 4 on one system. Please select only one of these components."
msgstr "無法在同一個系統上安裝 Samba 3 與 Samba 4。請只選擇其中一個元件。"

#: umc/python/setup/__init__.py:420
msgid "Location"
msgstr "位置"

#: umc/python/setup/network.py:352
msgid "Missing IPv6 default identifier"
msgstr "缺少 IPv6 預設識別碼"

#: umc/python/setup/network.py:658
msgid "Missing device for bond-slaves"
msgstr "缺少 bond-slaves 的裝置"

#: umc/python/setup/network.py:572 umc/python/setup/network.py:663 umc/python/setup/network.py:765
#, python-format
msgid "Missing device: %r"
msgstr "缺少裝置: %r"

#: umc/python/setup/network.py:357
msgid "Multiple IPv4 addresses are not supported on this device."
msgstr "此裝置不支援多個 IPv4 位址。"

#: umc/python/setup/checks/univention_join.py:61
msgid "No UCS Primary Directory Node could be found at the address."
msgstr "在該位址找不到 UCS 主要目錄節點。"

#: umc/python/setup/__init__.py:400
msgid "No fully qualified domain name has been specified for the system."
msgstr "尚未為系統指定完整網域名稱。"

#: umc/python/setup/__init__.py:402
msgid "No hostname has been specified for the system."
msgstr "尚未為系統指定主機名稱。"

#: umc/python/setup/__init__.py:421 umc/python/setup/__init__.py:422
msgid "Organization"
msgstr "組織"

#: umc/python/setup/__init__.py:438
msgid "Please enter a valid email address"
msgstr "請輸入有效的電子郵件地址"

#: umc/python/setup/__init__.py:390
msgid "Please enter a valid fully qualified domain name (e.g. host.example.com)."
msgstr "請輸入有效的完整網域名稱 (例如 host.example.com)。"

#: umc/python/setup/__init__.py:70
msgid "Request Timeout"
msgstr "要求逾時"

#: umc/python/setup/__init__.py:419
msgid "State"
msgstr "州/省"

#: umc/python/setup/__init__.py:410
msgid "The LDAP base may neither contain blanks nor any special characters. Its structure needs to consist of at least two relative distinguished names (RDN) which may only use the attribute tags 'dc', 'cn', 'c', 'o', or 'l' (e.g., dc=test,dc=net)."
msgstr "LDAP base 不可包含空白或任何特殊字元。其結構至少需由兩個相對辨別名稱 (RDN) 組成，且只能使用屬性標記 'dc'、'cn'、'c'、'o' 或 'l' (例如 dc=test,dc=net)。"

#: umc/python/setup/checks/univention_join.py:108
msgid "The UCS version of the domain you are trying to join ({}) is lower than the local one ({}). This constellation is not supported."
msgstr "您嘗試加入的網域的 UCS 版本 ({}) 低於本機版本 ({})。不支援此種組合。"

#: umc/python/setup/util.py:1099
msgid "The connection to the Active Directory server failed. Please recheck the address."
msgstr "連線至 Active Directory 伺服器失敗。請重新檢查位址。"

#: umc/python/setup/util.py:1102
msgid "The connection to the Active Directory server was refused. Please recheck the password."
msgstr "連線至 Active Directory 伺服器遭拒。請重新檢查密碼。"

#: umc/python/setup/checks/univention_join.py:64
msgid "The connection to the UCS Primary Directory Node was refused. Please recheck the password."
msgstr "連線至 UCS 主要目錄節點遭拒。請重新檢查密碼。"

#: umc/python/setup/__init__.py:430
#, python-format
msgid "The following value is too long, only %(max)s characters allowed: %(name)s"
msgstr "下列值太長，最多只允許 %(max)s 個字元: %(name)s"

#: umc/python/setup/util.py:1105
msgid "The given user is not member of the Domain Admins group in Active Directory. This is a requirement for the Active Directory domain join."
msgstr "所指定的使用者不是 Active Directory 中 Domain Admins 群組的成員。這是加入 Active Directory 網域的必要條件。"

#: umc/python/setup/__init__.py:387
#, python-format
msgid "The hostname %s is longer than 15 characters. It will not be possible to install an Active Directory compatible Domaincontroller (Samba 4) or UCS@school. The hostname cannot be changed after the installation of %s. It is recommended to shorten the hostname to maximal 15 characters."
msgstr "主機名稱 %s 超過 15 個字元。將無法安裝與 Active Directory 相容的 Domaincontroller (Samba 4) 或 UCS@school。主機名稱在安裝 %s 之後即無法變更。建議將主機名稱縮短至最多 15 個字元。"

#: umc/python/setup/__init__.py:381
msgid "The hostname or the hostname part of the fully qualified domain name is invalid. Please go back to the host setting and make sure, that the hostname only contains letter (a-zA-Z) and digits (0-9)."
msgstr "主機名稱或完整網域名稱中的主機名稱部分無效。請返回主機設定，並確認主機名稱只包含字母 (a-zA-Z) 與數字 (0-9)。"

#: umc/python/setup/__init__.py:395
msgid "The length of fully qualified domain name is greater than 63 characters."
msgstr "完整網域名稱的長度超過 63 個字元。"

#: umc/python/setup/checks/univention_join.py:90
#, python-format
msgid "The license %s is not valid."
msgstr "授權 %s 無效。"

#: umc/python/setup/__init__.py:449
msgid "The primary network device must exist."
msgstr "主要網路裝置必須存在。"

#: umc/python/setup/__init__.py:413
msgid "The root password is too short. For security reasons, your password must contain at least 8 characters."
msgstr "root 密碼太短。基於安全考量，您的密碼必須至少包含 8 個字元。"

#: umc/python/setup/__init__.py:414
msgid "The root password may only contain ascii characters."
msgstr "root 密碼只能包含 ascii 字元。"

#: umc/python/setup/__init__.py:459
#, python-format
msgid "The specified IP address (%(name)s) is not valid: %(value)s"
msgstr "所指定的 IP 位址 (%(name)s) 無效: %(value)s"

#: umc/python/setup/__init__.py:488
#, python-format
msgid "The specified domain name is different to the %s domain name found via the configured DNS server: %s"
msgstr "所指定的網域名稱與透過已設定的 DNS 伺服器找到的 %s 網域名稱不同: %s"

#: umc/python/setup/__init__.py:508
#, python-format
msgid "The specified gateway IPv4 address is not valid: %s"
msgstr "所指定的閘道 IPv4 位址無效: %s"

#: umc/python/setup/__init__.py:510
#, python-format
msgid "The specified gateway IPv6 address is not valid: %s"
msgstr "所指定的閘道 IPv6 位址無效: %s"

#: umc/python/setup/__init__.py:504
#, python-format
msgid "The specified nameserver %s is not part of a valid UCS domain."
msgstr "所指定的名稱伺服器 %s 不屬於有效的 UCS 網域。"

#: umc/python/setup/__init__.py:513
#, python-format
msgid "The specified proxy address is not valid (e.g., http://10.201.1.1:8080): %s"
msgstr "所指定的 proxy 位址無效 (例如 http://10.201.1.1:8080): %s"

#: umc/python/setup/__init__.py:434
#, python-format
msgid "The value for %s contains invalid characters."
msgstr "%s 的值包含無效字元。"

#: umc/python/setup/__init__.py:405
msgid "The windows domain name can only consist of upper case characters."
msgstr "windows 網域名稱只能由大寫字元組成。"

#: umc/python/setup/__init__.py:406
msgid "The windows domain name cannot be longer than 15 characters."
msgstr "windows 網域名稱不能超過 15 個字元。"

#: umc/python/setup/__init__.py:407
msgid "The windows domain name is not valid."
msgstr "windows 網域名稱無效。"

#: umc/python/setup/network.py:124
msgid "There is no device configured. At least one IPv4 or IPv6 address or DHCP or SLAAC has to be specified."
msgstr "未設定任何裝置。至少必須指定一個 IPv4 或 IPv6 位址，或 DHCP 或 SLAAC。"

#: umc/python/setup/checks/univention_join.py:94
#, python-brace-format
msgid "To install the {appliance_name} appliance it is necessary to have an activated UCS license on the Primary Directory Node."
msgstr "若要安裝 {appliance_name} appliance，主要目錄節點上必須有已啟用的 UCS 授權。"

#: umc/python/setup/__init__.py:488
msgid "UCS"
msgstr "UCS"

#: umc/python/setup/__init__.py:386
#, python-format
msgid "the %s appliance"
msgstr "%s appliance"

#: umc/python/setup/__init__.py:384
msgid "the UCS system"
msgstr "UCS 系統"

#: umc/python/setup/checks/univention_join.py:39
msgid ""
"univention-join -checkPrerequisites reported a problem. Output of check:\n"
"\n"
msgstr ""
"univention-join -checkPrerequisites 回報問題。檢查的輸出:\n"
"\n"
