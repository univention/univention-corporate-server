#: umc/python/admindiary/__init__.py:75
#, python-format
msgid "Check the password in /etc/admin-diary.secret. Is it the same on %s and on %s?"
msgstr "請檢查 /etc/admin-diary.secret 中的密碼。它在 %s 與 %s 上是否相同？"

#: umc/python/admindiary/__init__.py:71
msgid "Error connecting to the Admin Diary Backend."
msgstr "連線到 Admin Diary 後端時發生錯誤。"

#: umc/python/admindiary/__init__.py:76
#, python-format
msgid "Is %s allowed to connect to the database service on %s?"
msgstr "%s 是否允許連線到 %s 上的資料庫服務？"

#: umc/python/admindiary/__init__.py:74
#, python-format
msgid "Make sure your firewall allows connections to %s."
msgstr "請確認您的防火牆允許連線到 %s。"

#: umc/python/admindiary/__init__.py:72
#, python-format
msgid "The database management system is \"%s\". Is the service running and does it respond to TCP/IP connections?"
msgstr "資料庫管理系統為 \"%s\"。該服務是否正在執行，且能回應 TCP/IP 連線？"
