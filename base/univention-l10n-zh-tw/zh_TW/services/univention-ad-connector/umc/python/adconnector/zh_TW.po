#: umc/python/adconnector/__init__.py:300
msgid "Active Directory Connector is already running. Nothing to do."
msgstr "Active Directory Connector 已在執行中，無須進行任何動作。"

#: umc/python/adconnector/__init__.py:302
msgid "Active Directory Connector is already stopped. Nothing to do."
msgstr "Active Directory Connector 已停止，無須進行任何動作。"

#: umc/python/adconnector/__init__.py:315
msgid "Active Directory connection service has been started."
msgstr "Active Directory 連線服務已啟動。"

#: umc/python/adconnector/__init__.py:317
msgid "Active Directory connection service has been stopped."
msgstr "Active Directory 連線服務已停止。"

#: umc/python/adconnector/__init__.py:253
msgid "Active Directory connection settings have been saved and a new certificate for the Active Directory server has been created."
msgstr "Active Directory 連線設定已儲存，並已為 Active Directory 伺服器建立新的憑證。"

#: umc/python/adconnector/__init__.py:244
msgid "Active Directory connection settings have been saved."
msgstr "Active Directory 連線設定已儲存。"

#: umc/python/adconnector/__init__.py:461
msgid "An error occurred while installing necessary software components."
msgstr "安裝必要的軟體元件時發生錯誤。"

#: umc/python/adconnector/__init__.py:417
#, python-format
msgid "An unexpected error occurred: %s"
msgstr "發生未預期的錯誤: %s"

#: umc/python/adconnector/__init__.py:266
msgid "Certificate has been uploaded successfully."
msgstr "憑證已成功上傳。"

#: umc/python/adconnector/__init__.py:275
msgid "Certificate upload or conversion failed."
msgstr "憑證上傳或轉換失敗。"

#: umc/python/adconnector/__init__.py:470
msgid "Configuring Administrator account..."
msgstr "正在設定 Administrator 帳戶..."

#: umc/python/adconnector/__init__.py:476
msgid "Configuring DNS entries..."
msgstr "正在設定 DNS 項目..."

#: umc/python/adconnector/__init__.py:435
msgid "Configuring DNS server..."
msgstr "正在設定 DNS 伺服器..."

#: umc/python/adconnector/__init__.py:439
msgid "Configuring Kerberos settings..."
msgstr "正在設定 Kerberos 設定..."

#: umc/python/adconnector/__init__.py:443
msgid "Configuring reverse DNS settings..."
msgstr "正在設定反向 DNS 設定..."

#: umc/python/adconnector/__init__.py:446
msgid "Configuring software components..."
msgstr "正在設定軟體元件..."

#: umc/python/adconnector/__init__.py:463
msgid "Configuring synchronization from AD..."
msgstr "正在設定從 AD 進行的同步..."

#: umc/python/adconnector/__init__.py:431
msgid "Configuring time synchronization..."
msgstr "正在設定時間同步..."

#: umc/python/adconnector/__init__.py:368 umc/python/adconnector/__init__.py:496
#, python-format
msgid "Could not connect to AD Server %s. Please verify that the specified address is correct. (%s)"
msgstr "無法連線至 AD 伺服器 %s。請確認指定的位址是否正確。(%s)"

#: umc/python/adconnector/__init__.py:374 umc/python/adconnector/__init__.py:500
#, python-format
msgid ""
"Could not connect to AD Server %s. Please verify that username and password are correct. (Details:\n"
"%s)"
msgstr ""
"無法連線至 AD 伺服器 %s。請確認使用者名稱與密碼是否正確。(詳細資訊:\n"
"%s)"

#: umc/python/adconnector/__init__.py:545
#, python-format
msgid "Could not establish an encrypted connection. Either \"%r\" is not reachable or does not support encryption."
msgstr "無法建立加密連線。可能是 \"%r\" 無法連線或不支援加密。"

#: umc/python/adconnector/__init__.py:271
msgid "Could not establish connection. Either the certificate is wrong, the Active Directory server is unreachable or it does not support SSL."
msgstr "無法建立連線。可能是憑證錯誤、Active Directory 伺服器無法連線或不支援 SSL。"

#: umc/python/adconnector/__init__.py:512
#, python-format
msgid "Could not synchronize the time between the UCS system and the Active Directory domain controller: %s"
msgstr "無法在 UCS 系統與 Active Directory 網域控制站之間同步時間: %s"

#: umc/python/adconnector/__init__.py:252
#, python-format
msgid "Creation of certificate failed (%s)"
msgstr "建立憑證失敗 (%s)"

#: umc/python/adconnector/__init__.py:510
msgid "Failed to add the Administrator account to the Domain Admins group."
msgstr "無法將 Administrator 帳戶加入 Domain Admins 群組。"

#: umc/python/adconnector/__init__.py:504
msgid "Failed to create the Administrator account in UCS."
msgstr "無法在 UCS 中建立 Administrator 帳戶。"

#: umc/python/adconnector/__init__.py:508
msgid "Failed to search for the well known SID."
msgstr "無法搜尋知名 SID。"

#: umc/python/adconnector/__init__.py:502
msgid "Failed to set the password of the UCS Administrator to the Active Directory Administrator password."
msgstr "無法將 UCS Administrator 的密碼設定為 Active Directory Administrator 的密碼。"

#: umc/python/adconnector/__init__.py:490
msgid "Join has been finished successfully."
msgstr "加入已成功完成。"

#: umc/python/adconnector/__init__.py:521
msgid "Join has been finished with errors."
msgstr "加入已完成，但發生錯誤。"

#: umc/python/adconnector/__init__.py:395
msgid "Joining UCS into Active Directory domain"
msgstr "正在將 UCS 加入 Active Directory 網域"

#: umc/python/adconnector/__init__.py:486
msgid "Registering LDAP service entry..."
msgstr "正在註冊 LDAP 服務項目..."

#: umc/python/adconnector/__init__.py:467
msgid "Renaming well known SID objects..."
msgstr "正在重新命名知名 SID 物件..."

#: umc/python/adconnector/__init__.py:473
msgid "Running Samba join script..."
msgstr "正在執行 Samba 加入指令碼..."

#: umc/python/adconnector/__init__.py:220
#, python-format
msgid "Saving bind password failed (filename=%(fn)s ; exception=%(exception)s)"
msgstr "儲存 bind 密碼失敗 (filename=%(fn)s ; exception=%(exception)s)"

#: umc/python/adconnector/__init__.py:483
msgid "Starting Active Directory connection service..."
msgstr "正在啟動 Active Directory 連線服務..."

#: umc/python/adconnector/__init__.py:311
msgid "Switching running state of Active Directory Connector failed."
msgstr "切換 Active Directory Connector 的執行狀態失敗。"

#: umc/python/adconnector/__init__.py:365 umc/python/adconnector/__init__.py:494
msgid "The AD member mode can only be configured on a Primary Directory Node."
msgstr "AD 成員模式只能在主要目錄節點上設定。"

#: umc/python/adconnector/__init__.py:371 umc/python/adconnector/__init__.py:498
#, python-format
msgid "The domain name of the AD Server (%(ad_domain)s) does not match the local UCS domain name (%(ucs_domain)s). For the AD member mode, it is necessary to setup a UCS system with the same domain name as the AD Server."
msgstr "AD 伺服器的網域名稱 (%(ad_domain)s) 與本機 UCS 網域名稱 (%(ucs_domain)s) 不符。使用 AD 成員模式時，必須設定一個與 AD 伺服器具有相同網域名稱的 UCS 系統。"

#: umc/python/adconnector/__init__.py:377
msgid "The given user is not member of the Domain Admins group in Active Directory. This is a requirement for the Active Directory domain join."
msgstr "指定的使用者不是 Active Directory 中 Domain Admins 群組的成員。這是加入 Active Directory 網域的必要條件。"

#: umc/python/adconnector/__init__.py:506
msgid "The sambaSID could not set for the Administrator account in UCS."
msgstr "無法為 UCS 中的 Administrator 帳戶設定 sambaSID。"
