#: www/login/main.js:454
msgid "Authentication required"
msgstr "需要認證"

#: www/login/main.js:511
msgid "Cancel"
msgstr "取消"

#: www/login/LoginDialog.js:201
msgid "Changing password failed. The passwords do not match, please retype again."
msgstr "變更密碼失敗。兩次輸入的密碼不一致，請重新輸入。"

#: www/login/main.js:510
msgid "Do you really want to logout?"
msgstr "您確定要登出嗎？"

#: www/login/dialog.js:103
msgid "How do I login?"
msgstr "我要如何登入？"

#: www/login/main.js:169 www/login/main.js:474 www/login/LoginDialog.js:41 www/login/LoginDialog.js:214
msgid "Login"
msgstr "登入"

#: www/login/config.js:29
msgid "Login at %(domainname)s"
msgstr "登入 %(domainname)s"

#: www/login/main.js:516
msgid "Logout"
msgstr "登出"

#: www/login/LoginDialog.js:39
msgid "New Password"
msgstr "新密碼"

#: www/login/LoginDialog.js:40 www/login/LoginDialog.js:221
msgid "New Password (retype)"
msgstr "新密碼 (再次輸入)"

#: www/login/LoginDialog.js:220
msgid "New password"
msgstr "新密碼"

#: www/login/LoginDialog.js:42 www/login/LoginDialog.js:222
msgid "One time password"
msgstr "一次性密碼"

#: www/login/main.js:469 www/login/LoginDialog.js:38 www/login/LoginDialog.js:219
msgid "Password"
msgstr "密碼"

#: www/login/dialog.js:181
msgid "Please enable your browser cookies which are necessary for using Univention Services."
msgstr "請啟用瀏覽器 cookie,這是使用 Univention 服務所必需的。"

#: www/login/dialog.js:96
msgid "Please login with a valid username and password."
msgstr "請使用有效的使用者名稱與密碼登入。"

#: www/login/LoginDialog.js:215
msgid "Set password"
msgstr "設定密碼"

#: www/login/main.js:366
msgid "So far the authentication failed. Continuing nevertheless."
msgstr "目前認證失敗，仍將繼續。"

#: www/login/dialog.js:151
msgid "The <i>root</i> user neither has access to the domain administration nor to the App Center."
msgstr "<i>root</i> 使用者既無法存取網域管理，也無法存取 App Center。"

#: www/login/main.js:169
msgid "The current session timed out. Please login again."
msgstr "目前的工作階段已逾時，請重新登入。"

#: www/login/dialog.js:100 www/login/dialog.js:151
#, javascript-format
msgid "The default user to manage the domain is %s which has the same initial password as the <i>root</i> account."
msgstr "管理網域的預設使用者是 %s,其初始密碼與 <i>root</i> 帳號相同。"

#: www/login/main.js:449
msgid "This action requires you to supply your password."
msgstr "此動作需要您提供密碼。"

#: www/login/dialog.js:133
msgid "This network connection is not encrypted. All personal or sensitive data such as passwords will be transmitted in plain text. Please follow this link to use a secure SSL connection."
msgstr "此網路連線未加密。所有個人或敏感資料 (例如密碼) 都會以明文傳輸。請點選此連結以使用安全的 SSL 連線。"

#: www/login/dialog.js:134
msgid "This network connection is not encrypted.<br/>Click here for an HTTPS connection."
msgstr "此網路連線未加密。<br/>請點選此處以使用 HTTPS 連線。"

#: www/login/dialog.js:98
#, javascript-format
msgid "Use the %s user for the initial system configuration."
msgstr "請使用 %s 使用者進行初始系統設定。"

#: www/login/LoginDialog.js:37 www/login/LoginDialog.js:218
msgid "Username"
msgstr "使用者名稱"
