#: umc/js/lib/server.js:81 umc/js/lib/server.js:139
msgid "<b>Note:</b> After the restart you will be redirected to the login page."
msgstr "<b>注意:</b> 重新啟動後，您將被重新導向至登入頁面。"

#: umc/js/lib/server.js:84 umc/js/lib/server.js:142 umc/js/lib/server.js:205
msgid "Cancel"
msgstr "取消"

#: umc/js/lib/server.js:138
msgid "Please confirm to reboot this server. This may take a few minutes."
msgstr "請確認要重新開機此伺服器。這可能需要幾分鐘的時間。"

#: umc/js/lib/server.js:80
msgid "Please confirm to restart the UMC server and the HTTP web server. This will take approximately 10 seconds."
msgstr "請確認要重新啟動 UMC 伺服器與 HTTP 網頁伺服器。這大約需要 10 秒鐘。"

#: umc/js/lib/server.js:202
msgid "Please confirm to shutdown this server. This may take a few minutes."
msgstr "請確認要關閉此伺服器。這可能需要幾分鐘的時間。"

#: umc/js/lib/server.js:113
msgid "Please wait while UMC server components and HTTP web server are being restarted."
msgstr "正在重新啟動 UMC 伺服器元件與 HTTP 網頁伺服器，請稍候。"

#: umc/js/lib/server.js:146
msgid "Reboot"
msgstr "重新開機"

#: umc/js/lib/server.js:163
msgid "Rebooting server"
msgstr "正在重新開機伺服器"

#: umc/js/lib/server.js:88
msgid "Restart"
msgstr "重新啟動"

#: umc/js/lib/server.js:110
msgid "Restarting server"
msgstr "正在重新啟動伺服器"

#: umc/js/lib/server.js:209
msgid "Shutdown"
msgstr "關機"

#: umc/js/lib/server.js:228
msgid "Shutting down server"
msgstr "正在關閉伺服器"

#: umc/js/lib/server.js:166
msgid "The server is being rebooted."
msgstr "伺服器正在重新開機。"

#: umc/js/lib/server.js:231
msgid "The server is shutting down."
msgstr "伺服器正在關閉。"
