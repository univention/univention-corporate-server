#: umc/js/adtakeover.js:78
msgid "<p>A <i>{ad_os}</i> Active Directory domain with the domainname <i>{ad_domain}</i> has been found. The server <i>{ad_hostname} ({ad_ip})</i> will be used as Active Directory Domain Controller for the takeover.</p><p>The following accounts have been found in the Active Directory domain:<ul><li>{users} users</li><li>{groups} groups</li><li>{computers} computers</li></ul>Click \"Next\" to start with the migration.</p>"
msgstr "<p>已找到網域名稱為 <i>{ad_domain}</i> 的 <i>{ad_os}</i> Active Directory 網域。伺服器 <i>{ad_hostname} ({ad_ip})</i> 將被用作接管的 Active Directory Domain Controller。</p><p>在此 Active Directory 網域中找到下列帳戶:<ul><li>{users} 個使用者</li><li>{groups} 個群組</li><li>{computers} 部電腦</li></ul>按一下「下一步」以開始進行移轉。</p>"

#: umc/js/adtakeover.js:46
msgid "<p>A previous Active Directory takeover was detected.</p><p>In order to start another takeover process, click \"Next\".</p>"
msgstr "<p>偵測到先前的 Active Directory 接管。</p><p>若要開始另一個接管程序，請按一下「下一步」。</p>"

#: umc/js/adtakeover.js:89
msgid "<p>All Windows domain accounts have been successfully transferred.</p><p>As next step, group policies must be copied from the Active Directory SYSVOL share to Univention Corporate Server. We recommend using robocopy from a Windows client or Windows server which is joined to the domain:</p>"
msgstr "<p>所有 Windows 網域帳戶皆已成功轉移。</p><p>下一步，必須將群組原則從 Active Directory SYSVOL 共用複製到 Univention Corporate Server。我們建議從已加入網域的 Windows 用戶端或 Windows 伺服器使用 robocopy:</p>"

#: umc/js/adtakeover.js:107
msgid "<p>Congratulations, the Active Directory Takeover wizard has been successfully completed and all Windows domain accounts have been transferred to Univention Corporate Server.</p><p>The domain is now ready for usage without any further changes.</p>"
msgstr "<p>恭喜，Active Directory 接管引導已成功完成，且所有 Windows 網域帳戶皆已轉移至 Univention Corporate Server。</p><p>此網域現已可供使用，無須進行任何其他變更。</p>"

#: umc/js/adtakeover.js:98
msgid "<p>The group policies have been transferred successfully.</p><p>In order to complete the takeover process, all previous Active Directory Domain Controllers need to be switched off now. Click \"Next\" as soon as all Domain Controllers are shutdown completely.</p>"
msgstr "<p>群組原則已成功轉移。</p><p>若要完成接管程序，現在必須關閉所有先前的 Active Directory Domain Controller。一旦所有 Domain Controller 皆已完全關機，請按一下「下一步」。</p>"

#: umc/js/adtakeover.js:62
msgid "Active Directory Administrator account"
msgstr "Active Directory 系統管理員帳戶"

#: umc/js/adtakeover.js:68
msgid "Active Directory Administrator password"
msgstr "Active Directory 系統管理員密碼"

#: umc/js/adtakeover.js:103
msgid "Completion of the Active Directory Takeover"
msgstr "完成 Active Directory 接管"

#: umc/js/adtakeover.js:73
msgid "Import statistics"
msgstr "匯入統計"

#: umc/js/adtakeover.js:57
msgid "Name or address of the Domain Controller"
msgstr "Domain Controller 的名稱或位址"

#: umc/js/adtakeover.js:42
msgid "Previous takeover detected"
msgstr "偵測到先前的接管"

#: umc/js/adtakeover.js:94
msgid "Takeover of the Windows domain"
msgstr "接管 Windows 網域"

#: umc/js/adtakeover.js:52
msgid "This module guides through the migration from a Windows Active Directory domain to Univention Corporate Server. All user, group and computer accounts along with their passwords and group policies are transferred. After the migration, the Windows clients are directly operable without the need of a domain rejoin."
msgstr "此模組會引導您將 Windows Active Directory 網域移轉至 Univention Corporate Server。所有使用者、群組與電腦帳戶連同其密碼及群組原則皆會被轉移。移轉完成後，Windows 用戶端可直接運作，無須重新加入網域。"

#: umc/js/adtakeover.js:84
msgid "Transfer of group policies"
msgstr "轉移群組原則"

#: umc/js/adtakeover.js:51
msgid "Windows domain authentication"
msgstr "Windows 網域認證"
