#: python/appcenter/utils.py:277
#, python-format
msgid "%s could not be downloaded. This seems to be a problem with the App Center server. Please try again later."
msgstr "無法下載 %s。這似乎是 App Center 伺服器的問題。請稍後再試。"

#: python/appcenter/exceptions.py:317
msgid "An error occurred!"
msgstr "發生錯誤！"

#: python/appcenter/exceptions.py:328
msgid "An unexpected error occured before the installation started!"
msgstr "安裝開始前發生未預期的錯誤！"

#: python/appcenter/exceptions.py:264
msgid "LDAP connection refused. There may be an issue with the certificate of the LDAP server. Please also check the proxy and firewall settings, if any."
msgstr "LDAP 連線遭拒。LDAP 伺服器的憑證可能有問題。如果有設定 Proxy 與防火牆，也請一併檢查。"

#: python/appcenter/settings.py:232
msgid "Password"
msgstr "密碼"

#: python/appcenter/app.py:1559 python/appcenter/install_checks.py:351
#, python-format
msgid "The application needs a %(needs)s-bit operating system. This server is running a %(has)s-bit operating system."
msgstr "此應用程式需要 %(needs)s 位元的作業系統。此伺服器執行的是 %(has)s 位元的作業系統。"

#: python/appcenter/exceptions.py:323
msgid "The docker container could not be started!"
msgstr "無法啟動 Docker 容器！"

#: python/appcenter/utils.py:283 python/appcenter/utils.py:304
#, python-format
msgid "There is a problem with the certificate of the App Center server %s."
msgstr "App Center 伺服器 %s 的憑證發生問題。"

#: python/appcenter/utils.py:306
msgid "There was a problem with the HTTP response of the server (BadStatusLine). Please try again later."
msgstr "伺服器的 HTTP 回應發生問題 (BadStatusLine)。請稍後再試。"

#: python/appcenter/utils.py:279
msgid "This is a problem with the App Center server. Please try again later."
msgstr "這是 App Center 伺服器的問題。請稍後再試。"

#: python/appcenter/utils.py:299
#, python-format
msgid "This is probably due to the DNS settings of your server. You may find help at %s."
msgstr "這可能是由於您伺服器的 DNS 設定所致。您可以在 %s 找到協助。"

#: python/appcenter/utils.py:296
#, python-format
msgid "This may be a problem with the firewall or proxy of your system. You may find help at %s."
msgstr "這可能是您系統的防火牆或 Proxy 的問題。您可以在 %s 找到協助。"

#: python/appcenter/exceptions.py:318
msgid "We are sorry for the inconvenience. Please help us to improve the App Center and the Apps by sending us the information below."
msgstr "造成不便，我們深感抱歉。請將以下資訊傳送給我們，協助我們改善 App Center 與各項應用程式。"

#: python/appcenter/utils.py:295
#, python-format
msgid "https://docs.software-univention.de/manual-%s.html#ip-config:Web_proxy_for_caching_and_policy_management__virus_scan"
msgstr ""

#: python/appcenter/utils.py:298
#, python-format
msgid "https://docs.software-univention.de/manual-%s.html#networks:dns"
msgstr ""
