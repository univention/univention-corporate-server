#: umc/python/udm/__init__.py:376
#, python-format
msgid "%($dn$)s moved"
msgstr "%($dn$)s 已移動"

#: umc/python/udm/udm_ldap.py:323
#, python-format
msgid "All IP addresses in the specified network \"%s\" are already in use."
msgstr "指定網路 \"%s\" 中的所有 IP 位址都已被使用。"

#: umc/python/udm/__init__.py:1368
#, python-format
msgid "An error occurred while contacting the license server: %s"
msgstr "與授權伺服器聯絡時發生錯誤: %s"

#: umc/python/udm/udm_ldap.py:274
msgid "Authentication failed"
msgstr "認證失敗"

#: umc/python/udm/__init__.py:1329
msgid "Cannot parse License from LDAP"
msgstr "無法從 LDAP 剖析授權"

#: umc/python/udm/udm_ldap.py:259
msgid "Check the join status of this system by using the domain join UMC module"
msgstr "請使用網域加入 UMC 模組檢查此系統的加入狀態"

#: umc/python/udm/udm_ldap.py:294
#, python-format
msgid "Could not identify the LDAP object type for %s."
msgstr "無法判斷 %s 的 LDAP 物件類型。"

#: umc/python/udm/__init__.py:384
msgid "Could not identify the given LDAP object"
msgstr "無法判斷指定的 LDAP 物件"

#: umc/python/udm/udm_ldap.py:305
#, python-format
msgid "Could not identify the superordinate %s."
msgstr "無法判斷上層物件 %s。"

#: umc/python/udm/udm_ldap.py:950
msgid "Distinguished Name"
msgstr "辨別名稱"

#: umc/python/udm/udm_ldap.py:256
msgid "Ensure that the LDAP server on this system is running and responsive"
msgstr "請確認此系統上的 LDAP 伺服器正在執行且能正常回應"

#: umc/python/udm/udm_ldap.py:322
msgid "Failed to automatically assign an IP address."
msgstr "自動指派 IP 位址失敗。"

#: umc/python/udm/udm_ldap.py:263
msgid "If the problem persists additional hints about the cause can be found in the following log file(s):"
msgstr "若問題持續發生，可在下列記錄檔中找到更多關於原因的提示:"

#: umc/python/udm/udm_ldap.py:295 umc/python/udm/udm_ldap.py:306
msgid "If the problem persists please try to relogin into Univention Management Console."
msgstr "若問題持續發生，請嘗試重新登入 Univention Management Console。"

#: umc/python/udm/udm_ldap.py:262
msgid "Install the latest software updates"
msgstr "安裝最新的軟體更新"

#: umc/python/udm/udm_ldap.py:298 umc/python/udm/udm_ldap.py:309
msgid "It possibly has been deleted or moved. Please update your search results and open the object again."
msgstr "它可能已被刪除或移動。請更新搜尋結果後重新開啟該物件。"

#: umc/python/udm/__init__.py:334
#, python-format
msgid "LDAP error: %s."
msgstr "LDAP 錯誤: %s。"

#: umc/python/udm/udm_ldap.py:297
#, python-format
msgid "LDAP object %s could not be found."
msgstr "找不到 LDAP 物件 %s。"

#: umc/python/udm/__init__.py:363 umc/python/udm/__init__.py:474
msgid "LDAP object could not be identified"
msgstr "無法辨識 LDAP 物件"

#: umc/python/udm/__init__.py:447
msgid "LDAP object does not exist."
msgstr "LDAP 物件不存在。"

#: umc/python/udm/__init__.py:336
msgid "License import failed: malformed LDIF."
msgstr "授權匯入失敗: LDIF 格式錯誤。"

#: umc/python/udm/tools.py:130
msgid "License not found. During this session add and modify are disabled."
msgstr "找不到授權。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/udm_ldap.py:260
msgid "Make sure all join scripts were successfully executed"
msgstr "請確認所有 join 指令稿都已成功執行"

#: umc/python/udm/udm_ldap.py:257
msgid "Make sure the DNS settings of this server are correctly set up and the DNS server is responsive"
msgstr "請確認此伺服器的 DNS 設定正確，且 DNS 伺服器能正常回應"

#: umc/python/udm/tools.py:54
msgid "More than one object has been found."
msgstr "找到多個物件。"

#: umc/python/udm/__init__.py:376
#, python-format
msgid "Moving %d object(s)"
msgstr "正在移動 %d 個物件"

#: umc/python/udm/__init__.py:263
msgid "No flavor or valid UDM module name specified"
msgstr "未指定 flavor 或有效的 UDM 模組名稱"

#: umc/python/udm/tools.py:48 umc/python/udm/tools.py:52
msgid "No license has been found."
msgstr "找不到任何授權。"

#: umc/python/udm/__init__.py:366
msgid "Object does not support restore operation"
msgstr "此物件不支援還原操作"

#: umc/python/udm/udm_ldap.py:896
msgid "Objects referencing this policy object"
msgstr "參照此原則物件的物件"

#. i18n: translation for univention-directory-reports
#: umc/python/udm/__init__.py:671
msgid "PDF Document"
msgstr "PDF 文件"

#: umc/python/udm/udm_ldap.py:324
msgid "Please specify a different network or make sure that free IP addresses are available for the chosen network."
msgstr "請指定其他網路，或確認所選網路有可用的 IP 位址。"

#: umc/python/udm/udm_ldap.py:476 umc/python/udm/__init__.py:967
#, python-format
msgid "Property %s not found"
msgstr "找不到屬性 %s"

#: umc/python/udm/udm_ldap.py:896
msgid "Referencing objects"
msgstr "參照中的物件"

#: umc/python/udm/udm_ldap.py:308
#, python-format
msgid "Superordinate %s could not be found."
msgstr "找不到上層物件 %s。"

#: umc/python/udm/udm_ldap.py:254
#, python-format
msgid "The LDAP DN of the user %s could not be determined."
msgstr "無法判斷使用者 %s 的 LDAP DN。"

#: umc/python/udm/tools.py:63
#, python-format
msgid "The LDAP base of the license does not match the LDAP base of the UCS domain (%s)."
msgstr "授權的 LDAP base 與 UCS 網域的 LDAP base 不符 (%s)。"

#: umc/python/udm/__init__.py:380
msgid "The destination is missing"
msgstr "缺少目的地"

#: umc/python/udm/udm_ldap.py:255
msgid "The following steps can help to solve this problem:"
msgstr "下列步驟有助於解決此問題:"

#: umc/python/udm/tools.py:67
#, python-format
msgid "The license can not be applied. The LDAP base does not match (expected %(expected)s, found: %(found)s)."
msgstr "無法套用授權。LDAP base 不符 (預期 %(expected)s,實際: %(found)s)。"

#: umc/python/udm/udm_ldap.py:490 umc/python/udm/udm_ldap.py:504
#, python-format
msgid "The property %(property)s has an invalid value: %(value)s"
msgstr "屬性 %(property)s 的值無效: %(value)s"

#: umc/python/udm/udm_ldap.py:330
msgid "The query you have entered timed out. Please narrow down your search by specifying more query parameters"
msgstr "您輸入的查詢已逾時。請指定更多查詢參數以縮小搜尋範圍"

#: umc/python/udm/udm_ldap.py:336
#, python-format
msgid "The query you have entered yields too many matching entries. Please narrow down your search by specifying more query parameters. The current size limit of %s can be configured with the UCR variable directory/manager/web/sizelimit."
msgstr "您輸入的查詢符合的項目過多。請指定更多查詢參數以縮小搜尋範圍。目前的數量上限為 %s,可透過 UCR 變數 directory/manager/web/sizelimit 設定。"

#: umc/python/udm/__init__.py:718
msgid "The report does not exists. Please create a new one."
msgstr "報表不存在。請建立一個新的報表。"

#: umc/python/udm/udm_ldap.py:951
msgid "The unique LDAP path of this object, indicating where it is located in the directory structure."
msgstr "此物件唯一的 LDAP 路徑，指出它在目錄結構中的位置。"

#: umc/python/udm/__init__.py:1365
#, python-format
msgid "This is probably due to the DNS settings of your server. You may find help at %s."
msgstr "這可能是您伺服器的 DNS 設定所造成。您可以在 %s 取得協助。"

#: umc/python/udm/__init__.py:1362
#, python-format
msgid "This may be a problem with the proxy of your system. You may find help at %s."
msgstr "這可能是您系統的 proxy 問題。您可以在 %s 取得協助。"

#: umc/python/udm/__init__.py:386
msgid "This object can not be moved"
msgstr "此物件無法移動"

#: umc/python/udm/__init__.py:1353
msgid "This seems to be a problem with the license server. Please try again later."
msgstr "這似乎是授權伺服器的問題。請稍後再試。"

#: umc/python/udm/tools.py:148
msgid "You have too many DVS client accounts for your license. During this session add and modify are disabled."
msgstr "您的 DVS 用戶端帳號數量超過授權允許的上限。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:146
msgid "You have too many DVS user accounts for your license. During this session add and modify are disabled."
msgstr "您的 DVS 使用者帳號數量超過授權允許的上限。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:134
msgid "You have too many client accounts for your license. During this session add and modify are disabled."
msgstr "您的用戶端帳號數量超過授權允許的上限。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:140
msgid "You have too many corporate client accounts for your license. During this session add and modify are disabled."
msgstr "您的企業用戶端帳號數量超過授權允許的上限。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:142
msgid "You have too many desktop accounts for your license. During this session add and modify are disabled."
msgstr "您的桌面帳號數量超過授權允許的上限。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:144
msgid "You have too many groupware accounts for your license. During this session add and modify are disabled."
msgstr "您的群組軟體帳號數量超過授權允許的上限。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:138
msgid "You have too many managed client accounts for your license. During this session add and modify are disabled."
msgstr "您的受管用戶端帳號數量超過授權允許的上限。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:136
msgid "You have too many server accounts for your license. During this session add and modify are disabled."
msgstr "您的伺服器帳號數量超過授權允許的上限。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:132
msgid "You have too many user accounts for your license. Add and modify are disabled. Disable or delete <a href=\"javascript:void(0)\" onclick=\"require('umc/app').openModule('udm', 'users/user', {})\"> user accounts</a> to re-enable editing."
msgstr "您的使用者帳號數量超過授權允許的上限。新增與修改功能已停用。請停用或刪除 <a href=\"javascript:void(0)\" onclick=\"require('umc/app').openModule('udm', 'users/user', {})\"> 使用者帳號</a> 以重新啟用編輯。"

#: umc/python/udm/tools.py:156
msgid "Your license does not allow modifications. During this session add and modify are disabled."
msgstr "您的授權不允許修改。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:150
msgid "Your license is expired. During this session add and modify are disabled."
msgstr "您的授權已過期。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:152
msgid "Your license is not valid for your LDAP-Base. During this session add and modify are disabled."
msgstr "您的授權對您的 LDAP-Base 無效。在此工作階段中，新增與修改功能已停用。"

#: umc/python/udm/tools.py:154
msgid "Your license is not valid. During this session add and modify are disabled."
msgstr "您的授權無效。在此工作階段中，新增與修改功能已停用。"

