#: modules/univention/admin/handlers/__init__.py:1032
#, python-format
msgid "Cannot restore object to %s: Parent container %s does not exist."
msgstr "無法將物件還原至 %s: 上層容器 %s 不存在。"

#: modules/univention/admin/handlers/__init__.py:292
msgid "Change Sequence Number (CSN)"
msgstr "變更序號 (CSN)"

#: modules/univention/admin/handlers/__init__.py:288
msgid "Created"
msgstr "建立時間"

#: modules/univention/admin/handlers/__init__.py:287
msgid "Created By"
msgstr "建立者"

#: modules/univention/admin/handlers/__init__.py:3082
msgid "DNS alias is already in use."
msgstr "DNS 別名已被使用。"

#: modules/univention/admin/handlers/__init__.py:845
msgid "Destination object can't have sub objects."
msgstr "目的地物件不可有子物件。"

#: modules/univention/admin/handlers/__init__.py:287
msgid "Distinguished Name (DN) of the user or system that created this entry."
msgstr "建立此項目的使用者或系統的辨別名稱 (DN)。"

#: modules/univention/admin/handlers/__init__.py:289
msgid "Distinguished Name (DN) of the user or system that last modified this entry."
msgstr "最後修改此項目的使用者或系統的辨別名稱 (DN)。"

#: modules/univention/admin/handlers/__init__.py:291
msgid "Entry UUID"
msgstr "項目 UUID"

#: modules/univention/admin/handlers/__init__.py:291
msgid "Globally unique identifier (entryUUID) for this LDAP object. Assigned by the directory server and does not change."
msgstr "此 LDAP 物件的全域唯一識別碼 (entryUUID)。由目錄伺服器指派，不會變更。"

#: modules/univention/admin/handlers/__init__.py:272
msgid "Immutable attribute univentionObjectIdentifier to track the identity of an object in UDM"
msgstr "用於在 UDM 中追蹤物件身分的不可變屬性 univentionObjectIdentifier"

#: modules/univention/admin/handlers/__init__.py:292
msgid "Internal change identifier used for replication. Increases with each modification and helps synchronize directory servers."
msgstr "用於複寫的內部變更識別碼。每次修改時遞增，有助於同步目錄伺服器。"

#: modules/univention/admin/handlers/__init__.py:290
msgid "Last Modified"
msgstr "最後修改時間"

#: modules/univention/admin/handlers/__init__.py:289
msgid "Last Modified By"
msgstr "最後修改者"

#: modules/univention/admin/handlers/__init__.py:858
msgid "Moving into one's own sub container not allowed."
msgstr "不允許移入自己的子容器。"

#: modules/univention/admin/handlers/__init__.py:849
msgid "Moving not possible: old and new DN are identical."
msgstr "無法移動: 新舊 DN 相同。"

#: modules/univention/admin/handlers/__init__.py:1265
msgid "Neither DN nor position given."
msgstr "未提供 DN 或位置。"

#: modules/univention/admin/handlers/__init__.py:1276
msgid "No superordinate object given"
msgstr "未提供上層物件"

#: modules/univention/admin/handlers/__init__.py:831
msgid "Objects from Active Directory can not be moved."
msgstr "來自 Active Directory 的物件無法移動。"

#: modules/univention/admin/handlers/__init__.py:1808
msgid "Objects from Active Directory can not be removed."
msgstr "來自 Active Directory 的物件無法移除。"

#: modules/univention/admin/handlers/__init__.py:644
#, python-format
msgid "Objects of the \"%s\" object type can not be created."
msgstr "無法建立 \"%s\" 物件類型的物件。"

#: modules/univention/admin/handlers/__init__.py:738
#, python-format
msgid "Objects of the \"%s\" object type can not be modified."
msgstr "無法修改 \"%s\" 物件類型的物件。"

#: modules/univention/admin/handlers/__init__.py:815
#, python-format
msgid "Objects of the \"%s\" object type can not be moved."
msgstr "無法移動 \"%s\" 物件類型的物件。"

#: modules/univention/admin/handlers/__init__.py:1107
#, python-format
msgid "Objects of the \"%s\" object type can not be removed."
msgstr "無法移除 \"%s\" 物件類型的物件。"

#: modules/univention/admin/handlers/__init__.py:998
#, python-format
msgid "Objects of the \"%s\" object type can not be restored."
msgstr "無法還原 \"%s\" 物件類型的物件。"

#: modules/univention/admin/handlers/__init__.py:1048
msgid "Restore not allowed on this machine."
msgstr "此機器不允許還原。"

#: modules/univention/admin/handlers/__init__.py:2800
msgid "Reverse zone and IP address are incompatible."
msgstr "反向區域與 IP 位址不相容。"

#: modules/univention/admin/handlers/__init__.py:313
msgid "Technical information"
msgstr "技術資訊"

#: modules/univention/admin/handlers/__init__.py:3398
msgid "The DHCP entry for this host should contain the zone LDAP-DN, the IP address and the MAC address."
msgstr "此主機的 DHCP 項目應包含區域 LDAP-DN、IP 位址與 MAC 位址。"

#: modules/univention/admin/handlers/__init__.py:1285
msgid "The DN must be underneath of the superordinate."
msgstr "DN 必須位於上層物件之下。"

#: modules/univention/admin/handlers/__init__.py:3432
msgid "The DNS alias entry for this host should contain the zone name, the alias zone container LDAP-DN and the alias."
msgstr "此主機的 DNS 別名項目應包含區域名稱、別名區域容器 LDAP-DN 與別名。"

#: modules/univention/admin/handlers/__init__.py:439
#, python-format
msgid ""
"The following properties are missing:\n"
"%s"
msgstr ""
"缺少下列屬性:\n"
"%s"

#: modules/univention/admin/handlers/__init__.py:1281
#, python-format
msgid "The given %r superordinate is expected to be of type %s."
msgstr "指定的上層物件 %r 應為 %s 類型。"

#: modules/univention/admin/handlers/__init__.py:822 modules/univention/admin/handlers/__init__.py:825
msgid "The own object cannot be moved."
msgstr "物件本身無法移動。"

#: modules/univention/admin/handlers/__init__.py:1116 modules/univention/admin/handlers/__init__.py:1119
msgid "The own object cannot be removed."
msgstr "物件本身無法移除。"

#: modules/univention/admin/handlers/__init__.py:443
msgid "The position must be in the subtree of the superordinate."
msgstr "位置必須在上層物件的子樹中。"

#: modules/univention/admin/handlers/__init__.py:498
#, python-format
msgid "The property %s is required"
msgstr "屬性 %s 為必填"

#: modules/univention/admin/handlers/__init__.py:512
#, python-format
msgid "The property %s must be a list"
msgstr "屬性 %s 必須是清單"

#: modules/univention/admin/handlers/__init__.py:290
msgid "Timestamp in UTC of the most recent change to this entry, maintained automatically by the directory server."
msgstr "此項目最近一次變更的 UTC 時間戳記，由目錄伺服器自動維護。"

#: modules/univention/admin/handlers/__init__.py:288
msgid "Timestamp in UTC when this entry was originally created, set automatically by the directory server."
msgstr "此項目最初建立的 UTC 時間戳記，由目錄伺服器自動設定。"

#: modules/univention/admin/handlers/__init__.py:901 modules/univention/admin/handlers/__init__.py:968
#, python-format
msgid "Unable to move object %(name)s (%(type)s) in subtree, trying to revert changes."
msgstr "無法在子樹中移動物件 %(name)s (%(type)s),正在嘗試還原變更。"

#: modules/univention/admin/handlers/__init__.py:271
msgid "Univention Object Identifier"
msgstr "Univention 物件識別碼"

#: modules/univention/admin/handlers/__init__.py:495 modules/univention/admin/handlers/__init__.py:2031
#, python-format
msgid "key=%(key)s old=%(old)s new=%(new)s"
msgstr "key=%(key)s old=%(old)s new=%(new)s"
