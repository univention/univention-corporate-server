#: modules/univention/admin/handlers/dhcp/pool.py:28
msgid "A pool of dynamic addresses assignable to hosts."
msgstr "可指派給主機的動態位址集區。"

#: modules/univention/admin/handlers/dhcp/shared.py:24
msgid "A shared physical network, where multiple IP address ranges are used."
msgstr "使用多個 IP 位址範圍的共用實體網路。"

#: modules/univention/admin/handlers/dhcp/host.py:37
msgid "A unique name for this DHCP host entry. Using the hostname is recommended."
msgstr "此 DHCP 主機項目的唯一名稱。建議使用主機名稱。"

#: modules/univention/admin/handlers/dhcp/pool.py:40
msgid "A unique name for this DHCP pool object."
msgstr "此 DHCP 集區物件的唯一名稱。"

#: modules/univention/admin/handlers/dhcp/service.py:38
msgid "A unique name for this DHCP service."
msgstr "此 DHCP 服務的唯一名稱。"

#: modules/univention/admin/handlers/dhcp/shared.py:36
msgid "A unique name for this shared network."
msgstr "此共用網路的唯一名稱。"

#: modules/univention/admin/handlers/dhcp/__common.py:31
msgid "Additional options for DHCP"
msgstr "DHCP 的其他選項"

#: modules/univention/admin/handlers/dhcp/__common.py:38
msgid "Additional statements for DHCP"
msgstr "DHCP 的其他陳述式"

#: modules/univention/admin/handlers/dhcp/subnet.py:47 modules/univention/admin/handlers/dhcp/sharedsubnet.py:44
msgid "Address prefix length (or Netmask)"
msgstr "位址前置長度 (或網路遮罩)"

#: modules/univention/admin/handlers/dhcp/pool.py:71
msgid "Addresses from this pool are given to clients using the old BOOTP protocol, which has no mechanism to free addresses again."
msgstr "此集區的位址會配給使用舊版 BOOTP 協定的用戶端，該協定沒有再次釋放位址的機制。"

#: modules/univention/admin/handlers/dhcp/pool.py:61
msgid "Addresses from this pool are given to clients which have a DHCP host entry matching their MAC address, but with no IP address assigned."
msgstr "此集區的位址會配給有符合其 MAC 位址的 DHCP 主機項目、但未指派 IP 位址的用戶端。"

#: modules/univention/admin/handlers/dhcp/pool.py:66
msgid "Addresses from this pool are given to clients, which do not have a DHCP host entry matching their MAC address."
msgstr "此集區的位址會配給沒有符合其 MAC 位址之 DHCP 主機項目的用戶端。"

#: modules/univention/admin/handlers/dhcp/pool.py:88
msgid "Advanced"
msgstr "進階"

#: modules/univention/admin/handlers/dhcp/pool.py:88
msgid "Advanced DHCP pool options"
msgstr "進階 DHCP 集區選項"

