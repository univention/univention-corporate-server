#: umc/js/diagnostic.js:100
msgid "\"%(module)s - %(flavor)s\" Module (as Administrator)"
msgstr "\"%(module)s - %(flavor)s\" 模組 (以管理員身分)"

#: umc/js/diagnostic.js:201
msgid "Analyzing for problems..."
msgstr "正在分析問題..."

#: umc/js/diagnostic.js:38
msgid "Conflict: "
msgstr "衝突: "

#: umc/js/diagnostic.js:37
msgid "Critical: "
msgstr "嚴重: "

#: umc/js/diagnostic.js:275
#, javascript-format
msgid "Diagnosis of \"%s\" was successful"
msgstr "\"%s\" 的診斷成功"

#: umc/js/diagnostic.js:178
msgid "If the system is able to automatically repair found problems it offers the function as additional buttons. "
msgstr "如果系統能夠自動修復找到的問題，則會以額外按鈕的形式提供該功能。 "

#: umc/js/diagnostic.js:200 umc/js/diagnostic.js:310
msgid "No problems could be detected."
msgstr "未偵測到任何問題。"

#: umc/js/diagnostic.js:179
msgid "Otherwise the problems can be solved manually with help of the displayed links to articles by using the linked UMC modules. "
msgstr "否則可以透過所顯示的文章連結，使用連結的 UMC 模組手動解決這些問題。 "

#: umc/js/diagnostic.js:40
msgid "Problem repaired: "
msgstr "問題已修復: "

#: umc/js/diagnostic.js:42
msgid "Problem: "
msgstr "問題: "

#: umc/js/diagnostic.js:182
msgid "Run system diagnosis"
msgstr "執行系統診斷"

#: umc/js/diagnostic.js:262
msgid "Running full diagnosis..."
msgstr "正在執行完整診斷..."

#: umc/js/diagnostic.js:41
msgid "Success: "
msgstr "成功: "

#: umc/js/diagnostic.js:39
msgid "Warning: "
msgstr "警告: "

#: umc/js/diagnostic.js:177
msgid "Within this module the system can be analyzed for various known problems. "
msgstr "在此模組中，可以針對各種已知問題分析系統。 "
