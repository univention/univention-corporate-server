set -e -u

out="$(ucr filter <conffiles/etc/rsyslog.conf)"
for typ in udp tcp relp
do
	echo "$out" | grep -Eq "^#?input\(type=\"im${typ}\" " || { echo "missing input(type=\"im${typ}\")" >&2; exit 1; }
done
