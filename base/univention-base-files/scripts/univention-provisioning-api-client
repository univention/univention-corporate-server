#!/usr/bin/python3
#
# SPDX-FileCopyrightText: 2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only
#
# Quick QA on Primary Directory Node:
# # python3 provisioning_api_client.py subscribe --topics '[{"realm": "udm", "topic": "users/user"}]' --subscription-file /tmp/sub.1 --force --request-prefill --provisioning-server $(hostname -f)
# # python3 provisioning_api_client.py unsubscribe --subscription-file /tmp/sub.1 --provisioning-server $(hostname -f)
#
import argparse
import json
import os
import secrets
import socket
import sys
import uuid
from typing import TypedDict

import requests


FN_PROVISIONING_API_ADMIN_CREDENTIALS = "/etc/provisioning-secrets.json"


class ProvisioningAPIError(Exception):
    pass


class AdminCredentialError(ProvisioningAPIError):
    pass


class SubscriptionFileError(ProvisioningAPIError):
    pass


class ProvisioningAPIConnectionError(ProvisioningAPIError):
    pass


class ProvisioningAPIResponseError(ProvisioningAPIError):
    pass


class RealmTopic(TypedDict):
    realm: str
    topic: str


class ProvisioningConsumerSubscriber:
    def __init__(
            self,
            admin_credential_file: str,
            subscription_file: str | None,
            subscription_name: str | None,
            provisioning_server: str | None,
    ):
        """
        ProvisioningConsumerSubscriber

        :param admin_credential_file: Path to the admin credential file for the
            Provisioning API. If None, the default path is used.
            The expected format of this JSON file is:
            {
               "PROVISIONING_API_ADMIN_PASSWORD": "<password>",
               ...
            }
        :param subscription_name: A unique name for the subscription within the
            server. If None, a random UUID-based name is generated automatically
            in the format 'sub-<uuid>'.
        """
        self.admin_credential_file: str = admin_credential_file
        self.subscription_file: str | None = subscription_file
        self.subscription_password: str | None = None
        if subscription_file is not None and os.path.isfile(subscription_file):
            name, self.subscription_password = self._get_subscription_credentials()
            if subscription_name is None:
                subscription_name = name

        self.subscription_name: str | None = subscription_name
        self.provisioning_server = provisioning_server
        self.admin_username, self.admin_password = self._get_admin_credentials()

    # the following log methods do not use loguru on purpose to keep this script lightweight
    # TODO: switch to logging
    def _error(self, msg: str) -> None:
        print(f"ERROR: {msg}", file=sys.stderr)

    def _warning(self, msg: str) -> None:
        print(f"WARNING: {msg}", file=sys.stderr)

    def _info(self, msg: str) -> None:
        print(msg)

    def _get_admin_credentials(self) -> tuple[str | None, str | None]:
        """Retrieves the credentials for the Provisioning API from the configured JSON file."""
        try:
            with open(self.admin_credential_file) as fd:
                password = json.load(fd).get("PROVISIONING_API_ADMIN_PASSWORD")
        except (OSError, json.decoder.JSONDecodeError) as exc:
            raise AdminCredentialError(f"Failed to fetch Provisioning API admin credentials from {self.admin_credential_file!r}: {exc}") from exc
        if password is None:
            self._warning(f"PROVISIONING_API_ADMIN_PASSWORD could not be read from {self.admin_credential_file!r}")
        return "admin", password

    def _get_subscription_credentials(self) -> tuple[str | None, str | None]:
        """
        Get subscription credentials from configuration file.
        :returns: (name, password)
            name and password are None if configuration file could
            not be found or values are unset.
        """
        if self.subscription_file is not None and os.path.isfile(self.subscription_file):
            try:
                with open(self.subscription_file) as fd:
                    data = json.load(fd)
                    if "subscription_name" in data and "subscription_password" in data:
                        self._info(f"Successfully read the configuration file {self.subscription_file!r}")
                        return data["subscription_name"], data["subscription_password"]
                    self._warning(
                        f"Read the configuration file {self.subscription_file!r} but no "
                        "'subscription_name' or 'subscription_password' was found",
                    )
            except (OSError, json.decoder.JSONDecodeError) as exc:
                raise SubscriptionFileError(f"Failed to fetch data from {self.subscription_file!r}: {exc}") from exc
        else:
            # When creating a new subscription file, it is intended to create a new one.
            # The following message might confuse devs and admins and is therefore deactivated:
            # self._info(f"No configuration file {self.subscription_file!r} found")
            pass
        return None, None

    def _save_subscription_credentials(self, subscription_name: str, subscription_password: str) -> None:
        """Save given subscription name and password to configuration file."""
        if self.subscription_file is None:
            # TODO: FIXME: self.log.error("Cannot save credentials to subscription file! Subscription file has not been specified!")
            return
        data = {
            "subscription_name": subscription_name,
            "subscription_password": subscription_password,
        }
        try:
            fn_new = f"{self.subscription_file}.new"
            fd = os.open(fn_new, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                json.dump(data, f, indent=2)
            os.rename(fn_new, self.subscription_file)
        except OSError as exc:
            raise SubscriptionFileError(f"Failed to write data to {self.subscription_file!r}: {exc}") from exc

    def subscription_exists(self) -> bool:
        """Check if there is already a valid subscription."""
        if not self.subscription_name:
            # self._info(f"No subscription_name found in subscription_file {self.subscription_file!r}")
            return False

        url = f"https://{self.provisioning_server}/univention/provisioning/v1/subscriptions/{self.subscription_name}"
        try:
            resp = requests.get(
                url,
                auth=(self.subscription_name, self.subscription_password),
            )
        except requests.exceptions.ConnectionError as exc:
            raise ProvisioningAPIConnectionError(f"Request to {url} failed: {exc}") from exc
        if resp.status_code in (404, ):
            return False
        if resp.status_code in (401, ):
            self._warning(f"Failed to query status of subscription {self.subscription_name} due to incorrect/outdated credentials: [{resp.status_code}] {resp.text}")
            # assuming the subscription does not exist: after the subscription has been removed, a status query returns 401/incorrect credentials
            return False
        if 200 <= resp.status_code <= 299:
            return True
        raise ProvisioningAPIResponseError(f"Failed to query status of subscription {self.subscription_name}: [{resp.status_code}] {resp.text}")

    def unsubscribe(self) -> None:
        """Removes an existing subscription."""
        if not self.subscription_name:
            self._error(f"Unsubscribe request failed. No subscription_name found in subscription_file {self.subscription_file}")
            return

        url = f"https://{self.provisioning_server}/univention/provisioning/v1/subscriptions/{self.subscription_name}"
        try:
            resp = requests.delete(
                url,
                auth=(self.admin_username, self.admin_password),
            )
        except requests.exceptions.ConnectionError as exc:
            raise ProvisioningAPIConnectionError(f"Request to {url} failed: {exc}") from exc
        if resp.status_code == 404:
            self._warning(f"Request to remove subscription has been skipped. The subscription {self.subscription_name} does not exist.")
            return
        elif resp.status_code >= 300:
            raise ProvisioningAPIResponseError(f"Unsubscribe request at {url} failed with error code {resp.status_code}: {resp.text}")
        self._info(f"Subscription {self.subscription_name} has been removed successfully.")

    def subscribe(
            self,
            realms_topics: list[RealmTopic],
            request_prefill: bool = False,
    ) -> None:
        """
        Creates a new subscription for the specified realms and topics.

        Registers the subscription with the Provisioning API using admin
        credentials. If existing credentials are found in the configuration
        file, they are reused; otherwise, new credentials are generated and
        saved for future use.

        Example usage:
            realms_topics = [
                {"realm": "udm", "topic": "users/user"},
                {"realm": "udm", "topic": "groups/group"},
                ...
            ]
            subscriber.subscribe(realms_topics, request_prefill=True)

        :param realms_topics: A list of realm/topic pairs to subscribe to.
            Each entry must be a dict with the keys:
            - ``realm`` (str): The realm name (e.g., ``"udm"``).
            - ``topic`` (str): The topic name (e.g., ``"users/user"``).
        :param request_prefill: If True, the subscription queue will be pre-filled
            with existing data upon initial registration. Defaults to False.

        """
        if not self.subscription_name:
            self.subscription_name = f"sub-{uuid.uuid4()!s}"
        if not self.subscription_password:
            self.subscription_password = secrets.token_urlsafe(32)

        # save new credentials first - better to have credentials without subscription
        # than the other way around.
        self._save_subscription_credentials(
            self.subscription_name,
            self.subscription_password,
        )

        create_sub_json = {
            "name": self.subscription_name,
            "realms_topics": realms_topics,
            "request_prefill": request_prefill,
            "password": self.subscription_password,
        }
        url = f"https://{self.provisioning_server}/univention/provisioning/v1/subscriptions"
        try:
            resp = requests.post(
                url,
                json=create_sub_json,
                auth=(self.admin_username, self.admin_password),
            )
        except requests.exceptions.ConnectionError as exc:
            raise ProvisioningAPIConnectionError(f"Request to {url} failed: {exc}") from exc
        if resp.status_code >= 300:
            raise ProvisioningAPIResponseError(f"Subscription request at {url} failed with error code {resp.status_code}: {resp.text}")
        self._info(f"Subscription {self.subscription_name} {'with' if request_prefill else 'without'} prefill request has been created successfully.")


def is_valid_realms_and_topics_data(data_str: str) -> bool:
    """Checks if user specified string matches the JSON scheme for topics and realms."""
    try:
        data = json.loads(data_str)
    except json.decoder.JSONDecodeError:
        return False
    return (
        isinstance(data, list)
        and all(isinstance(item, dict) for item in data)
        and all(isinstance(item.get("realm"), str) and isinstance(item.get("topic"), str) for item in data)
    )


def main():
    parser = argparse.ArgumentParser(
        prog="provisioning_api_client",
        description="Manage provisioning API subscriptions",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    HOSTNAME = socket.getfqdn()

    # --- subscribe ---
    subscribe_parser = subparsers.add_parser("subscribe", help="Create or renew a subscription")
    subscribe_parser.add_argument("--subscription-name", help="Name of the subscription. If no name is specified, the name from the subscription file is used. If that file does not yet exist, a random name is automatically generated (sub-$UUID).", default=None)
    subscribe_parser.add_argument(
        "--topics",
        required=True,
        help="""JSON array of realm/topic objects, e.g. '[{"realm": "udm", "topic": "users/user"}, ...]'""",
    )
    subscribe_parser.add_argument(
        "--subscription-file",
        required=True,
        help="Path to the file where subscription credentials are written to",
    )
    subscribe_parser.add_argument("--force", action="store_true", help="Overwrite/recreate an existing subscription")
    subscribe_parser.add_argument("--request-prefill", action="store_true", help="Request a (new) prefill for this subscription queue")
    subscribe_parser.add_argument("--admin-credential-file", help="Path to the admin credential file of the Provisioning API (default: %(default)s)", default=FN_PROVISIONING_API_ADMIN_CREDENTIALS)
    subscribe_parser.add_argument("--provisioning-server", default=HOSTNAME, help="FQDN of the Provisioning API server (uses '%(default)s' if not specified)")

    # --- unsubscribe ---
    unsubscribe_parser = subparsers.add_parser("unsubscribe", help="Remove a subscription")
    unsubscribe_parser.add_argument("--subscription-file", required=True, help="Path to the subscription credential file")
    unsubscribe_parser.add_argument("--admin-credential-file", help="Path to the admin credential file of the Provisioning API (default: %(default)s)", default=FN_PROVISIONING_API_ADMIN_CREDENTIALS)
    unsubscribe_parser.add_argument("--provisioning-server", default=HOSTNAME, help="FQDN of the Provisioning API server (uses '%(default)s' if not specified)")

    args = parser.parse_args()

    if not os.path.isfile(args.admin_credential_file):
        print(f"ERROR: --admin-credential-file: The file {args.admin_credential_file!r} does not exist!")
        sys.exit(1)

    if args.command == "subscribe":
        if not is_valid_realms_and_topics_data(args.topics):
            print("ERROR: --topics: the given JSON string is not a valid definition of realms and topics!")
            sys.exit(1)
        topics = json.loads(args.topics)

    elif args.command == "unsubscribe":
        args.subscription_name = None
        if not os.path.isfile(args.subscription_file):
            print(f"ERROR: --subscription-file: The file {args.subscription_file!r} does not exist!")
            sys.exit(1)

    try:
        client = ProvisioningConsumerSubscriber(
            args.admin_credential_file,
            args.subscription_file,
            args.subscription_name,
            args.provisioning_server,
        )
        if args.command == "subscribe":
            if client.subscription_exists():
                if args.force:
                    client.unsubscribe()
                else:
                    print("ERROR: Subscription exists! Stopping here!", file=sys.stderr)
                    sys.exit(1)
            client.subscribe(topics, args.request_prefill)
        elif args.command == "unsubscribe":
            client.unsubscribe()
    except ProvisioningAPIError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
