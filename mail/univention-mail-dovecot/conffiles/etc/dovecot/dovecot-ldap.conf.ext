@%@UCRWARNING=# @%@

# Authentication for LDAP users. Included from auth.conf.
#
# <https://doc.dovecot.org/latest/core/config/auth/databases/ldap.html>

## See <https://doc.dovecot.org/latest/core/config/dict.html#ldap>

#ldap_uris = ldap://localhost
#ldap_auth_dn = cn=admin
#ldap_auth_dn_password = supersecret

# Space separated list of LDAP URIs to use.
@!@
import os
from univention.lib.misc import getLDAPURIs

print('ldap_uris = %s' % getLDAPURIs(configRegistry))
print('ldap_auth_dn = %s' % configRegistry.get('ldap/hostdn'))
if os.path.exists('/etc/machine.secret'):
    print('ldap_auth_dn_password = %s' % (open('/etc/machine.secret').read()))
else:
    print('ldap_auth_dn_password = MACHINE.SECRET_IS_MISSING')
@!@

# Use SASL binding instead of simple binding.
#ldap_auth_sasl_mechanisms =
#ldap_auth_sasl_realm =
#ldap_auth_sasl_authz_id =

# Use STARTTLS to connect to the LDAP server.
ldap_starttls = yes

# TLS options used by LDAP client connections.
@!@
print("ssl_client_ca_file = %s" % configRegistry.get('mail/dovecot/auth/ldap/cafile', '/etc/univention/ssl/ucsCA/CAcert.pem'))
@!@
#ssl_client_ca_dir =
#ssl_cipher_list =
#ssl_client_cert_file =
#ssl_client_key_file =
ssl_client_require_valid_cert = yes

# LDAP library debug level as specified by LDAP_DEBUG_* in ldap_log.h.
# -1 = everything. You may need to recompile OpenLDAP with debugging enabled
# to get enough output.
@!@
print("ldap_debug_level = %s" % configRegistry.get("mail/dovecot/logging/ldap_debug_level", "0"))
@!@

# LDAP protocol version to use. Likely 2 or 3.
ldap_version = 3

# LDAP base. Dovecot 2.4 variables can be used here.
ldap_base = @%@ldap/base@%@

# Dereference: never, searching, finding, always
#ldap_deref = never

# Search scope: base, onelevel, subtree
ldap_scope = subtree

#passdb ldap {
#  filter = (&(objectClass=posixAccount)(uid=%{user}))
#  bind = no
#
#  fields {
    # user=%{ldap:uid}
    # password=%{ldap:userPassword}
    # userdb_home=%{ldap:homeDirectory}
    # userdb_uid=%{ldap:uidNumber}
    # userdb_gid=%{ldap:gidNumber}
#  }
#}

# "prefetch" user database means that the passdb already provided the
# needed information and there's no need to do a separate userdb lookup.
# <https://doc.dovecot.org/latest/core/config/auth/databases/prefetch.html>
#userdb prefetch {
#}

#userdb ldap {
#  filter = (&(objectClass=posixAccount)(uid=%{user}))
#
# Default fields can be used to specify defaults that LDAP may override
#  fields {
#    home=/home/virtual/%{user}
#  }
#}

userdb ldap {
  fields {
@!@
default_user_attrs = [
    ('user', '%{ldap:mailPrimaryAddress}'),
    ('uid', 'dovemail'),
    ('gid', 'dovemail'),
    ('system_groups_user', '%{ldap:uid}'),
    ('quota_rule', '*:bytes=%{ldap:univentionMailUserQuota}M'),
]
additional_user_attrs = configRegistry.get("mail/dovecot/auth/ldap/user/attributes", "")
for key, value in default_user_attrs:
    print("    %s = %s" % (key, value))
if additional_user_attrs:
    # Compatibility helper for UCS-local custom additions that still use the
    # old user_attrs mini-language:
    #   ldapAttr=dovecotField
    #   =dovecotField=value
    #   ldapAttr=dovecotField=prefix%$suffix
    #
    # Dovecot 2.4 fields are:
    #   dovecotField = %{ldap:ldapAttr}
    #   dovecotField = static-value
    #
    # This supports comma-separated additions unless a comma is intentionally
    # part of a custom value.
    for item in [part.strip() for part in additional_user_attrs.split(",") if part.strip()]:
        if item.startswith("="):
            # =field=value
            try:
                field, value = item[1:].split("=", 1)
            except ValueError:
                print("    # FIXME: could not convert old user_attrs item: %s" % item)
            else:
                print("    %s = %s" % (field, value))
            continue

        try:
            ldap_attr, rest = item.split("=", 1)
        except ValueError:
            print("    # FIXME: could not convert old user_attrs item: %s" % item)
            continue

        if "=" in rest:
            # ldapAttr=field=template-with-%$
            field, template = rest.split("=", 1)
            value = template.replace("%$", "%%{ldap:%s}" % ldap_attr)
        else:
            field = rest
            value = "%%{ldap:%s}" % ldap_attr

        print("    %s = %s" % (field, value))
@!@
  }

@!@
from ldap.filter import escape_filter_chars
from univention.lib.misc import custom_username
default_user_filter_objectclasses = ["univentionMail", "univentionMailSharedFolder"]
additional_user_filter_objectclasses = configRegistry.get("mail/dovecot/auth/ldap/user/objectclasses", "")
additional_user_filter_objectclasses = additional_user_filter_objectclasses.split(",")
if additional_user_filter_objectclasses[0]:
    default_user_filter_objectclasses.extend(additional_user_filter_objectclasses)
# Meaning of / reason for (|(mailPrimaryAddress=%{user})(...). A user logging
# in must either use an email address or use a username but must then have an
# email address - except for the Administrator user, which can login without an
# email address for doveadm ACL handling.
print('  filter = (&(|%(ocs)s)(|(!(univentionMailHomeServer=*))(univentionMailHomeServer=%(hostname)s.%(domainname)s))(|(mailPrimaryAddress=%%{user})(&(uid=%%{user | username})(|(mailPrimaryAddress=*)(uid=%(admin_user)s)))))' % {
    "ocs": "".join(["(objectClass=%s)" % obj for obj in default_user_filter_objectclasses]),
    "hostname": configRegistry.get("hostname"),
    "domainname": configRegistry.get("domainname"),
    "admin_user": escape_filter_chars(custom_username("Administrator")),
})
@!@

  iterate_fields {
    user = %{ldap:mailPrimaryAddress}
  }
  iterate_filter = (&(objectClass=univentionMail)(|(!(univentionMailHomeServer=*))(univentionMailHomeServer=@%@hostname@%@.@%@domainname@%@))(mailPrimaryAddress=*))
}

# If you don't have any user-specific settings, you can avoid the userdb LDAP
# lookup by using userdb static instead of userdb ldap, for example:
# <https://doc.dovecot.org/latest/core/config/auth/databases/static.html>
#userdb static {
  #fields {
  #  uid = vmail
  #  gid = vmail
  #  home = /var/vmail/%{user}
  #}
#}
