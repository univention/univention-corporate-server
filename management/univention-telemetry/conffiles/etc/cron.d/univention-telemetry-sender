@%@UCRWARNING=# @%@

PATH=/usr/sbin:/usr/bin:/sbin:/bin

@!@
if configRegistry.is_true('telemetry/enabled', False) and configRegistry.get('server/role') == 'domaincontroller_master':
    script = "/usr/share/univention-telemetry/univention-telemetry-sender"
    interval = configRegistry.get("telemetry/cron", "0 2 * * *")
    logfile = '/var/log/univention/telemetry-sender.log'
    if interval:
        print("%s       root    [ -x %s ] && umask 026 && %s >> %s 2>&1" % (interval, script, script, logfile))
@!@
