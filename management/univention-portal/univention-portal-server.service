[Unit]
Description=Univention Portal server
After=apache2.service

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
EnvironmentFile=/etc/univention-portal/server.env
ExecStart=docker-compose -f /usr/share/univention-portal/docker-compose.yaml -p univention-portal up --no-build --no-recreate
ExecStop=docker-compose down -p univention-portal
Restart=on-failure
