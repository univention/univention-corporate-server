#
# The portal CLI ships inside the portal server image. This wrapper keeps
# /usr/sbin/univention-portal available on the host so that the listener
# modules and the maintainer scripts do not have to know about containers.

set -e

CONTAINER="univention-portal-server"

if ! docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -qx true
then
	echo "univention-portal: $CONTAINER is not running, skipping: $*" >&2
	exit 0
fi

exec docker exec "$CONTAINER" /app/univention-portal "$@"
