[Unit]
Description=Univention Directory Policy
After=network-online.target remote-fs.target slapd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/share/univention-directory-policy/univention-directory-policy
TimeoutStartSec=3600
StandardOutput=append:/var/log/univention/ldap-policy.log
StandardError=append:/var/log/univention/ldap-policy.log

[Install]
WantedBy=multi-user.target
