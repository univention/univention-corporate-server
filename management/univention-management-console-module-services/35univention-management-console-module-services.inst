## joinscript api: bindpwdfile

VERSION=2

. /usr/share/univention-join/joinscripthelper.lib
. /usr/share/univention-lib/umc.sh

joinscript_init

umc_init
umc_operation_create "services-all" "System services" "" "services/*"
umc_policy_append "default-umc-all" "services-all"

joinscript_save_current_version

exit 0


