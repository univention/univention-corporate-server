export PYBUILD_SYSTEM=pyproject
export SETUPTOOLS_SCM_PRETEND_VERSION := $(shell dpkg-parsechangelog -SVersion | sed -e 's/^[0-9]*://' -e 's/-[^-]*$$//')
export PYBUILD_DISABLE = test

%:
	dh $@ --with python3,umc,ucr --buildsystem=pybuild

override_dh_python3:
	dh_python3 --skip-private
