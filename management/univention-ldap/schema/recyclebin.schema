#
# Recycle Bin Policy Attributes
#
attributetype ( 1.3.6.1.4.1.10176.4221.1.1 NAME 'univentionRecycleBinPolicyEnabled'
	DESC 'Enable or disable Recycle Bin functionality'
	EQUALITY caseIgnoreMatch
	SUBSTR caseIgnoreSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
	SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.10176.4221.1.2 NAME 'univentionRecycleBinPolicyUDMModules'
	DESC 'List of UDM modules to recycle when deleted'
	EQUALITY caseIgnoreMatch
	SUBSTR caseIgnoreSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

attributetype ( 1.3.6.1.4.1.10176.4221.1.3 NAME 'univentionRecycleBinPolicyIgnoredObjectClasses'
	DESC 'List of object classes for which no Recycle Bin entry should be created'
	EQUALITY caseIgnoreIA5Match
	SUBSTR caseIgnoreIA5SubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

attributetype ( 1.3.6.1.4.1.10176.4221.1.4 NAME 'univentionRecycleBinPolicyRetentionDays'
	DESC 'Number of days to keep objects in Recycle Bin'
	EQUALITY integerMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
	SINGLE-VALUE )

#
# Deleted Object Attributes
#
attributetype ( 1.3.6.1.4.1.10176.4221.1.5 NAME 'univentionRecycleBinOriginalDN'
	DESC 'Original DN of the deleted object'
	EQUALITY distinguishedNameMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.12
	SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.10176.4221.1.6 NAME 'univentionRecycleBinDeletionDate'
	DESC 'Timestamp when the object was deleted'
	EQUALITY generalizedTimeMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.24
	SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.10176.4221.1.7 NAME 'univentionRecycleBinOriginalType'
	DESC 'UDM module type of the original object'
	EQUALITY caseIgnoreMatch
	SUBSTR caseIgnoreSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
	SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.10176.4221.1.8 NAME 'univentionRecycleBinOriginalObjectClass'
	DESC 'Original objectClass values of the deleted object'
	EQUALITY caseIgnoreMatch
	SUBSTR caseIgnoreSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

attributetype ( 1.3.6.1.4.1.10176.4221.1.9 NAME 'univentionRecycleBinOriginalEntryUUID'
	DESC 'Original entryUUID of the deleted object'
	EQUALITY octetStringMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.40
	SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.10176.4221.1.10 NAME 'univentionRecycleBinOriginalUniventionObjectIdentifier'
	DESC 'Original univentionObjectIdentifier of the deleted object'
	EQUALITY caseIgnoreMatch
	SUBSTR caseIgnoreSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
	SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.10176.4221.1.11 NAME 'univentionRecycleBinDeleteAt'
	DESC 'Timestamp when the object should be permanently deleted based on retention policy'
	EQUALITY generalizedTimeMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.24
	SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.10176.4221.1.12 NAME 'univentionRecycleBinReference'
	DESC 'Generic references for restoring relationships: format=source_attr:target_module:target_property:lookup_attribute:lookup_value'
	EQUALITY caseIgnoreMatch
	SUBSTR caseIgnoreSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

#
# Object Classes
#
objectclass ( 1.3.6.1.4.1.10176.4221.2.1 NAME 'univentionRecycleBinPolicy'
	DESC 'Policy for Recycle Bin configuration'
	SUP univentionPolicy STRUCTURAL
	MAY ( univentionRecycleBinPolicyEnabled $
	      univentionRecycleBinPolicyUDMModules $
	      univentionRecycleBinPolicyIgnoredObjectClasses $
	      univentionRecycleBinPolicyRetentionDays ) )

objectclass ( 1.3.6.1.4.1.10176.4221.2.2 NAME 'univentionRecycleBinObject'
	DESC 'Object stored in the Recycle Bin'
	SUP top STRUCTURAL
	MUST ( univentionRecycleBinOriginalDN $
	       univentionRecycleBinDeleteAt $
	       univentionRecycleBinOriginalUniventionObjectIdentifier $
	       univentionRecycleBinOriginalObjectClass $
	       univentionRecycleBinDeletionDate $
	       univentionRecycleBinOriginalEntryUUID $
	       univentionRecycleBinOriginalType )
	MAY ( univentionObjectIdentifier $ univentionObjectType $
	      univentionRecycleBinReference ) )
