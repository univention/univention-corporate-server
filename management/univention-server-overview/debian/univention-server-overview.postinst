#! /bin/sh
#
# Postinst script for the univention-server-overview debian package
#
# SPDX-FileCopyrightText: 2017-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

#DEBHELPER#

a2ensite univention-server-overview.conf

if [ "$1" = "configure" ]; then
	systemctl reload apache2
	systemctl try-restart univention-directory-listener
fi

exit 0
