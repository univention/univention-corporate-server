#!/usr/bin/python3
# SPDX-FileCopyrightText: 2025-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only
"""
Generate Cerbos policies for UDM authorization.

The script writes Cerbos policy files below /usr/share/univention-guardian-server/policies/udm/:

* resource_policies/**.yaml contain one resource policy per UDM module,
  with supported UDM object actions, a property wildcard and global deny rules.
* role_policies/**.yaml contain DSL-generated role policies and the domain
  administrator role policy.
* variables/**.yaml contain reusable positional context predicates.
"""

import argparse
import subprocess
import logging
import shutil
import tarfile
import xml.etree.ElementTree as ET  # noqa: S405
from pathlib import Path
from tempfile import TemporaryDirectory

import yaml

import univention.admin.modules
# import univention.admin.uldap
import univention.logging
from univention.admin.authorization.config import UDMAuthorizationConfig, ROLE_POLICY_PARENT
from univention.admin.authorization.utils import udm_object_action, udm_resource_kind, udm_property_action_wildcards
from univention.config_registry import ucr


log = logging.getLogger('ACL').getChild(__name__)

CERBOS_SCHEMA = '# yaml-language-server: $schema=https://api.cerbos.dev/latest/cerbos/policy/v1/Policy.schema.json\n\n'
POLICY_ROOT = Path('/usr/share/univention-guardian-server/policies/udm')
POLICY_TMP = Path('/var/lib/univention-directory-manager-modules/policies/')
TEST_ROOT = Path('/usr/share/univention-directory-manager-modules/cerbos-tests')
TEST_FIXTURE_BASE = 'dc=ucs,dc=test'
CERBOS_IMAGE = 'gitregistry.knut.univention.de/univention/dev/projects/authorization-engine/cerbos/cerbos:branch-fbotner-1-ldap-dn'
REPORT_MODULES = {'users/user', 'groups/group'}
DOMAIN_ADMIN_ROLE = 'udm:default-roles:domain-administrator'
# '*' would also allow the restricting none/writeonly/readonly permissions, which hide every property
DOMAIN_ADMIN_ACTIONS = (
    'udm:object:*',
    udm_property_action_wildcards('*', 'read'),
    udm_property_action_wildcards('*', 'search'),
    udm_property_action_wildcards('*', 'write'),
)


class _NoAliasDumper(yaml.SafeDumper):
    def ignore_aliases(self, data):
        return True


def sanitize_filename(name):
    return ''.join(ch if ch.isalnum() or ch in '._-' else '-' for ch in name.replace('/', '-')).strip('-') or 'policy'


class UniventionDirectoryManagerPolicies:
    """Generate the complete Cerbos policy tree for UDM atomically."""

    @classmethod
    def main(cls, args=None):
        univention.admin.modules.update()
        cls(args).execute()

    def __init__(self, args):
        self.args = self.parse_args(args)

    def execute(self):
        if self.args.action == 'test':
            return self.run_tests()

        output_dir = Path(self.args.output_dir)
        POLICY_TMP.mkdir(exist_ok=True)
        with TemporaryDirectory(
            dir=POLICY_TMP,  # output_dir.parent,
            prefix=f'.{output_dir.name}.tmp-',
        ) as tmp:
            self.output_root = Path(tmp)
            self.output_root.chmod(0o755)
            # TODO: copy a pre-defined structure to the temp directory so that customers could hook in directly
            self.args.func()

            log.info('Replace policy tree: %s -> %s', self.output_root, output_dir)
            if output_dir.exists():
                shutil.rmtree(output_dir)
            shutil.move(self.output_root, output_dir)
        if self.args.archive:
            archive = Path(self.args.archive)
            archive.parent.mkdir(parents=True, exist_ok=True)
            with tarfile.open(archive, mode='w:gz') as tar:
                for path in sorted(output_dir.rglob('*')):
                    tar.add(path, arcname=path.relative_to(output_dir), recursive=False)

    def parse_args(self, args=None):
        parser = argparse.ArgumentParser(description=__doc__)
        parser.add_argument('--binddn', help='unused with machine connections', default=ucr['ldap/hostdn'])
        parser.add_argument('--bindpwdfile', help='password file')
        parser.add_argument(
            '--ldap-connection',
            choices=('machine', 'admin'),
            default='machine',
            help='LDAP account used for module introspection (default: machine)',
        )

        parser.add_argument('--output-dir', default=str(POLICY_ROOT), help='Root directory for Cerbos UDM policies')
        subparsers = parser.add_subparsers(dest='action', title='actions', required=True)

        subparser = subparsers.add_parser('generate')
        subparser.set_defaults(func=self.generate_all)
        subparser.add_argument('-v', '--verbose', action='store_true', help='Log every generated policy file')
        subparser.add_argument('--config-dir', default='/usr/share/univention-directory-manager-modules/policies/')
        subparser.add_argument('--archive', help='Also write the generated policy tree as a gzip-compressed tar archive')
        subparser.add_argument('--strict', dest='strict', action='store_true', default=True)
        subparser.add_argument('--unstrict', dest='strict', action='store_false')
        subparser.add_argument('--exclude-tests', action='store_true', help='Do not include installed-policy test suites in the generated bundle')
        subparser.add_argument('--test-dir', type=Path, default=TEST_ROOT, help='Directory containing packaged Cerbos test suites')

        subparser = subparsers.add_parser('test', help='Generate temporary bundles and execute Cerbos policy tests')
        subparser.set_defaults(func=self.run_tests)
        subparser.add_argument('--config-dir', default='/usr/share/univention-directory-manager-modules/policies/')
        subparser.add_argument('--test-dir', type=Path, default=TEST_ROOT)
        subparser.add_argument('--strict', dest='strict', action='store_true', default=True)
        subparser.add_argument('--unstrict', dest='strict', action='store_false', help='Disable Cerbos strict evaluation and DSL strict checking')
        subparser.add_argument('--runner', choices=('docker', 'local'), default='docker', help='Run Cerbos via Docker (default) or a local binary')
        subparser.add_argument('--image', default=CERBOS_IMAGE, help='Docker image containing the Cerbos ldapDN extension')
        subparser.add_argument('--cerbos-binary', default='cerbos', help='Local Cerbos binary for --runner=local')
        subparser.add_argument('--test-filter', help='Forward a Cerbos test filter to cerbos compile')
        subparser.add_argument('--junit', metavar='FILE', help='Write the results of all runs to FILE in JUnit format')
        subparser.add_argument('-v', '--verbose', action='store_true', help='Log every generated policy file and the temporary test directories')

        subparser = subparsers.add_parser('prune')
        subparser.set_defaults(func=self.prune)
        subparser.add_argument('--resources', action='store_true')
        subparser.add_argument('--all', action='store_true')
        subparser.add_argument('--default-roles', action='store_true')
        subparser.add_argument('--name')

        return parser.parse_args(args)

    def prune(self):
        generated = self.output_root
        if self.args.resources:
            generated = generated / 'resources'
        elif self.args.name:
            generated = generated / self.args.name
        elif self.args.default_roles:
            generated = generated / 'udm-default-authorization-roles'
        elif not self.args.all:
            raise SystemExit('error: no option given')

        if not generated.exists():
            return
        for path in sorted(generated.rglob('*'), reverse=True):
            if path.is_file():
                path.unlink()
            elif path.is_dir():
                path.rmdir()

    def generate_all(self):
        self.generate_principal_schema()
        self.generate_resource_schemas()
        compiled = self.generate_roles_from_acl()
        self.generate_resource_policies(compiled)
        self.generate_domain_administrator_role_policy()
        if not getattr(self.args, 'exclude_tests', False) and self.args.action == 'generate':
            suites = self._discover_test_suites(self.args.test_dir)
            self._copy_test_suites([suite for suite in suites if not list(suite.glob('*.policy'))])

    @staticmethod
    def _discover_test_suites(test_dir):
        root = Path(test_dir)
        if not root.exists():
            log.info('No Cerbos test suites found under %s', root)
            return []
        return sorted(path for path in root.iterdir() if path.is_dir())

    def _copy_test_suites(self, suites):
        """Copy test fixtures, never test-specific DSL policies, into a bundle."""
        if not suites:
            return

        dest = self.output_root / '_tests'
        dest.mkdir(parents=True, exist_ok=True)
        ldap_base = ucr.get('ldap/base') or TEST_FIXTURE_BASE
        for suite in suites:
            target = dest / suite.name
            shutil.copytree(suite, target)
            for path in target.rglob('*.policy'):
                path.unlink()
            if ldap_base != TEST_FIXTURE_BASE:
                for path in target.rglob('*.yaml'):
                    content = path.read_text()
                    path.write_text(content.replace(TEST_FIXTURE_BASE, ldap_base))

    def _compile_tests(self, tree, run):
        """Compile a temporary tree, using the same Cerbos CLI as the old runner."""
        if self.args.runner == 'docker':
            command = [
                'docker', 'run', '--rm', '--volume', f'{tree}:/policies:ro',
                '--entrypoint', '/cerbos', self.args.image, 'compile',
            ]
            policy_dir = '/policies'
        else:
            command = [self.args.cerbos_binary, 'compile']
            policy_dir = str(tree)

        if self.args.strict:
            command.append('--strict-evaluation')

        if self.args.test_filter:
            command.extend(['--test-filter', self.args.test_filter])

        if self.args.junit:
            command.extend(['--test-output', 'junit'])

        command.append(policy_dir)
        if self.args.verbose:
            log.info('Running Cerbos tests: %s', tree)

        kwargs = {}
        if self.args.junit:
            kwargs.update(stdout=subprocess.PIPE, text=True)

        try:
            proc = subprocess.run(command, check=False, **kwargs)
        except FileNotFoundError as exc:
            raise SystemExit(f'error: executable not found: {exc.filename}') from exc

        if self.args.junit:
            self._collect_junit(run, proc.stdout)
        return proc.returncode

    def _collect_junit(self, run, output):
        """Add the test suites of one run to the combined JUnit report."""
        try:
            suites = ET.fromstring(output).findall('testsuite')  # noqa: S314
        except ET.ParseError:
            # cerbos compile failed before running any test, e.g. on an invalid policy
            suite = ET.Element('testsuite', name=run, tests='1', errors='1')
            case = ET.SubElement(suite, 'testcase', classname=run, name='cerbos compile')
            ET.SubElement(case, 'error', message='cerbos compile produced no test results').text = output
            suites = [suite]

        for suite in suites:
            print(f"{suite.get('name')}: {suite.get('tests')} tests, {suite.get('failures', '0')} failed, {suite.get('errors', '0')} errors", flush=True)
            self.junit.append(suite)

    def run_tests(self):
        """Test installed policies and each suite with its own DSL in isolation."""
        suites = self._discover_test_suites(self.args.test_dir)
        if not suites:
            raise SystemExit(f'error: no test suites found in {self.args.test_dir}')

        installed = []
        isolated = []
        for suite in suites:
            (isolated if list(suite.glob('*.policy')) else installed).append(suite)

        POLICY_TMP.mkdir(parents=True, exist_ok=True)
        result = 0
        self.junit = ET.Element('testsuites')
        with TemporaryDirectory(dir=POLICY_TMP, prefix='.udm-cerbos-tests-') as tmp:
            workdir = Path(tmp)
            runs = ([('installed', installed, Path(self.args.config_dir))] if installed else [])
            runs.extend((f'isolated-{suite.name}', [suite], suite) for suite in isolated)

            for name, selected, config_dir in runs:
                print(f'== Cerbos tests: {name}', flush=True)
                self.output_root = workdir / name
                self.output_root.mkdir()
                original_config_dir = self.args.config_dir

                try:
                    self.args.config_dir = str(config_dir)
                    self.generate_all()
                finally:
                    self.args.config_dir = original_config_dir

                self._copy_test_suites(selected)
                code = self._compile_tests(self.output_root, name)
                if code:
                    result = code

        if self.args.junit:
            ET.ElementTree(self.junit).write(self.args.junit, encoding='utf-8', xml_declaration=True)

        if result:
            raise SystemExit(result)

    def _log_written(self, kind, path):
        if self.args.verbose:
            log.info('Wrote Cerbos %s: %s', kind, path.relative_to(self.output_root))

    def generate_principal_schema(self):
        pass  # TODO: write to _schemas/principal.json

    def generate_resource_schemas(self):
        pass  # TODO: write to _schemas/resources/<resource>.json

    def generate_roles_from_acl(self):
        """Collect all DSL grants before writing one role policy per role."""
        compiled = {'imports': {}, 'resourceRules': {}, 'configs': []}
        derived_dir = self.output_root / 'derived_roles'
        derived_dir.mkdir(parents=True, exist_ok=True)
        (self.output_root / 'role_policies').mkdir(parents=True, exist_ok=True)
        (self.output_root / 'variables').mkdir(parents=True, exist_ok=True)

        role_rules = {}
        role_sources = {}
        variables = {}
        for config in sorted(Path(self.args.config_dir).glob('*.policy')):
            conf = UDMAuthorizationConfig(config, strict=self.args.strict)
            conf.parse()
            data = conf.to_policy_data(commented=False)  # TODO: enable comments again

            for name, expr in data['variables'].items():
                if name in variables and variables[name] != expr:
                    raise ValueError(f'Conflicting CEL variable {name!r} in {config}')
                variables[name] = expr

            for role, rules in data['roles'].items():
                if role == DOMAIN_ADMIN_ROLE:
                    # the domain administrator has its own unconditional policy.
                    # do not let DSL file order override the generated policy.
                    log.info('Skipping DSL rules for the domain administrator in %s', config)
                    continue
                role_rules.setdefault(role, []).extend(rules)
                role_sources.setdefault(role, []).append(str(config))

            if data['derivedRoles']:
                document = conf._derived_roles_document(data['derivedRoles'])
                path = derived_dir / f'{sanitize_filename(data["derivedRoleSet"])}.yaml'
                path.write_text(CERBOS_SCHEMA + yaml.dump(document, Dumper=_NoAliasDumper, sort_keys=False, allow_unicode=True))  # TODO: use upstream YAML writers with comments
                self._log_written('derived roles', path)

            for resource, rules in data['resources'].items():
                compiled['resourceRules'].setdefault(resource, []).extend(rules)
                if data['derivedRoles'] and any(rule.get('derivedRoles') for rule in rules):
                    compiled['imports'].setdefault(resource, set()).add(data['derivedRoleSet'])
            compiled['configs'].append(config.stem)

        # export all variables once; generating per file previously discarded
        # variables referenced by rules originating from earlier DSL files.
        self.generate_variables(variables)

        for role, rules in sorted(role_rules.items()):
            document = {
                'apiVersion': 'api.cerbos.dev/v1',
                'description': f'Automatically generated UDM role policy for {role}.',
                'disabled': False,
                'rolePolicy': {
                    'role': role,
                    'version': 'default',
                    'variables': {'import': ['udm_variables']},
                    'parentRoles': [ROLE_POLICY_PARENT],
                    'rules': self._merge_role_rules(rules),
                },
                'metadata': {
                    'sourceFile': ', '.join(dict.fromkeys(role_sources[role])),
                    'annotations': {},
                },
            }
            path = self.output_root / 'role_policies' / f'{sanitize_filename(role)}.yaml'
            path.write_text(CERBOS_SCHEMA + yaml.dump(document, Dumper=_NoAliasDumper, sort_keys=False, allow_unicode=True))
            self._log_written('role policy', path)

        return compiled

    @staticmethod
    def _merge_role_rules(rules):
        """
        Merge grants by (resource, action), ORing alternative conditions.

        Preserve AND clauses inside each original condition. A grant without
        a condition makes that action unconditional for its resource.
        """
        grants = {}
        for rule in rules:
            resource = rule['resource']
            match = rule.get('condition', {}).get('match')
            for action in rule['allowActions']:
                grants.setdefault((resource, action), []).append(match)

        # in the generated representation, actions sharing a condition can
        # occupy one resource block. Never combine different action conditions.
        grouped = {}
        for (resource, action), matches in grants.items():
            if any(match is None for match in matches):
                condition = None
            else:
                # flatten ORs produced by an individual DSL file and remove
                # duplicates across files, without modifying nested ANDs.
                alternatives = []
                for match in matches:
                    if set(match) == {'any'} and set(match['any']) == {'of'}:
                        candidates = match['any']['of']
                    else:
                        candidates = [match]
                    for candidate in candidates:
                        if candidate not in alternatives:
                            alternatives.append(candidate)
                condition = alternatives[0] if len(alternatives) == 1 else {'any': {'of': alternatives}}
            key = (resource, yaml.safe_dump(condition, sort_keys=True))
            grouped.setdefault(key, {'resource': resource, 'condition': condition, 'actions': set()})['actions'].add(action)

        merged = []
        for group in grouped.values():
            rule = {
                'resource': group['resource'],
                'allowActions': sorted(group['actions']),
            }
            if group['condition'] is not None:
                rule['condition'] = {'match': group['condition']}
            merged.append(rule)
        return merged

    def generate_domain_administrator_role_policy(self):
        """
        Allow all positive UDM actions for the domain administrator.

        Resource kinds are enumerated because resource policies are exact-kind
        policies. Avoid `*` as an action, as negative permission signals must
        never be allowed to the domain administrator.
        """
        # rules = [
        #     {
        #         'resource': udm_resource_kind(modname),
        #         'allowActions': list(DOMAIN_ADMIN_ACTIONS),
        #     }
        #     for modname in sorted(univention.admin.modules.modules)
        # ]
        rules = [
            {
                'resource': udm_resource_kind('*'),
                'allowActions': list(DOMAIN_ADMIN_ACTIONS),
            },
        ]
        document = {
            'apiVersion': 'api.cerbos.dev/v1',
            'description': 'Domain administrators may perform all positive UDM actions.',
            'rolePolicy': {
                'role': DOMAIN_ADMIN_ROLE,
                'version': 'default',
                'parentRoles': [ROLE_POLICY_PARENT],
                'rules': rules,
            },
        }
        path = self.output_root / 'role_policies' / f'{sanitize_filename(DOMAIN_ADMIN_ROLE)}.yaml'
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(yaml.dump(document, Dumper=_NoAliasDumper, sort_keys=False, allow_unicode=True))
        self._log_written('domain administrator role policy', path)
        return path

    def generate_variables(self, variable_definitions):
        variables = self._generate_position_variables(variable_definitions)
        with (self.output_root / 'variables' / 'udm_variables.yaml').open('w') as fd:
            yaml.safe_dump(variables, fd, sort_keys=False)

    def _generate_position_variables(self, variable_definitions):
        definitions = {
            'udm_assignments': ('has(P.attr.context_roles) ? P.attr.context_roles.filter(a, has(a.position)) : []'),
        }

        definitions.update(variable_definitions)

        return {
            'apiVersion': 'api.cerbos.dev/v1',
            # PlanResources resolves the role check and returns an OR of the matching contexts only
            # if role and resource are checked in one exists per role; udm_assignments must not use
            # R, or the plan contains the whole context_roles list with filter and lambda operators.
            'exportVariables': {
                'name': 'udm_variables',
                'definitions': definitions,
            },
        }

    def generate_resource_policies(self, compiled):
        # derived_roles/common_roles.yaml
        # derived_roles/common_vars.yaml
        # resource_policies/<domain>/<resource>.yaml
        # resource_policies/<domain>/<resource>_test.yaml
        # resource_policies/<domain>/testdata/principals.yaml
        # resource_policies/<domain>/testdata/resources.yaml
        # role_policies/<role>.yaml
        # role_policies/<tenant>/<role>.yaml
        resource_dir = self.output_root / 'resource_policies' / 'udm'
        (resource_dir / 'testdata').mkdir(parents=True, exist_ok=True)
        for dirname in ('derived_roles', 'role_policies', 'variables'):
            (self.output_root / dirname).mkdir(parents=True, exist_ok=True)

        # if self.args.ldap_connection == 'machine':
        #     lo, po = univention.admin.uldap.getMachineConnection(ldap_master=True)
        # else:
        #     password = None
        #     if self.args.bindpwdfile:
        #         password = Path(self.args.bindpwdfile).read_text().strip()
        #     lo = univention.admin.uldap.access(
        #         host=ucr['ldap/master'],
        #         port=int(ucr.get('ldap/master/port', '7389')),
        #         base=ucr['ldap/base'],
        #         binddn=self.args.binddn,
        #         bindpw=password,
        #     )
        #     po = univention.admin.uldap.position(lo.base)
        written = []
        for modname, module in sorted(univention.admin.modules.modules.items()):
            # univention.admin.modules.init(lo, po, module)
            resource = udm_resource_kind(modname)

            imported_derived_roles = sorted(compiled['imports'].get(resource, set()))
            resource_rules = compiled['resourceRules'].get(resource, [])
            policy = self._resource_policy(modname, module, imported_derived_roles, resource_rules, compiled['configs'])

            path = resource_dir / f'{sanitize_filename(modname)}.yaml'
            path.write_text(
                self._resource_policy_comments(modname, module) + yaml.dump(policy, Dumper=_NoAliasDumper, sort_keys=False, allow_unicode=True),
            )
            written.append(path)
            self._log_written('resource policy', path)
        return written

    def _resource_policy(self, modname, module, imported_derived_roles, resource_rules, configs):
        """
        Permit supported UDM operations and all UDM property permission signals.

        The role policies grant actual permissions. The resource policy also
        limits object actions to operations offered by the UDM module.
        Properties are deliberately not enumerated (extended attributes).
        """
        object_actions = self._object_actions(modname, module)
        rules = self._global_deny_rules(modname)
        rules.append(
            {
                # parent role of all generated role policies. Never assigned to a user;
                # the role policies narrow it down to what each role may do
                'name': f'allow-role-policy-actions-{modname.replace("/", "-")}',
                'actions': [*object_actions, 'udm:property:*:*'],
                'effect': 'EFFECT_ALLOW',
                'roles': [ROLE_POLICY_PARENT],
            },
        )
        return {
            'apiVersion': 'api.cerbos.dev/v1',
            'description': f'Defines the possible actions of the UDM module "{modname}" resource',
            'disabled': False,
            'resourcePolicy': {
                'resource': udm_resource_kind(modname),
                'version': 'default',
                # 'scope': '',
                # 'scopePermissions': '',
                'importDerivedRoles': imported_derived_roles,
                # 'constants':
                # 'variables':
                'rules': rules + resource_rules,
                # 'schemas': {
                #     'principalSchema': {'ref' 'cerbos:///principal.json'},
                #     'resourceSchema':: {'ref': 'cerbos:///album/object.json'},
                # }
            },
            'metadata': {
                'sourceFile': 'univention-configure-udm-authorization',
                'annotations': {
                    'configs': ', '.join(configs),
                },
            },
        }

    def _object_actions(self, modname, module):
        """Return the object actions actually supported by a UDM module."""
        mod = univention.admin.modules.get(modname)
        actions = []
        if univention.admin.modules.supports(modname, 'add') or modname == 'settings/license':
            actions.append(udm_object_action('create'))
        if univention.admin.modules.supports(modname, 'edit') or modname == 'settings/license':
            actions.append(udm_object_action('modify'))
            if all(prop.may_change for prop in mod.property_descriptions.values() if prop.identifies):
                actions.append(udm_object_action('rename'))
        if univention.admin.modules.supports(modname, 'remove'):
            actions.append(udm_object_action('remove'))
        if univention.admin.modules.supports(modname, 'move') or univention.admin.modules.supports(modname, 'subtree_move'):
            actions.append(udm_object_action('move'))
        if univention.admin.modules.supports(modname, 'search'):
            actions.extend([udm_object_action('search'), udm_object_action('read')])
        if univention.admin.modules.supports(modname, 'restore'):
            actions.append(udm_object_action('restore'))
        if modname in REPORT_MODULES:  # FIXME: detect dynamically if module supports it
            actions.append(udm_object_action('report-create'))
        return sorted(set(actions), key=self._action_sort_key)

    def _resource_policy_comments(self, modname, module):
        """Human-readable module capabilities; not policy conditions."""
        actions = set(self._object_actions(modname, module))
        description = str(getattr(module, 'short_description', '') or '').replace('\n', ' ')
        object_actions = []
        for action in ('create', 'search', 'read', 'modify', 'rename', 'move', 'remove', 'restore', 'report-create'):
            supported = 'yes' if udm_object_action(action) in actions else 'no'
            object_actions.append(f'#   {action:<13} {supported}')
        # property_actions = [udm_property_action_wildcards(propname, '*') for propname in module.property_descriptions]
        lines = [
            *CERBOS_SCHEMA.splitlines(),
            '# auto-generated UDM resource policy',
            '# this file will be overwritten via univention-configure-udm-authorization!',
            f'# Module: {modname} ({description})',
            '# Supported object actions:',
            *object_actions,
            f'# Properties: {len(getattr(module, "property_descriptions", {}))} UDM property definitions + extended attributes',
            # *[f'#  {prop}' for prop in property_actions],
            '',
        ]
        return '\n'.join(lines) + '\n'

    def _global_deny_rules(self, modname):
        global_rules = []
        if modname == 'users/user':
            global_rules.append(
                {
                    # nobody may manage a user with UID 0, neither the current nor the new state
                    'name': 'deny-uid-number-zero',
                    'actions': ['udm:*:*:*', 'udm:*:*', 'udm:*'],
                    'roles': ['*'],
                    'effect': 'EFFECT_DENY',
                    'condition': {
                        'match': {
                            'any': {
                                'of': [
                                    {'expr': 'has(R.attr.properties.uidNumber) && R.attr.properties.uidNumber == 0'},
                                    {'expr': 'has(R.attr.new) && has(R.attr.new.properties.uidNumber) && R.attr.new.properties.uidNumber == 0'},
                                ],
                            },
                        },
                    },
                },
            )
        return global_rules

    @staticmethod
    def _action_sort_key(action):
        order = {
            'create': 0,
            'search': 1,
            'read': 2,
            'modify': 3,
            'rename': 4,
            'move': 5,
            'remove': 6,
            'restore': 7,
            'report-create': 8,
        }
        if action.startswith('udm:object:'):
            return (0, order.get(action.rsplit(':', 1)[-1], 99), action)
        return (1, action)


if __name__ == '__main__':
    univention.logging.basicConfig(level=logging.INFO)
    UniventionDirectoryManagerPolicies.main()
