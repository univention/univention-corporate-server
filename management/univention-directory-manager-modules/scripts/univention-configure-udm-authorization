#!/usr/bin/python3
# SPDX-FileCopyrightText: 2025-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only
"""
Generate Cerbos policies for UDM authorization.

The script writes Cerbos policy files below /usr/share/univention-guardian-server/policies/udm/:

* resources/**.yaml are technical resource policies derived from UDM
  module introspection.
* roles/**.yaml are role policies compiled from the UDM authorization
  DSL by config.py.
"""

import argparse
import logging
from pathlib import Path

import yaml

import univention.admin.modules
import univention.admin.uldap
import univention.logging
from univention.admin.authorization.config import UDMAuthorizationConfig
from univention.admin.authorization.utils import (
    udm_object_action, udm_property_action, udm_property_action_wildcards, udm_resource_kind,
)
from univention.config_registry import ucr


log = logging.getLogger('ACL').getChild(__name__)

POLICY_ROOT = Path('/usr/share/univention-guardian-server/policies/udm')
# TODO: store in /var/lib/univention-directory-manager-modules/guardian and register from there
REPORT_MODULES = {'users/user', 'groups/group'}
PROPERTY_PERMISSIONS = ('read', 'search', 'write', 'readonly', 'writeonly', 'none')


class _NoAliasDumper(yaml.SafeDumper):
    def ignore_aliases(self, data):
        return True


def sanitize_filename(name):
    return ''.join(ch if ch.isalnum() or ch in '._-' else '-' for ch in name.replace('/', '-')).strip('-') or 'policy'


class UniventionDirectoryManagerPolicies:
    """Generate Cerbos resource and role policies for UDM."""

    @classmethod
    def main(cls, args=None):
        univention.admin.modules.update()
        cls(args).execute()

    def __init__(self, args):
        self.args = self.parse_args(args)

    def execute(self):
        self.args.func()

    def parse_args(self, args=None):
        parser = argparse.ArgumentParser(description=__doc__)
        parser.add_argument("--binddn", help="username", default=ucr['ldap/hostdn'])
        parser.add_argument("--bindpwdfile", help="password file")

        parser.add_argument('--output-dir', default=str(POLICY_ROOT), help='Root directory for Cerbos UDM policies')
        subparsers = parser.add_subparsers(dest='action', title='actions', required=True)

        subparser = subparsers.add_parser('generate-resources', aliases=['create-permissions'])
        subparser.set_defaults(func=self.generate_resource_policies)

        subparser = subparsers.add_parser('generate-roles', aliases=['create-roles'])
        subparser.set_defaults(func=self.generate_roles_from_acl)
        subparser.add_argument('--config-dir', required=True)
        subparser.add_argument('--strict', action='store_true')

        subparser = subparsers.add_parser('generate-default-roles', aliases=['create-default-roles'])
        subparser.set_defaults(func=self.generate_default_roles)
        subparser.add_argument('--config-dir', default='/usr/share/univention-directory-manager-modules/policies/')
        subparser.add_argument('--strict', action='store_true')

        subparser = subparsers.add_parser('prune')
        subparser.set_defaults(func=self.prune)
        subparser.add_argument('--resources', action='store_true')
        subparser.add_argument('--all', action='store_true')
        subparser.add_argument('--default-roles', action='store_true')
        subparser.add_argument('--name')

        return parser.parse_args(args)

    @property
    def output_root(self):
        return Path(self.args.output_dir)

    def prune(self):
        generated = self.output_root
        if self.args.resources:
            generated = generated / 'resources'
        elif self.args.name:
            generated = generated / self.args.name
        elif self.args.default_roles:
            generated = generated / 'udm-default-authorization-roles'
        elif not self.args.all:
            raise SystemExit('error: no option given')

        if not generated.exists():
            return
        for path in sorted(generated.rglob('*'), reverse=True):
            if path.is_file():
                path.unlink()
            elif path.is_dir():
                path.rmdir()

    def generate_resource_policies(self):
        resource_dir = self.output_root / 'resources'
        resource_dir.mkdir(parents=True, exist_ok=True)
        for dirname in ('tests', 'roles', 'derived_roles', 'variables', 'customer'):
            (self.output_root / dirname).mkdir(parents=True, exist_ok=True)

        lo, po = univention.admin.uldap.getAdminConnection()
        written = []
        for modname, module in sorted(univention.admin.modules.modules.items()):
            univention.admin.modules.init(lo, po, module)
            policy = self._resource_policy(modname, module)
            path = resource_dir / f'{sanitize_filename(modname)}.yaml'
            path.write_text(yaml.dump(policy, Dumper=_NoAliasDumper, sort_keys=False, allow_unicode=True))
            written.append(path)
            log.info('Wrote Cerbos resource policy %s', path)
        return written

    def generate_roles_from_acl(self):
        for config in Path(self.args.config_dir).glob('*.policy'):
            conf = UDMAuthorizationConfig(config, strict=self.args.strict)
            conf.parse()
            for path in conf.write_files(self.output_root):
                log.info('Wrote Cerbos role policy %s', path)

    def generate_default_roles(self):
        self.generate_roles_from_acl()

    def _resource_policy(self, modname, module):
        object_actions = self._object_actions(modname, module)
        property_actions = self._property_actions(modname, module)
        rules = []
        rules.extend(self._global_deny_rules(modname))
        rules.append({
            'name': 'allow-role-policy-actions',
            'actions': object_actions + property_actions,
            'effect': 'EFFECT_ALLOW',
            'roles': ['*'],
        })
        return {
            'apiVersion': 'api.cerbos.dev/v1',
            'resourcePolicy': {
                'version': 'default',
                'resource': udm_resource_kind(modname),
                'rules': rules,
            },
        }

    def _object_actions(self, modname, module):
        mod = univention.admin.modules.get(modname)
        actions = []
        if univention.admin.modules.supports(modname, 'add') or modname == 'settings/license':
            # f"Allow to create {module.short_description}"
            actions.append(udm_object_action('create'))
        if univention.admin.modules.supports(modname, 'edit'):
            # f"Allow to modify {module.short_description}"
            actions.append(udm_object_action('modify'))
            if all(prop.may_change for prop in mod.property_descriptions.values() if prop.identifies):
                # f"Allow to rename {module.short_description}"
                actions.append(udm_object_action('rename'))
        if univention.admin.modules.supports(modname, 'remove'):
            # f"Allow to remove {module.short_description}"
            actions.append(udm_object_action('remove'))
        if univention.admin.modules.supports(modname, 'move') or univention.admin.modules.supports(modname, 'subtree_move'):
            # f"Allow to move {module.short_description}"
            actions.append(udm_object_action('move'))
        if univention.admin.modules.supports(modname, 'search'):
            # f"Allow to search {module.short_description}"
            # f"Allow to read {module.short_description}"
            actions.extend([udm_object_action('search'), udm_object_action('read')])
        if univention.admin.modules.supports(modname, 'restore'):
            # f"Allow to restore {module.short_description}"
            actions.append(udm_object_action('restore'))
        if modname in REPORT_MODULES:  # FIXME: detect dynamically if module supports it
            # f"Allow to create report for {module.short_description}"
            actions.append(udm_object_action('report-create'))
        return sorted(set(actions), key=self._action_sort_key)

    def _property_actions(self, modname, module):
        permissions = [udm_property_action_wildcards('*', perm) for perm in PROPERTY_PERMISSIONS]
        for propname in module.property_descriptions:
            permissions.extend(udm_property_action(propname, perm) for perm in PROPERTY_PERMISSIONS)
            # TODO: check if the property support the permissions at all?
            # f'Allow to read {module.short_description}: {prop.short_description}'
            # f'Allow to search for {module.short_description}: {prop.short_description}'
            # f'Allow to write {module.short_description}: {prop.short_description}'
            # f'Prevent write permission on {module.short_description}: {prop.short_description}'
            # f'Allows write but prevents read permission on {module.short_description}: {prop.short_description}'
            # f'Prevent read and write permissions on {module.short_description}: {prop.short_description}'
        return permissions

    def _global_deny_rules(self, modname):
        if modname != 'users/user':
            return []
        return [{
            # 'name': 'deny-uid-number-zero',
            'actions': ['udm:*'],
            'roles': ['*'],
            'effect': 'EFFECT_DENY',
            'condition': {
                'match': {
                    'expr': 'request.resource.attr.properties.new.uidNumber == 0 || request.resource.attr.properties.uidNumber == 0',
                },
            },
        }]

    @staticmethod
    def _action_sort_key(action):
        order = {
            'create': 0,
            'search': 1,
            'read': 2,
            'modify': 3,
            'rename': 4,
            'move': 5,
            'remove': 6,
            'restore': 7,
            'report-create': 8,
        }
        if action.startswith('udm:object:'):
            return (0, order.get(action.rsplit(':', 1)[-1], 99), action)
        return (1, action)


if __name__ == '__main__':
    univention.logging.basicConfig(level=logging.INFO)
    UniventionDirectoryManagerPolicies.main()
