    def create_capability_mapping_for_module(self, name, module, role, display_name=None, conditions=None, allow_guardian_roles_write=False, allow_read=True, allow_write=True):
        MOD_NAMESPACE = self._sanitize_module_name(module)
        self.client.create_role_capability_mapping(
            f"{role}-capability-{MOD_NAMESPACE}-{name}",
            display_name,
            APP_NAME,
            MOD_NAMESPACE,
            expand_role(APP_NAME, DEFAULT_ROLES_NAMESPACE, role),
            self.get_module_permissions_allow_all(module, allow_guardian_roles_write=allow_guardian_roles_write, allow_read=allow_read, allow_write=allow_write),
            conditions=[
                expand_condition('udm:conditions:target_object_type_equals', [
                    {
                        "name": "objectType",
                        "value": module,
                    },
                ]),
                *(conditions or []),
            ],
        )

    def add_domain_users_role(self):
        role = 'domain-users'
        self.client.create_role(APP_NAME, DEFAULT_ROLES_NAMESPACE, role, 'Domain Users')
        # FIXME: remove a lot of them, can be done with priviledged connection
        for modname in ('container/cn', 'container/dc', 'settings/license', 'settings/lock', 'settings/prohibited_username', 'settings/usertemplate', 'settings/default', 'settings/directory', 'settings/extended_attribute', 'settings/extended_options', 'settings/cn', 'computers/computer', 'mail/domain', 'shares/share', 'groups/group', 'users/user'):
            self.create_capability_mapping_for_module('general', modname, role, allow_read=False, allow_write=False)
            # "Domain Users must be able to see certain objects in the domain to use UDM / UMC",

        self.create_capability_mapping_for_module(
            'global-cn-users', 'container/cn', role, allow_write=False,
            display_name=f"{role} can read global users container",
            conditions=[
                expand_condition('udm:conditions:target_position_in', [
                    {
                        "name": "position",
                        "value": 'cn=users',
                    },
                    {
                        "name": "scope",
                        "value": "base",
                    },
                ]),
            ],
        )

        self.create_capability_mapping_for_module(
            'global-cn-groups', 'container/cn', role, allow_write=False,
            display_name=f"{role} can read global groups container",
            conditions=[
                expand_condition('udm:conditions:target_position_in', [
                    {
                        "name": "position",
                        "value": 'cn=groups',
                    },
                    {
                        "name": "scope",
                        "value": "base",
                    },
                ]),
            ],
        )

    def add_global_admnistrator_role(self):
        role = 'domain-administrator'
        self.client.create_role(APP_NAME, DEFAULT_ROLES_NAMESPACE, role, 'Domain Adminstrator')
        for modname in univention.admin.modules.modules:
            self.create_capability_mapping_for_module(
                'domain-administration', modname, role, allow_guardian_roles_write=True,
                display_name=f"Administration of all {modname} objects in the whole domain",
            )

    def _role_dc_base_capability(self, role):
        self.create_capability_mapping_for_module(
            'dc-base-access-read', 'container/dc', role, display_name=f"{role} can read LDAP base", allow_write=False,
            conditions=[
                expand_condition('udm:conditions:target_position_in', [
                    {
                        "name": "position",
                        "value": '',  # LDAP base is automatically appended
                    },
                    {
                        "name": "scope",
                        "value": "base",
                    },
                ]),
            ],
        )

    def add_organizational_unit_administrator_role(self):
        # Role 1: OU Administrator on OU basis
        # udm:general:organizational-unit-admin&udm:general:ou=OU1
        role = 'organizational-unit-admin'
        self.client.create_role(APP_NAME, DEFAULT_ROLES_NAMESPACE, role, 'Organizational Unit Admin')
        self.client.create_context(APP_NAME, CONTEXTS_NAMESPACE_NAME, 'ou', 'Organizational Unit membership')

        self._role_dc_base_capability(role)

        for modname in ('users/user', 'groups/group', 'container/ou', 'container/cn'):
            self.create_capability_mapping_for_module(
                'ou-write', modname, role, allow_write=modname not in ('container/ou', 'container/cn'),
                display_name=f"Organizational Unit Admins can administrate all {modname} objects in their OU",
                conditions=[
                    expand_condition('udm:conditions:target_position_from_context', [
                        {
                            "name": "context",
                            "value": "udm:contexts:ou",
                        },
                        {
                            "name": "scope",
                            "value": "base" if modname == 'container/ou' else "subtree",
                        },
                    ]),
                ],
            )

        self.create_capability_mapping_for_module(
            'groups-read', 'groups/group', role, allow_write=False,
            conditions=[
                expand_condition('udm:conditions:target_position_in', [
                    {
                        "name": "position",
                        "value": "cn=groups",
                    },
                    {
                        "name": "scope",
                        "value": "one",
                    },
                ]),
            ],
        )

        self.create_capability_mapping_for_module(
            'mail-domains-read', 'mail/domain', role, allow_write=False,
            conditions=[
                expand_condition('udm:conditions:target_position_in', [
                    {
                        "name": "position",
                        "value": "cn=domain,cn=mail",
                    },
                    {
                        "name": "scope",
                        "value": "one",
                    },
                ]),
            ],
        )

        for modname in ('policies/desktop', 'policies/pwhistory', 'policies/umc', 'settings/cn', 'settings/directory', 'settings/default'):
            self.create_capability_mapping_for_module(
                'global-read', modname, role, allow_write=False,
                display_name=f"Organizational Unit Admins can administrate all {modname} objects in their OU",
                conditions=[
                    # expand_condition('udm:conditions:target_position_in', [
                    #     {
                    #         "name": "position",
                    #         "value": "*",
                    #     },
                    #     {
                    #         "name": "scope",
                    #         "value": "one",
                    #     },
                    # ]),
                ],
            )

    def add_computer_clients_in_ou_join_role(self):
        # Role 2: Join Role for computer client per OU
        pass

    def add_helpdesk_operator_role(self):
        # Role 3: Helpdesk Operator
        pass


if __name__ == "__main__":
    logging.basicConfig(stream=sys.stderr, level=logging.INFO)
    try:
        UniventionDirectoryManagerRoles.main()
    except requests.HTTPError as exc:
        log.exception('ERROR: %s', exc.response.json())
