"""Move legacy UDM superior values from LDAP secretary to LDAP manager."""

import argparse
import sys

import univention.admin.uldap
from univention.config_registry import ConfigRegistry


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        '--modify', action='store_true',
        help='apply the changes; without this option only a dry-run is performed',
    )
    args = parser.parse_args()

    ucr = ConfigRegistry()
    ucr.load()
    if ucr.get('server/role') not in ('domaincontroller_master', 'domaincontroller_backup'):
        print('This script can only be executed on a Primary Directory Node or Backup Directory Node.', file=sys.stderr)
        sys.exit(1)

    lo, _po = univention.admin.uldap.getAdminConnection()
    object_filter = '(|(univentionObjectType=users/user)(univentionObjectType=users/contact))'
    user_filter = '(&%s(secretary=*))' % object_filter
    for dn, attrs in lo.search(filter=user_filter, attr=['secretary', 'manager']):
        secretary = attrs.get('secretary', [])
        manager = attrs.get('manager', [])
        if manager and set(manager) != set(secretary):
            print('%s: skipped because manager already has different values' % dn)
            continue

        changes = [('manager', manager or None, secretary), ('secretary', secretary, None)]
        print('%s: secretary -> manager (%s)' % (dn, 'apply' if args.modify else 'dry-run'))
        if args.modify:
            lo.modify(dn, changes)


if __name__ == '__main__':
    main()
