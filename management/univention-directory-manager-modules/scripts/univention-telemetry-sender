#!/usr/bin/python3
#
# Univention Directory Manager
#  Send UCS telemetry to Univention
#
# SPDX-FileCopyrightText: 2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

"""
Send UCS telemetry to Univention.

Fetches metrics from the local UDM REST API /metrics endpoint, transforms
them to OTLP/JSON format, and POSTs to Univention's telemetry receiver.
Intended to run once daily on the Primary Directory Node via cron.

Credentials default to the machine account (ldap/hostdn + /etc/machine.secret).
Override with environment variables for testing:
  PASSWORD_FILE       path to file containing the password (default: /etc/machine.secret)
  BINDDN              LDAP bind DN (overrides ldap/hostdn UCR variable)
  USERNAME            alias for BINDDN
  TELEMETRY_ENDPOINT  override the telemetry receiver URL (default: Univention production endpoint)
"""

import json
import os
import random
import sys
import time
from argparse import ArgumentParser
from datetime import UTC, datetime

import requests
from prometheus_client.parser import text_string_to_metric_families

import univention.logging
from univention.admin.log import log
from univention.config_registry import ucr


TELEMETRY_ENDPOINT = "https://telemetry.univention.de/v1/metrics"
UCS_CA = "/etc/univention/ssl/ucsCA/CAcert.pem"
SERVICE_NAME = "univention-telemetry-sender"
SERVICE_VERSION = "1.0.0"
SCOPE_NAME = "nubus.platform"
RETRY_COUNT = 3
RETRY_DELAY = 10
JITTER_MAX = 60


def fetch_metrics(session, username, password):
    url = f'https://{ucr["ldap/master"]}/univention/udm/-/metrics'
    verify = UCS_CA if os.path.exists(UCS_CA) else True
    resp = session.get(url, auth=(username, password), verify=verify, timeout=30)
    resp.raise_for_status()
    return resp.text


def parse_prometheus_text(text):
    wanted = {'version_ucs_info', 'version_n4k_info', 'users_user_total'}
    result = {name: [] for name in wanted}
    for family in text_string_to_metric_families(text):
        if family.name not in wanted:
            continue
        for sample in family.samples:
            result[family.name].append({'labels': dict(sample.labels), 'value': sample.value})
    return result


def _str_attr(key, value):
    return {"key": key, "value": {"stringValue": value}}


def _int_attr(key, value):
    return {"key": key, "value": {"intValue": str(value)}}


def _gauge(name, description, dp):
    return {"name": name, "description": description, "unit": "1", "gauge": {"dataPoints": [dp]}}


def _ucs_metrics(samples, ts):
    for sample in samples:
        labels = sample['labels']
        if 'license_uuid' not in labels:
            continue
        yield _gauge(
            "nubus.installation.ucs",
            "UCS version info per installation (value is always 1)",
            {
                "timeUnixNano": ts, "asInt": "1",
                "attributes": [
                    _str_attr("license_uuid", labels["license_uuid"]),
                    _str_attr("ucs", labels.get("ucs", "")),
                    _int_attr("patch", int(labels.get("patch", "0"))),
                    _int_attr("errata", int(labels.get("errata", "0"))),
                ],
            },
        )


def _n4k_metrics(samples, ts):
    for sample in samples:
        labels = sample['labels']
        if 'license_uuid' not in labels:
            continue
        yield _gauge(
            "nubus.installation.n4k",
            "N4K version info per installation (value is always 1)",
            {
                "timeUnixNano": ts, "asInt": "1",
                "attributes": [
                    _str_attr("license_uuid", labels["license_uuid"]),
                    _int_attr("major", int(labels.get("major", "0"))),
                    _int_attr("minor", int(labels.get("minor", "0"))),
                    _int_attr("patch", int(labels.get("patch", "0"))),
                ],
            },
        )


def _user_metrics(samples, ts):
    for sample in samples:
        labels = sample['labels']
        if 'license_uuid' not in labels:
            continue
        count = int(sample['value'])
        if count < 0:
            continue
        yield _gauge(
            "nubus.identities.active",
            "Count of non-deactivated users/user LDAP objects",
            {
                "timeUnixNano": ts, "asInt": str(count),
                "attributes": [
                    _str_attr("license_uuid", labels["license_uuid"]),
                    _str_attr("platform", labels.get("platform", "ucs")),
                ],
            },
        )


def build_otlp(samples, ts):
    metrics = [
        *_ucs_metrics(samples.get('version_ucs_info', []), ts),
        *_n4k_metrics(samples.get('version_n4k_info', []), ts),
        *_user_metrics(samples.get('users_user_total', []), ts),
    ]
    return {
        "resourceMetrics": [{
            "resource": {"attributes": [
                _str_attr("service.name", SERVICE_NAME),
                _str_attr("service.version", SERVICE_VERSION),
            ]},
            "scopeMetrics": [{"scope": {"name": SCOPE_NAME}, "metrics": metrics}],
        }],
    }


def send_with_retry(session, payload):
    endpoint = os.environ.get('TELEMETRY_ENDPOINT', TELEMETRY_ENDPOINT)
    body = json.dumps(payload).encode()
    last_exc = None
    for attempt in range(1, RETRY_COUNT + 1):
        try:
            resp = session.post(
                endpoint,
                data=body,
                headers={"Content-Type": "application/json"},
                timeout=30,
            )
            resp.raise_for_status()
            return
        except requests.RequestException as exc:
            last_exc = exc
            log.warning('Send attempt %d/%d to %s failed: %s', attempt, RETRY_COUNT, endpoint, exc)
            if attempt < RETRY_COUNT:
                time.sleep(RETRY_DELAY)
    raise RuntimeError(f"All {RETRY_COUNT} send attempts failed: {last_exc}")


def main() -> int:
    parser = ArgumentParser(description=__doc__)
    parser.parse_args()

    univention.logging.basicConfig(
        filename='stdout',
        univention_debug_level=ucr.get_int('directory/manager/cmd/debug/level', 2),
        use_structured_logging=ucr.is_true('directory/manager/cmd/debug/structured-logging', True),
    )

    if ucr['server/role'] != 'domaincontroller_master':
        log.info('Not running on Primary Directory Node, skipping')
        return 0

    log.info('Starting telemetry sender')

    jitter = random.uniform(0, JITTER_MAX)
    log.info('Sleeping %.1fs before sending', jitter)
    time.sleep(jitter)

    password_file = os.environ.get('PASSWORD_FILE', '/etc/machine.secret')
    username = os.environ.get('BINDDN') or os.environ.get('USERNAME') or ucr['ldap/hostdn']
    try:
        with open(password_file) as f:
            password = f.read().strip()
    except OSError as exc:
        log.error('Failed to read credentials: %s', exc)
        return 1

    session = requests.Session()

    try:
        raw = fetch_metrics(session, username, password)
    except requests.RequestException as exc:
        log.error('Failed to fetch metrics from UDM REST API: %s', exc)
        return 1

    samples = parse_prometheus_text(raw)
    ts = str(int(datetime.now(tz=UTC).timestamp() * 1e9))
    payload = build_otlp(samples, ts)

    try:
        send_with_retry(session, payload)
    except RuntimeError as exc:
        log.error('%s', exc)
        return 1

    log.info('Telemetry sent successfully')
    return 0


if __name__ == '__main__':
    sys.exit(main())
