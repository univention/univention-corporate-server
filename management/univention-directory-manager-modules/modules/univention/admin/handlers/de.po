msgid "Change Sequence Number (CSN)"
msgstr "Änderungssequenznummer (CSN)"

msgid "Created"
msgstr "Erstellt"

msgid "Created By"
msgstr "Erstellt von"

msgid "Distinguished Name (DN) of the user or system that created this entry."
msgstr "Distinguished Name (DN) des Benutzers oder Systems, der bzw. das diesen Eintrag erstellt hat."

msgid "Distinguished Name (DN) of the user or system that last modified this entry."
msgstr "Distinguished Name (DN) des Benutzers oder Systems, der bzw. das diesen Eintrag zuletzt geändert hat."

msgid "Entry UUID"
msgstr "Eintrags-UUID"

msgid "Globally unique identifier (entryUUID) for this LDAP object. Assigned by the directory server and does not change."
msgstr "Global eindeutiger Bezeichner (entryUUID) für dieses LDAP-Objekt. Wird vom Verzeichnisdienst vergeben und ändert sich nicht."

msgid "Immutable attribute univentionObjectIdentifier to track the identity of an object in UDM"
msgstr "Unveränderliches Attribut univentionObjectIdentifier zur Nachverfolgung der Identität eines Objekts in UDM"

msgid "Internal change identifier used for replication. Increases with each modification and helps synchronize directory servers."
msgstr "Interner Änderungsbezeichner für die Replikation. Erhöht sich bei jeder Änderung und hilft, Verzeichnisserver zu synchronisieren."

msgid "Last Modified"
msgstr "Zuletzt geändert"

msgid "Last Modified By"
msgstr "Zuletzt geändert von"

msgid "Timestamp in UTC of the most recent change to this entry, maintained automatically by the directory server."
msgstr "Zeitstempel (UTC) der letzten Änderung dieses Eintrags, wird automatisch vom Verzeichnisdienst gepflegt."

msgid "Timestamp in UTC when this entry was originally created, set automatically by the directory server."
msgstr "Zeitstempel (UTC) der ursprünglichen Erstellung dieses Eintrags, wird automatisch vom Verzeichnisdienst gesetzt."

msgid "Univention Object Identifier"
msgstr "Univention Objekt-Identifikator"

#: modules/univention/admin/handlers/__init__.py:999
#, python-format
msgid "Cannot restore object to %s: Parent container %s does not exist."
msgstr ""
"Konnte Objekt nicht nach %s wiederherstellen: Eltern-Container %s existiert "
"nicht."

#: modules/univention/admin/handlers/__init__.py:3049
msgid "DNS alias is already in use."
msgstr "DNS-Alias ist bereits verwendet."

#: modules/univention/admin/handlers/__init__.py:812
msgid "Destination object can't have sub objects."
msgstr "Zielobjekt kann keine Unterobjekte haben."

#: modules/univention/admin/handlers/__init__.py:825
msgid "Moving into one's own sub container not allowed."
msgstr ""
"Verschieben in einen Container innerhalb des zu verschiebenden Objektes "
"nicht erlaubt."

#: modules/univention/admin/handlers/__init__.py:816
msgid "Moving not possible: old and new DN are identical."
msgstr "Verschieben ist nicht möglich: Alter und neuer DN sind identisch."

#: modules/univention/admin/handlers/__init__.py:1232
msgid "Neither DN nor position given."
msgstr "Weder ein DN noch eine Position wurde angegeben."

#: modules/univention/admin/handlers/__init__.py:1243
msgid "No superordinate object given"
msgstr "Kein übergeordnetes Objekt angegeben."

#: modules/univention/admin/handlers/__init__.py:798
msgid "Objects from Active Directory can not be moved."
msgstr "Objekte aus Active-Directory-Domänen können nicht verschoben werden."

#: modules/univention/admin/handlers/__init__.py:1775
msgid "Objects from Active Directory can not be removed."
msgstr "Objekte aus Active-Directory-Domänen können nicht gelöscht werden."

#: modules/univention/admin/handlers/__init__.py:611
#, python-format
msgid "Objects of the \"%s\" object type can not be created."
msgstr "Objekte des Objekttyps \"%s\" können nicht erstellt werden."

#: modules/univention/admin/handlers/__init__.py:705
#, python-format
msgid "Objects of the \"%s\" object type can not be modified."
msgstr "Objekte des Objekttyps \"%s\" können nicht bearbeitet werden."

#: modules/univention/admin/handlers/__init__.py:782
#, python-format
msgid "Objects of the \"%s\" object type can not be moved."
msgstr "Objekte des Objekttyps \"%s\" können nicht verschoben werden."

#: modules/univention/admin/handlers/__init__.py:1074
#, python-format
msgid "Objects of the \"%s\" object type can not be removed."
msgstr "Objekte des Objekttyps \"%s\" können nicht gelöscht werden."

#: modules/univention/admin/handlers/__init__.py:965
#, python-format
msgid "Objects of the \"%s\" object type can not be restored."
msgstr "Objekte des Objekttyps \"%s\" können nicht wiederhergestellt werden."

#: modules/univention/admin/handlers/__init__.py:1015
msgid "Restore not allowed on this machine."
msgstr "Wiederherstellung auf diesem System nicht erlaubt."

#: modules/univention/admin/handlers/__init__.py:2767
msgid "Reverse zone and IP address are incompatible."
msgstr "Reverse Zone und IP-Adresse sind inkompatibel."

#: modules/univention/admin/handlers/__init__.py:281
msgid "Technical information"
msgstr "Technische Informationen"

#: modules/univention/admin/handlers/__init__.py:3365
msgid ""
"The DHCP entry for this host should contain the zone LDAP-DN, the IP address"
" and the MAC address."
msgstr ""
"Der DHCP-Eintrag für diesen Rechner sollte die Zonen LDAP-DN, die IP- und "
"MAC-Adresse enthalten."

#: modules/univention/admin/handlers/__init__.py:1252
msgid "The DN must be underneath of the superordinate."
msgstr ""

#: modules/univention/admin/handlers/__init__.py:3399
msgid ""
"The DNS alias entry for this host should contain the zone name, the alias "
"zone container LDAP-DN and the alias."
msgstr ""
"Der DNS-Alias Eintrag für diesen Rechner sollte den Zonennamen, die LDAP-DN "
"des Alias-Zonencontainers und den Alias-Namen enthalten."

#: modules/univention/admin/handlers/__init__.py:406
#, python-format
msgid ""
"The following properties are missing:\n"
"%s"
msgstr ""
"Die folgenden Eigenschaften fehlen:\n"
"%s"

#: modules/univention/admin/handlers/__init__.py:1248
#, python-format
msgid "The given %r superordinate is expected to be of type %s."
msgstr "Das angegebene %r übergeordnete Objekt ist muss vom Typ %s sein."

#: modules/univention/admin/handlers/__init__.py:789
#: modules/univention/admin/handlers/__init__.py:792
msgid "The own object cannot be moved."
msgstr "Das eigene Objekt kann nicht verschoben werden."

#: modules/univention/admin/handlers/__init__.py:1083
#: modules/univention/admin/handlers/__init__.py:1086
msgid "The own object cannot be removed."
msgstr "Das eigene Objekt kann nicht gelöscht werden."

#: modules/univention/admin/handlers/__init__.py:410
msgid "The position must be in the subtree of the superordinate."
msgstr ""

#: modules/univention/admin/handlers/__init__.py:465
#, python-format
msgid "The property %s is required"
msgstr "Die Eigenschaft %s wird benötigt."

#: modules/univention/admin/handlers/__init__.py:479
#, python-format
msgid "The property %s must be a list"
msgstr "Die Eigenschaft %s wird benötigt."

#: modules/univention/admin/handlers/__init__.py:868
#: modules/univention/admin/handlers/__init__.py:935
#, python-format
msgid ""
"Unable to move object %(name)s (%(type)s) in subtree, trying to revert "
"changes."
msgstr ""
"Das Objekt %(name)s (%(type)s) im Teilbaum kann nicht verschoben werden, "
"versuche den Ausgangzustand wiederherzustellen."

#: modules/univention/admin/handlers/__init__.py:462
#: modules/univention/admin/handlers/__init__.py:1998
#, python-format
msgid "key=%(key)s old=%(old)s new=%(new)s"
msgstr "Attribut=%(key)s alter Wert=%(old)s neuer Wert=%(new)s"

#, python-format
#~ msgid "Parent DN %s does not exist."
#~ msgstr "Übergeordneter DN %s existiert nicht."
