msgid "The email address of the person responsible for this zone."
msgstr "Die E-Mail-Adresse der Person, die für diese Zone verantwortlich ist."

#: modules/univention/admin/handlers/dns/ptr_record.py:42
msgid ""
"The host part of the IP address in reverse notation (e.g. \"172.16.1.2/16\" "
"-> \"2.1\" or \"2001:0db8:0100::0007:0008/96\" -> \"8.0.0.0.7.0.0.0\")."
msgstr ""
"Der Host-Anteil der IP-Adresse in umgekehrter Notation (z.B. "
"\"172.16.1.2/16\" -> \"2.1\" or \"2001:0db8:0100::0007:0008/96\" -> "
"\"8.0.0.0.7.0.0.0\")."

