#: modules/univention/admin/handlers/dns/txt_record.py:40
#: modules/univention/admin/handlers/dns/host_record.py:41
msgid "The name of the host relative to the domain."
msgstr "Der Name des Rechners relativ zur Domäne."

#: modules/univention/admin/handlers/dns/ns_record.py:38
msgid "The name of the subzone relative to the parent."
msgstr "Der Name der Subzone relativ zur Übergeordneten."

#: modules/univention/admin/handlers/dns/alias.py:58
msgid "The name this alias points to. A FQDN must end with a dot."
msgstr ""
"Der Name, auf den dieser Alias verweist. Der FQDN muss mit einem Punkt "
"enden."

#: modules/univention/admin/handlers/dns/reverse_zone.py:45
msgid "The networks address in forward notation."
msgstr "Die Netzwerkadresse in Vorwärtsnotation."

#: modules/univention/admin/handlers/dns/reverse_zone.py:69
#: modules/univention/admin/handlers/dns/forward_zone.py:68
msgid "The sequence number for this zone. Updates automatically."
msgstr "Die Sequenznummer dieser Zone. Wird automatisch aktualisiert."

#: modules/univention/admin/handlers/dns/reverse_zone.py:97
#: modules/univention/admin/handlers/dns/forward_zone.py:96
