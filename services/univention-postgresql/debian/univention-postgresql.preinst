if [ "$1" = install ] && [ -z "$2" ] && [ -e /etc/univention/templates/removed/univention-postgresql.info ]
then
	rm -f /etc/univention/templates/removed/univention-postgresql.info
fi

#DEBHELPER#

exit 0
