#!/bin/sh
#
# Univention Management Console Module Admin Diary
#  join script
#
# SPDX-FileCopyrightText: 2019-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

## joinscript api: bindpwdfile

VERSION=1

. /usr/share/univention-join/joinscripthelper.lib
. /usr/share/univention-lib/umc.sh

joinscript_init

umc_init
umc_operation_create "admindiary-all" "Admin Diary" "" "admindiary/*"
umc_policy_append "default-umc-all" "admindiary-all"

joinscript_save_current_version

exit 0
