#!/usr/bin/make -f
#
# Univention Common Python and Shell Library
#  rules file for the debian package
#
# SPDX-FileCopyrightText: 2002-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

export PYBUILD_SYSTEM=pyproject
export SETUPTOOLS_SCM_PRETEND_VERSION := $(shell dpkg-parsechangelog -SVersion | sed -e 's/^[0-9]*://' -e 's/-[^-]*$$//')
export PYBUILD_DISABLE = test

override_dh_auto_build:
	$(MAKE) build
	dh_auto_build

override_dh_auto_clean:
	$(MAKE) clean
	dh_auto_clean

%:
	dh $@ --with python3,umc,ucr,univention-join --buildsystem=pybuild
