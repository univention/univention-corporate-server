#! /bin/sh
# Univention Sasl
#  postinst script
#
# SPDX-FileCopyrightText: 2011-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

#DEBHELPER#

eval "$(ucr shell)"

# saslauthd/autostart enables the service
univention-config-registry set \
	mail/saslauthd/cache/timeout?1800 \
	mail/saslauthd/threads?5 \
	saslauthd/autostart?yes

if [ "$1" = "configure" ]; then
	deb-systemd-invoke restart saslauthd.service
fi

exit 0
